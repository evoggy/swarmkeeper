import { Button, Palette, ScrollView, VerticalBox, HorizontalBox, LineEdit, CheckBox, ComboBox } from "std-widgets.slint";
import { UnitData, UnitState, JournalEntryData, ConsoleLineData } from "unit-card.slint";
import { PlotPanel, PlotBridge } from "plot.slint";
import { ViewSettings } from "view-settings.slint";
import { Theme, Icons, Icon, Card, Dot, IconButton, Segmented, KButton, ButtonKind, Pill, Meter, LinkBars, MenuRow, TextField, LabeledField, Check } from "kit.slint";
import { Features } from "features.slint";
import { UnitsTiles, UnitsToolbar, UnitsTable, UnitRow, SwarmSummary, FilterCounts, Health, HealthColors } from "units-table.slint";

component StickIndicator inherits VerticalLayout {
    in property <string> label-x;
    in property <string> label-y;
    in property <float> value-x;  // -1 to 1
    in property <float> value-y;  // -1 to 1

    spacing: 2px;
    alignment: center;

    Rectangle {
        width: 100px;
        height: 100px;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 4px;
        background: Palette.background.darker(0.03);

        // Horizontal crosshair
        Rectangle {
            x: 0px;
            y: (parent.height - 1px) / 2;
            width: parent.width;
            height: 1px;
            background: Palette.border.transparentize(0.3);
        }

        // Vertical crosshair
        Rectangle {
            x: (parent.width - 1px) / 2;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Palette.border.transparentize(0.3);
        }

        // Dot indicator
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: dodgerblue;
            x: (parent.width - self.width) / 2 + value-x * (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - value-y * (parent.height - self.height) / 2;
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        Text {
            text: "← " + label-x + " →";
            font-size: 9px;
            color: Palette.foreground.transparentize(0.4);
            horizontal-alignment: center;
        }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            text: "↕ " + label-y;
            font-size: 9px;
            color: Palette.foreground.transparentize(0.4);
            horizontal-alignment: center;
        }
    }
}

// A group in the unit panel: a small title over its rows.
component PanelGroup inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    Text {
        text: root.title;
        font-size: Theme.font-tiny;
        font-weight: 600;
        color: Theme.text3;
    }
    @children
}

// A name and its value on one line.
component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono;
    spacing: 12px;
    min-height: 20px;
    Text {
        text: root.label;
        width: 96px;
        font-size: 12.5px;
        color: Theme.text2;
        vertical-alignment: center;
    }
    Text {
        horizontal-stretch: 1;
        text: root.value == "" ? "–" : root.value;
        font-size: 12.5px;
        font-family: root.mono ? Theme.font-mono : "";
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A light box in the unit panel, with an optional title.
component PanelCard inherits Rectangle {
    in property <string> title;
    in property <string> note;
    height: card-layout.preferred-height;
    border-radius: 10px;
    background: Theme.surface2;
    border-width: 1px;
    border-color: Theme.border;
    card-layout := VerticalLayout {
        padding: 12px;
        spacing: 10px;
        if root.title != "": VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
            }
            if root.note != "": Text {
                text: root.note;
                font-size: Theme.font-small;
                color: Theme.text3;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// A live number in a box: battery, link.
component StatBox inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    height: stat-layout.preferred-height;
    border-radius: 10px;
    background: Theme.surface2;
    border-width: 1px;
    border-color: Theme.border;
    stat-layout := VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 5px;
        Text {
            text: root.label;
            font-size: Theme.font-small;
            color: Theme.text3;
        }
        Text {
            text: root.value == "" ? "–" : root.value;
            font-family: Theme.font-mono;
            font-size: 16px;
            font-weight: 600;
            color: Theme.text;
        }
        @children
        Text {
            text: root.sub;
            font-size: Theme.font-small;
            color: Theme.text2;
            overflow: elide;
        }
    }
}

// A deck on the unit.
component Tag inherits Rectangle {
    in property <string> text;
    height: 22px;
    width: tag-text.preferred-width + 16px;
    border-radius: 11px;
    background: Theme.surface2;
    border-width: 1px;
    border-color: Theme.border;
    tag-text := Text {
        text: root.text;
        font-size: Theme.font-small;
        color: Theme.text2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component UnitSidebar inherits Rectangle {
    in property <UnitData> unit;
    in property <bool> has-selection;
    // Status and address from the unit table (units.rs).
    in property <UnitRow> info;
    // In the 3D view the panel can go back to a floating card.
    in property <bool> can-undock;
    callback undock-clicked();
    in property <[JournalEntryData]> journal-entries;
    callback close-clicked();
    callback journal-clicked();
    callback add-journal-entry(string);
    callback console-clicked();
    callback clear-console-clicked();
    callback read-assert-clicked();
    callback upload-trajectory-clicked();
    callback download-trajectory-clicked();
    callback fly-trajectory-clicked();
    callback clear-trajectory-clicked();
    callback generate-primitive-clicked(/* shape */ string, /* size m */ string, /* size y m */ string, /* z offset m */ string, /* z iterations */ string);
    callback generate-wave-clicked(/* x step m */ string, /* y amp m */ string, /* reps */ string, /* simultaneous */ bool, /* speed m/s */ string, /* z offset m */ string, /* z iterations */ string);
    callback takeoff-clicked(/* height */ string, /* yaw */ string, /* time */ string, /* relative */ bool);
    callback goto-clicked(/* x */ string, /* y */ string, /* z */ string, /* yaw */ string, /* relative */ bool, /* speed m/s */ string);
    callback random-goto-clicked();
    callback go-home-clicked();
    callback land-clicked();
    callback arm-clicked(/* arm */ bool);
    callback identify-clicked();
    callback manual-control-clicked();
    callback recover-clicked();
    callback reboot-clicked();
    callback power-off-clicked();
    callback sysoff-clicked();
    callback syson-clicked();
    callback clear-tlv-clicked();

    // The tab shown: Overview, Flight, Trajectory or Tools. Kept across units
    // and shared with the 3D view.
    property <int> tab <=> ViewSettings.unit-tab;
    // Connected, with live numbers
    property <bool> live: root.info.battery != "";
    property <Health> health: root.info.health;
    // Recover helps a unit the supervisor has locked (units.rs: classify)
    property <bool> recoverable: root.unit.state == UnitState.crashed || root.info.status == "Tumbled" || root.info.status == "Locked";
    // The shape the Trajectory tab generates: circle, square, cube, rectangle
    property <int> shape: 0;
    property <[string]> shape-names: ["circle", "square", "cube", "rectangle"];

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        // Header: name, status, radio and address; undock and close
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            padding-top: 14px;
            padding-bottom: 12px;
            spacing: 4px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: root.has-selection ? root.unit.name : "No selection";
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if root.has-selection: Pill {
                        height: 24px;
                        has-dot: true;
                        dot: HealthColors.dot(root.health);
                        hollow: root.health == Health.off;
                        fg: HealthColors.label(root.health);
                        text: root.info.status;
                    }
                }
                if root.has-selection: Text {
                    text: (root.info.radio == "" ? "" : root.info.radio + "  ·  ") + root.info.address;
                    font-size: Theme.font-small;
                    color: Theme.text2;
                    overflow: elide;
                }
            }

            if root.can-undock: IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.undock;
                clicked => { root.undock-clicked(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.close;
                clicked => { root.close-clicked(); }
            }
        }

        // What is done most to one unit
        if root.has-selection: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            spacing: 6px;
            alignment: start;
            KButton {
                small: true;
                icon: Icons.identify;
                text: root.unit.identifying ? "Stop identifying" : "Identify";
                clicked => { root.identify-clicked(); }
            }
            KButton {
                small: true;
                icon: Icons.console;
                text: root.unit.console-line-count > 0 ? "Console  \{root.unit.console-line-count}" : "Console";
                clicked => { root.console-clicked(); }
            }
            if Features.journal: KButton {
                small: true;
                icon: Icons.journal;
                text: root.unit.journal-entry-count > 0 ? "Journal  \{root.unit.journal-entry-count}" : "Journal";
                clicked => { root.journal-clicked(); }
            }
        }

        // Why it needs a look
        if root.has-selection && root.info.detail != "": HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            Rectangle {
                height: alert-layout.preferred-height;
                border-radius: 9px;
                background: root.health == Health.fault ? Theme.crit-tint : Theme.warn-tint;
                alert-layout := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 9px;
                    padding-bottom: 9px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.warning;
                        width: 16px;
                        height: 16px;
                        color: root.health == Health.fault ? Theme.crit-text : Theme.warn-text;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.info.detail;
                        font-size: 12.5px;
                        color: root.health == Health.fault ? Theme.crit-text : Theme.warn-text;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.recoverable: KButton {
                        y: (parent.height - self.height) / 2;
                        small: true;
                        text: "Recover";
                        clicked => { root.recover-clicked(); }
                    }
                }
            }
        }

        // Tabs
        if root.has-selection: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            Segmented {
                fill: true;
                items: [{ label: "Overview" }, { label: "Flight" }, { label: "Trajectory" }, { label: "Tools" }];
                current <=> root.tab;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.has-selection: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;
                alignment: start;

                // Overview
                if root.tab == 0: HorizontalLayout {
                    spacing: 8px;
                    StatBox {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 50px;
                        label: "Battery";
                        value: root.info.battery;
                        sub: root.unit.pm-state == "Battery" ? "On battery" : root.unit.pm-state != "" ? root.unit.pm-state : "–";
                        Meter {
                            value: root.live ? root.info.battery-level : 0;
                            tint: HealthColors.battery(root.info.battery-level);
                        }
                    }
                    StatBox {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 50px;
                        label: "Link quality";
                        value: root.info.link;
                        sub: !root.live ? "–" : root.unit.has-rssi ? "\{round(root.unit.rssi)} dBm" : "Retries \{round(root.unit.avg-retries * 10) / 10}";
                        LinkBars {
                            quality: root.unit.link-quality;
                            connected: root.live;
                        }
                    }
                }
                if root.tab == 0: PanelGroup {
                    title: "POSITION (M)";
                    HorizontalLayout {
                        spacing: 8px;
                        for axis in [{ k: "X", v: root.unit.pos-x }, { k: "Y", v: root.unit.pos-y }, { k: "Z", v: root.unit.pos-z }]: Rectangle {
                            horizontal-stretch: 1;
                            height: 34px;
                            border-radius: 8px;
                            background: Theme.surface2;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text {
                                    text: axis.k;
                                    font-size: Theme.font-small;
                                    color: Theme.text3;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.live ? axis.v.to-fixed(2) : "–";
                                    font-family: Theme.font-mono;
                                    font-size: 13px;
                                    color: Theme.text;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                if root.tab == 0: PanelGroup {
                    title: "STATE";
                    InfoRow { label: "Power"; value: root.unit.pm-state; }
                    InfoRow { label: "Supervisor"; value: root.unit.supervisor-state; }
                    InfoRow { label: "Armed"; value: !root.live ? "" : root.unit.armed ? "Yes" : "No"; }
                }
                if root.tab == 0: PanelGroup {
                    title: "LINK";
                    InfoRow { label: "Uplink"; value: !root.live ? "" : "\{round(root.unit.uplink-rate * 30 / 100) / 10} kB/s · \{round(root.unit.uplink-rate)} pkt/s"; }
                    InfoRow { label: "Downlink"; value: !root.live ? "" : "\{round(root.unit.downlink-rate * 30 / 100) / 10} kB/s · \{round(root.unit.downlink-rate)} pkt/s"; }
                    InfoRow { label: "Radio TX"; value: !root.live ? "" : "\{round(root.unit.radio-send-rate)} pkt/s"; }
                    InfoRow { label: "Retries"; value: !root.live ? "" : "\{round(root.unit.avg-retries * 10) / 10} on average"; }
                    if root.unit.has-rssi: InfoRow { label: "RSSI"; value: "\{round(root.unit.rssi)} dBm"; }
                }
                if root.tab == 0: PanelGroup {
                    title: "CRAZYFLIE";
                    TextField {
                        text: root.unit.uri;
                        read-only: true;
                        mono: true;
                    }
                    InfoRow { label: "Serial"; value: root.unit.serial; mono: true; }
                    InfoRow { label: "Platform"; value: root.unit.platform-type; }
                    InfoRow { label: "Firmware"; value: root.unit.firmware-version; }
                    InfoRow { label: "Description"; value: root.unit.description; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Decks";
                            width: 96px;
                            font-size: 12.5px;
                            color: Theme.text2;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: start;
                            if !root.live || !(root.unit.deck-lighthouse || root.unit.deck-loco || root.unit.deck-led-top || root.unit.deck-led-bottom): Text {
                                text: root.live ? "None" : "–";
                                font-size: 12.5px;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            if root.live && root.unit.deck-lighthouse: Tag { text: "Lighthouse"; }
                            if root.live && root.unit.deck-loco: Tag { text: "Loco"; }
                            if root.live && root.unit.deck-led-top: Tag { text: "LED top"; }
                            if root.live && root.unit.deck-led-bottom: Tag { text: "LED bottom"; }
                        }
                    }
                }

                // Flight
                if root.tab == 1: PanelCard {
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: root.unit.armed ? "Armed" : "Disarmed";
                                font-size: 13px;
                                font-weight: 600;
                                color: root.unit.armed ? Theme.accent-text : Theme.text;
                            }
                            Text {
                                text: "This unit only. Swarm actions arm all.";
                                font-size: Theme.font-small;
                                color: Theme.text3;
                                wrap: word-wrap;
                            }
                        }
                        KButton {
                            y: (parent.height - self.height) / 2;
                            small: true;
                            text: root.unit.armed ? "Disarm" : "Arm";
                            icon: Icons.arm;
                            kind: root.unit.armed ? ButtonKind.normal : ButtonKind.primary;
                            enabled: root.live;
                            clicked => { root.arm-clicked(!root.unit.armed); }
                        }
                    }
                }
                if root.tab == 1: PanelCard {
                    title: "Take off";
                    HorizontalLayout {
                        spacing: 8px;
                        LabeledField { horizontal-stretch: 1; label: "Height (m)"; text <=> ViewSettings.takeoff-height; }
                        LabeledField { horizontal-stretch: 1; label: "Yaw (°)"; text <=> ViewSettings.takeoff-yaw; }
                        LabeledField { horizontal-stretch: 1; label: "Time (s)"; text <=> ViewSettings.takeoff-time; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Check {
                            horizontal-stretch: 1;
                            y: (parent.height - self.height) / 2;
                            text: "Relative to the current position";
                            checked <=> ViewSettings.takeoff-relative;
                        }
                        KButton {
                            small: true;
                            text: "Take off";
                            icon: Icons.takeoff;
                            kind: ButtonKind.primary;
                            enabled: root.live;
                            clicked => {
                                root.takeoff-clicked(ViewSettings.takeoff-height, ViewSettings.takeoff-yaw, ViewSettings.takeoff-time,
                                    ViewSettings.takeoff-relative);
                            }
                        }
                    }
                }
                if root.tab == 1: PanelCard {
                    title: "Go to";
                    HorizontalLayout {
                        spacing: 8px;
                        LabeledField { horizontal-stretch: 1; label: "X (m)"; text <=> ViewSettings.goto-x; }
                        LabeledField { horizontal-stretch: 1; label: "Y (m)"; text <=> ViewSettings.goto-y; }
                        LabeledField { horizontal-stretch: 1; label: "Z (m)"; text <=> ViewSettings.goto-z; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LabeledField { horizontal-stretch: 1; label: "Yaw (°)"; text <=> ViewSettings.goto-yaw; }
                        LabeledField { horizontal-stretch: 1; label: "Speed (m/s)"; text <=> ViewSettings.goto-speed; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Check {
                            horizontal-stretch: 1;
                            y: (parent.height - self.height) / 2;
                            text: "Relative";
                            checked <=> ViewSettings.goto-relative;
                        }
                        KButton {
                            small: true;
                            text: "Random in area";
                            enabled: root.live;
                            clicked => { root.random-goto-clicked(); }
                        }
                        KButton {
                            small: true;
                            text: "Go to";
                            kind: ButtonKind.primary;
                            enabled: root.live;
                            clicked => {
                                root.goto-clicked(ViewSettings.goto-x, ViewSettings.goto-y, ViewSettings.goto-z, ViewSettings.goto-yaw,
                                    ViewSettings.goto-relative, ViewSettings.goto-speed);
                            }
                        }
                    }
                }
                if root.tab == 1: HorizontalLayout {
                    spacing: 8px;
                    KButton {
                        horizontal-stretch: 1;
                        preferred-width: 100px;
                        text: "Go home";
                        icon: Icons.home;
                        enabled: root.live;
                        clicked => { root.go-home-clicked(); }
                    }
                    KButton {
                        horizontal-stretch: 1;
                        preferred-width: 100px;
                        text: "Land";
                        icon: Icons.land;
                        enabled: root.live;
                        clicked => { root.land-clicked(); }
                    }
                }
                if root.tab == 1 && Features.manual-control: KButton {
                    text: "Manual control…";
                    icon: Icons.gamepad;
                    clicked => { root.manual-control-clicked(); }
                }

                // Trajectory
                if root.tab == 2: PanelCard {
                    title: "On the unit";
                    note: "Upload a trajectory file, or generate one below, then fly it.";
                    HorizontalLayout {
                        spacing: 8px;
                        KButton { horizontal-stretch: 1; preferred-width: 100px; small: true; text: "Upload…"; icon: Icons.upload; clicked => { root.upload-trajectory-clicked(); } }
                        // Writes what is loaded for this unit, a generated one too, to a trajectory file
                        KButton { horizontal-stretch: 1; preferred-width: 100px; small: true; text: "Download"; icon: Icons.download; clicked => { root.download-trajectory-clicked(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        KButton { horizontal-stretch: 1; preferred-width: 100px; small: true; text: "Fly"; icon: Icons.play; kind: ButtonKind.primary; clicked => { root.fly-trajectory-clicked(); } }
                        KButton { horizontal-stretch: 1; preferred-width: 100px; small: true; text: "Clear"; icon: Icons.trash; clicked => { root.clear-trajectory-clicked(); } }
                    }
                }
                // Repeat the generated path at several heights. Every layer after
                // the first is flown backwards, so it starts right above where the
                // one before ended and the unit only climbs straight up in between.
                if root.tab == 2: PanelCard {
                    title: "Repeat in height";
                    note: "Flies the shape or wave again at more heights. 1 iteration keeps it flat.";
                    HorizontalLayout {
                        spacing: 8px;
                        LabeledField { horizontal-stretch: 1; label: "Z offset (m)"; text <=> ViewSettings.z-offset; }
                        LabeledField { horizontal-stretch: 1; label: "Z iterations"; text <=> ViewSettings.z-iterations; }
                    }
                }
                // A negative side mirrors the shape, for a unit at the far end of
                // the flight space: built back towards the middle, not into the wall.
                if root.tab == 2: PanelCard {
                    title: "Shape";
                    note: "Sides may be negative: mirrored into −X or −Y.";
                    Segmented {
                        fill: true;
                        items: [{ label: "Circle" }, { label: "Square" }, { label: "Cube" }, { label: "Rectangle" }];
                        current <=> root.shape;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LabeledField {
                            horizontal-stretch: 1;
                            label: root.shape == 0 ? "Radius (m)" : root.shape == 3 ? "X side (m)" : "Side (m)";
                            text <=> ViewSettings.primitive-size;
                        }
                        if root.shape == 3: LabeledField {
                            horizontal-stretch: 1;
                            label: "Y side (m)";
                            text <=> ViewSettings.primitive-size-y;
                        }
                    }
                    KButton {
                        small: true;
                        text: "Generate and upload";
                        kind: ButtonKind.primary;
                        clicked => {
                            root.generate-primitive-clicked(root.shape-names[root.shape], ViewSettings.primitive-size, ViewSettings.primitive-size-y,
                                ViewSettings.z-offset, ViewSettings.z-iterations);
                        }
                    }
                }
                // Back and forth at a constant height: y swings between ± the
                // amplitude while x walks along. A square wave moves x and y one
                // at a time; a zig-zag moves them together.
                if root.tab == 2: PanelCard {
                    title: "Wave";
                    note: "Back and forth along X.";
                    HorizontalLayout {
                        spacing: 8px;
                        LabeledField { horizontal-stretch: 1; label: "X step (m)"; text <=> ViewSettings.wave-x; }
                        LabeledField { horizontal-stretch: 1; label: "Y amplitude (± m)"; text <=> ViewSettings.wave-y; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LabeledField { horizontal-stretch: 1; label: "Repetitions"; text <=> ViewSettings.wave-reps; }
                        LabeledField { horizontal-stretch: 1; label: "Speed (m/s)"; text <=> ViewSettings.wave-speed; }
                    }
                    Check {
                        text: "Move X and Y together (zig-zag)";
                        checked <=> ViewSettings.wave-simultaneous;
                    }
                    KButton {
                        small: true;
                        text: ViewSettings.wave-simultaneous ? "Generate zig-zag and upload" : "Generate square wave and upload";
                        kind: ButtonKind.primary;
                        clicked => {
                            root.generate-wave-clicked(ViewSettings.wave-x, ViewSettings.wave-y, ViewSettings.wave-reps, ViewSettings.wave-simultaneous,
                                ViewSettings.wave-speed, ViewSettings.z-offset, ViewSettings.z-iterations);
                        }
                    }
                }

                // Tools
                if root.tab == 3: PanelCard {
                    title: "Debugging";
                    VerticalLayout {
                        MenuRow {
                            text: PlotBridge.dock-visible ? "Hide plot and logging" : "Plot and logging";
                            icon: Icons.columns;
                            checked: PlotBridge.dock-visible;
                            clicked => { PlotBridge.dock-visible = !PlotBridge.dock-visible; }
                        }
                        MenuRow {
                            text: "Read assert";
                            icon: Icons.warning;
                            clicked => { root.read-assert-clicked(); }
                        }
                        MenuRow {
                            text: "Clear console";
                            icon: Icons.console;
                            hint: root.unit.console-line-count > 0 ? "\{root.unit.console-line-count} lines" : "";
                            enabled: root.unit.console-line-count > 0;
                            clicked => { root.clear-console-clicked(); }
                        }
                    }
                }
                if root.tab == 3: PanelCard {
                    title: "Power and system";
                    VerticalLayout {
                        MenuRow { text: "Reboot"; icon: Icons.reconnect; clicked => { root.reboot-clicked(); } }
                        MenuRow { text: "Sleep"; icon: Icons.sleep; clicked => { root.sysoff-clicked(); } }
                        MenuRow { text: "Wake up"; icon: Icons.sun; clicked => { root.syson-clicked(); } }
                        MenuRow { text: "Power off…"; icon: Icons.power; danger: true; clicked => { root.power-off-clicked(); } }
                        if Features.developer: MenuRow { text: "Clear TLV storage…"; icon: Icons.trash; danger: true; clicked => { root.clear-tlv-clicked(); } }
                    }
                }
            }
        }
    }
}

// Shared overlay popups triggered by the unit sidebar actions (journal,
// manual control, power-off confirm). Fills its parent and floats on top.
export component UnitActionPopups inherits Rectangle {
    in property <int> selected-row: -1;
    in property <[UnitData]> sorted-units;
    in property <[JournalEntryData]> journal-entries;
    in property <[ConsoleLineData]> console-lines;
    in property <string> assert-text;
    in property <bool> assert-busy;
    in property <[string]> joystick-names;
    in property <float> stick-lx;
    in property <float> stick-ly;
    in property <float> stick-rx;
    in property <float> stick-ry;
    in property <bool> manual-control-armed;

    in-out property <bool> manual-control-open: false;
    in-out property <bool> confirm-power-off-open: false;
    in-out property <bool> confirm-clear-tlv-open: false;
    in-out property <bool> journal-open: false;
    in-out property <bool> console-open: false;
    in-out property <bool> assert-open: false;

    callback manual-control-stopped(/* row index */ int);
    callback joystick-selected(/* row index */ int, /* joystick index */ int);
    callback arm-requested(/* row index */ int, /* arm */ bool);
    callback power-off-requested(/* row index */ int);
    callback clear-tlv-requested(/* row index */ int);
    callback add-journal-entry-requested(/* row index */ int, /* text */ string);
    callback delete-journal-entry-requested(/* row index */ int, /* entry index */ int);
    callback clear-console-requested(/* row index */ int);
    // Drop the saved console history of every unit in the swarm, not just the
    // selected one.
    callback clear-all-console-requested();
    callback read-assert-requested(/* row index */ int);

    // Manual control popup overlay
    if manual-control-open: Rectangle {
        background: #00000080;

        TouchArea {
            clicked => {
                manual-control-stopped(selected-row);
                manual-control-open = false;
            }
        }

        Rectangle {
            width: min(400px, root.width - 40px);
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the popup
            }

            VerticalLayout {
                spacing: 0px;

                // Header
                Rectangle {
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;

                        Text {
                            text: selected-row >= 0 && selected-row < sorted-units.length
                                ? "Manual Control — " + sorted-units[selected-row].name
                                : "Manual Control";
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "✕";
                            height: 28px;
                            width: 28px;
                            clicked => {
                                manual-control-stopped(selected-row);
                                manual-control-open = false;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "Joystick:";
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            horizontal-stretch: 1;
                            model: root.joystick-names;
                            selected(value) => {
                                joystick-selected(selected-row, self.current-index);
                            }
                        }
                    }

                    if joystick-names.length == 0: Text {
                        text: "No joysticks detected.";
                        font-size: 12px;
                        color: Palette.foreground.transparentize(0.5);
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Button {
                            text: root.manual-control-armed ? "Disarm" : "Arm";
                            clicked => {
                                arm-requested(selected-row, !root.manual-control-armed);
                            }
                        }

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.manual-control-armed ? limegreen : red;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.manual-control-armed ? "Armed" : "Disarmed";
                            font-size: 12px;
                            color: root.manual-control-armed ? limegreen : Palette.foreground.transparentize(0.4);
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 24px;

                        StickIndicator {
                            label-x: "Yaw";
                            label-y: "Thrust";
                            value-x: root.stick-lx;
                            value-y: root.stick-ly;
                        }

                        StickIndicator {
                            label-x: "Roll";
                            label-y: "Pitch";
                            value-x: root.stick-rx;
                            value-y: root.stick-ry;
                        }
                    }
                }
            }
        }
    }

    // Power off confirmation dialog
    if confirm-power-off-open: Rectangle {
        background: #00000080;

        TouchArea {
            clicked => { confirm-power-off-open = false; }
        }

        Rectangle {
            width: 340px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the dialog
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: selected-row >= 0 && selected-row < sorted-units.length
                        ? "Power off " + sorted-units[selected-row].name + "?"
                        : "Power off this unit?";
                    font-size: 15px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { confirm-power-off-open = false; }
                    }

                    Button {
                        text: "Power Off";
                        clicked => {
                            power-off-requested(selected-row);
                            confirm-power-off-open = false;
                        }
                    }
                }
            }
        }
    }

    // Clear TLV confirm overlay
    if confirm-clear-tlv-open: Rectangle {
        background: #00000080;

        TouchArea {
            clicked => { confirm-clear-tlv-open = false; }
        }

        Rectangle {
            width: 360px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the dialog
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: selected-row >= 0 && selected-row < sorted-units.length
                        ? "Clear persistent TLV storage on " + sorted-units[selected-row].name + "?"
                        : "Clear persistent TLV storage on this unit?";
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: "Wipes persistent params and Lighthouse geometry/calibration. Radio config is preserved. Power-cycle afterward.";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { confirm-clear-tlv-open = false; }
                    }

                    Button {
                        text: "Clear TLV";
                        clicked => {
                            clear-tlv-requested(selected-row);
                            confirm-clear-tlv-open = false;
                        }
                    }
                }
            }
        }
    }

    // Journal popup overlay
    if journal-open: Rectangle {
        background: #00000080;

        TouchArea {
            clicked => { journal-open = false; }
        }

        Rectangle {
            width: min(500px, root.width - 40px);
            max-height: root.height - 40px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the popup
            }

            VerticalLayout {
                spacing: 0px;

                // Header
                Rectangle {
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;

                        Text {
                            text: selected-row >= 0 && selected-row < sorted-units.length
                                ? "Journal — " + sorted-units[selected-row].name
                                : "Journal";
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "✕";
                            height: 28px;
                            width: 28px;
                            clicked => { journal-open = false; }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                // Entries list
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 12px;
                        spacing: 8px;

                        if journal-entries.length == 0: Text {
                            text: "No journal entries yet.";
                            font-size: 12px;
                            color: Palette.foreground.transparentize(0.5);
                            horizontal-alignment: center;
                        }

                        for entry[idx] in journal-entries: Rectangle {
                            border-width: 1px;
                            border-color: Palette.border.transparentize(0.5);
                            border-radius: 4px;

                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;

                                    Text {
                                        text: entry.timestamp;
                                        font-size: 10px;
                                        color: Palette.foreground.transparentize(0.4);
                                    }

                                    Text {
                                        text: entry.text;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }

                                Button {
                                    text: "✕";
                                    width: 24px;
                                    height: 24px;
                                    clicked => { delete-journal-entry-requested(selected-row, idx); }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                // Add entry
                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;

                    journal-input := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Add a note...";
                        accepted => {
                            if (self.text != "") {
                                add-journal-entry-requested(selected-row, self.text);
                                self.text = "";
                            }
                        }
                    }

                    Button {
                        text: "Add";
                        clicked => {
                            if (journal-input.text != "") {
                                add-journal-entry-requested(selected-row, journal-input.text);
                                journal-input.text = "";
                            }
                        }
                    }
                }
            }
        }
    }

    // Console popup overlay (read-only captured console output)
    if console-open: Rectangle {
        TouchArea {
            // Dim background; click outside closes
            clicked => { console-open = false; }
        }

        Rectangle {
            width: min(800px, root.width - 40px);
            max-height: root.height - 40px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the popup
            }

            VerticalLayout {
                spacing: 0px;

                // Header
                Rectangle {
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;

                        Text {
                            text: selected-row >= 0 && selected-row < sorted-units.length
                                ? "Console — " + sorted-units[selected-row].name
                                : "Console";
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        CheckBox {
                            text: "Timestamps";
                            height: 28px;
                            checked <=> ViewSettings.console-show-timestamps;
                        }

                        Button {
                            text: "Clear";
                            height: 28px;
                            enabled: console-lines.length > 0;
                            clicked => { clear-console-requested(selected-row); }
                        }

                        Button {
                            // Wipes the saved console history of the whole
                            // swarm, not just the unit shown here.
                            text: "Clear All Units";
                            height: 28px;
                            clicked => { clear-all-console-requested(); }
                        }

                        Button {
                            text: "✕";
                            height: 28px;
                            width: 28px;
                            clicked => { console-open = false; }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                // Console lines
                ScrollView {
                    min-height: 200px;
                    VerticalLayout {
                        alignment: start;
                        padding: 12px;
                        spacing: 0px;

                        if console-lines.length == 0: Text {
                            text: "No console output captured yet.";
                            font-size: 12px;
                            color: Palette.foreground.transparentize(0.5);
                            horizontal-alignment: center;
                        }

                        for line in console-lines: HorizontalLayout {
                            alignment: start;
                            spacing: 8px;

                            if ViewSettings.console-show-timestamps: Text {
                                text: line.time != "" ? line.time : "--:--:--.---";
                                font-size: 12px;
                                font-family: "monospace";
                                color: Palette.foreground.transparentize(0.5);
                                wrap: no-wrap;
                            }

                            Text {
                                text: line.text;
                                font-size: 12px;
                                font-family: "monospace";
                                wrap: no-wrap;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                // Footer
                Rectangle {
                    height: 28px;
                    Text {
                        text: "Showing up to 5000 most recent lines · captured continuously";
                        font-size: 10px;
                        color: Palette.foreground.transparentize(0.5);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Assert info popup overlay (result of a firmware assert-snapshot dump)
    if assert-open: Rectangle {
        TouchArea {
            // Dim background; click outside closes
            clicked => { assert-open = false; }
        }

        Rectangle {
            width: min(560px, root.width - 40px);
            max-height: root.height - 40px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the popup
            }

            VerticalLayout {
                spacing: 0px;

                // Header
                Rectangle {
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;

                        Text {
                            text: selected-row >= 0 && selected-row < sorted-units.length
                                ? "Assert Info — " + sorted-units[selected-row].name
                                : "Assert Info";
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Read Again";
                            height: 28px;
                            enabled: !assert-busy;
                            clicked => { read-assert-requested(selected-row); }
                        }

                        Button {
                            text: "✕";
                            height: 28px;
                            width: 28px;
                            clicked => { assert-open = false; }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                // Assert snapshot text
                ScrollView {
                    min-height: 120px;
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 0px;

                        Text {
                            text: assert-busy ? "Reading assert info…" : assert-text;
                            font-size: 12px;
                            font-family: "monospace";
                            color: assert-busy ? Palette.foreground.transparentize(0.5) : Palette.foreground;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                // Footer
                Rectangle {
                    height: 28px;
                    Text {
                        text: "Triggers system.assertInfo and reads the console snapshot line";
                        font-size: 10px;
                        color: Palette.foreground.transparentize(0.5);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component UnitsContent inherits Rectangle {
    in property <[UnitData]> units;
    in property <[UnitData]> sorted-units;
    in property <[UnitRow]> unit-rows;
    in property <int> visible-count;
    // This screen is shown: the plot dock measures itself only then
    in property <bool> plot-shown: true;
    in property <SwarmSummary> summary;
    in property <FilterCounts> counts;
    in-out property <int> filter;
    in-out property <string> search;
    callback filter-changed();
    in property <int> sort-column: -1;
    in property <bool> sort-ascending: true;
    in property <[JournalEntryData]> journal-entries;
    in property <[ConsoleLineData]> console-lines;
    in property <string> assert-text;
    in property <bool> assert-busy;

    callback sort-requested(/* column */ int, /* ascending */ bool);
    callback open-journal-requested(/* row index */ int);
    callback add-journal-entry-requested(/* row index */ int, /* text */ string);
    callback open-console-requested(/* row index */ int);
    callback clear-console-requested(/* row index */ int);
    // Drop the saved console history of every unit in the swarm, not just the
    // selected one.
    callback clear-all-console-requested();
    callback read-assert-requested(/* row index */ int);
    callback upload-trajectory-requested(/* row index */ int);
    callback download-trajectory-requested(/* row index */ int);
    callback fly-trajectory-requested(/* row index */ int);
    callback clear-trajectory-requested(/* row index */ int);
    callback generate-primitive-requested(/* row index */ int, /* shape */ string, /* size m */ string, /* size y m */ string, /* z offset m */ string, /* z iterations */ string);
    callback generate-wave-requested(/* row index */ int, /* x step m */ string, /* y amp m */ string, /* reps */ string, /* simultaneous */ bool, /* speed m/s */ string, /* z offset m */ string, /* z iterations */ string);
    callback takeoff-requested(/* row index */ int, /* height */ string, /* yaw */ string, /* time */ string, /* relative */ bool);
    callback goto-requested(/* row index */ int, /* x */ string, /* y */ string, /* z */ string, /* yaw */ string, /* relative */ bool, /* speed m/s */ string);
    callback random-goto-requested(/* row index */ int);
    callback go-home-requested(/* row index */ int);
    callback land-requested(/* row index */ int);
    callback identify-requested(/* row index */ int);
    callback delete-journal-entry-requested(/* row index */ int, /* entry index */ int);
    callback row-selected(/* row index */ int);
    callback open-manual-control-requested(/* row index */ int);
    callback joystick-selected(/* row index */ int, /* joystick index */ int);
    callback manual-control-stopped(/* row index */ int);
    callback arm-requested(/* row index */ int, /* arm */ bool);
    callback recover-requested(/* row index */ int);
    callback reboot-requested(/* row index */ int);
    callback power-off-requested(/* row index */ int);
    callback sysoff-requested(/* row index */ int);
    callback syson-requested(/* row index */ int);
    callback clear-tlv-requested(/* row index */ int);

    in property <[string]> joystick-names;
    in property <float> stick-lx;
    in property <float> stick-ly;
    in property <float> stick-rx;
    in property <float> stick-ry;
    in property <bool> manual-control-armed;

    // Selection lives in the ViewSettings global so the Visualization tab shows
    // the same unit; the sidebar is open exactly when something is selected.
    property <int> selected-row <=> ViewSettings.selected-unit;
    private property <bool> sidebar-open: selected-row >= 0 && selected-row < sorted-units.length;
    private property <bool> journal-open: false;
    private property <bool> console-open: false;
    private property <bool> assert-open: false;
    private property <bool> manual-control-open: false;
    private property <bool> confirm-power-off-open: false;
    private property <bool> confirm-clear-tlv-open: false;
    property <length> sidebar-width <=> ViewSettings.sidebar-width;

    function toggle-sort(c: int) {
        if (sort-column == c) {
            sort-requested(c, !sort-ascending);
        } else {
            sort-requested(c, true);
        }
    }

    // Tiles, then the table and the unit panel, then the (shared) plot dock.
    VerticalLayout {
        spacing: 16px;

        UnitsTiles {
            summary: root.summary;
            show-attention => {
                root.filter = 3;
                root.filter-changed();
            }
        }

        HorizontalLayout {
        vertical-stretch: 1;
        spacing: 0px;

        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                UnitsToolbar {
                    counts: root.counts;
                    filter <=> root.filter;
                    search <=> root.search;
                    changed-filter => { root.filter-changed(); }
                }
                UnitsTable {
                    vertical-stretch: 1;
                    units: root.sorted-units;
                    rows: root.unit-rows;
                    visible-count: root.visible-count;
                    selected-row <=> root.selected-row;
                    narrow: root.sidebar-open;
                    compact: ViewSettings.compact-rows;
                    sort-column: root.sort-column;
                    sort-ascending: root.sort-ascending;
                    sort(key) => { root.toggle-sort(key); }
                    row-selected(i) => { root.row-selected(i); }
                }
            }
        }

        // Sidebar resize handle, in the gap between the cards
        if sidebar-open: Rectangle {
            width: 16px;
            Rectangle {
                width: 2px;
                border-radius: 1px;
                background: sidebar-drag.has-hover || sidebar-drag.pressed ? Theme.accent : transparent;
            }

            sidebar-drag := TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    sidebar-width = max(300px, min(600px, sidebar-width - self.mouse-x));
                }
            }
        }

        // Sidebar
        if sidebar-open: Card {
            width: sidebar-width;
            UnitSidebar {
            width: parent.width;
            height: parent.height;
            unit: selected-row >= 0 && selected-row < sorted-units.length ? sorted-units[selected-row] : {
                name: "",
                uri: "",
                description: "",
                state: UnitState.disconnected,
                pos-x: 0,
                pos-y: 0,
                pos-z: 0,
                battery-voltage: 0,
                deck-lighthouse: false,
                deck-loco: false,
                deck-led-top: false,
                deck-led-bottom: false,
                serial: "",
                pm-state: "",
                supervisor-info: 0,
                link-quality: 0,
            };
            has-selection: selected-row >= 0 && selected-row < sorted-units.length;
            info: selected-row >= 0 && selected-row < root.unit-rows.length ? root.unit-rows[selected-row] : { slot: -1 };
            journal-entries: root.journal-entries;
            journal-clicked => {
                open-journal-requested(selected-row);
                journal-open = true;
            }
            add-journal-entry(text) => {
                add-journal-entry-requested(selected-row, text);
            }
            console-clicked => {
                open-console-requested(selected-row);
                console-open = true;
            }
            clear-console-clicked => {
                clear-console-requested(selected-row);
            }
            read-assert-clicked => {
                read-assert-requested(selected-row);
                assert-open = true;
            }
            upload-trajectory-clicked => { upload-trajectory-requested(selected-row); }
            download-trajectory-clicked => { download-trajectory-requested(selected-row); }
            fly-trajectory-clicked => { fly-trajectory-requested(selected-row); }
            clear-trajectory-clicked => { clear-trajectory-requested(selected-row); }
            generate-primitive-clicked(shape, size, sizey, zoff, ziter) => { generate-primitive-requested(selected-row, shape, size, sizey, zoff, ziter); }
            generate-wave-clicked(x, y, reps, sim, speed, zoff, ziter) => { generate-wave-requested(selected-row, x, y, reps, sim, speed, zoff, ziter); }
            takeoff-clicked(height, yaw, time, relative) => { takeoff-requested(selected-row, height, yaw, time, relative); }
            goto-clicked(x, y, z, yaw, relative, speed) => { goto-requested(selected-row, x, y, z, yaw, relative, speed); }
            random-goto-clicked => { random-goto-requested(selected-row); }
            go-home-clicked => { go-home-requested(selected-row); }
            land-clicked => { land-requested(selected-row); }
            arm-clicked(arm) => { arm-requested(selected-row, arm); }
            identify-clicked => { identify-requested(selected-row); }
            manual-control-clicked => {
                open-manual-control-requested(selected-row);
                manual-control-open = true;
            }
            recover-clicked => { recover-requested(selected-row); }
            reboot-clicked => { reboot-requested(selected-row); }
            power-off-clicked => { confirm-power-off-open = true; }
            sysoff-clicked => { sysoff-requested(selected-row); }
            syson-clicked => { syson-requested(selected-row); }
            clear-tlv-clicked => { confirm-clear-tlv-open = true; }
            close-clicked => {
                selected-row = -1;
            }
            }
        }
        }

        // The plot keeps its height; the table and the panel above give way
        if PlotBridge.dock-visible: Card {
            min-height: PlotBridge.dock-height;
            max-height: PlotBridge.dock-height;
            PlotPanel {
                width: 100%;
                height: 100%;
                shown: root.plot-shown;
                unit-name: root.sidebar-open ? root.sorted-units[root.selected-row].name : "";
            }
        }
    }

    // Sidebar action popups (journal, manual control, power-off confirm)
    UnitActionPopups {
        selected-row: root.selected-row;
        sorted-units: root.sorted-units;
        journal-entries: root.journal-entries;
        console-lines: root.console-lines;
        assert-text: root.assert-text;
        assert-busy: root.assert-busy;
        joystick-names: root.joystick-names;
        stick-lx: root.stick-lx;
        stick-ly: root.stick-ly;
        stick-rx: root.stick-rx;
        stick-ry: root.stick-ry;
        manual-control-armed: root.manual-control-armed;
        manual-control-open <=> root.manual-control-open;
        confirm-power-off-open <=> root.confirm-power-off-open;
        confirm-clear-tlv-open <=> root.confirm-clear-tlv-open;
        journal-open <=> root.journal-open;
        console-open <=> root.console-open;
        assert-open <=> root.assert-open;
        manual-control-stopped(row) => { root.manual-control-stopped(row); }
        joystick-selected(row, idx) => { root.joystick-selected(row, idx); }
        arm-requested(row, arm) => { root.arm-requested(row, arm); }
        power-off-requested(row) => { root.power-off-requested(row); }
        clear-tlv-requested(row) => { root.clear-tlv-requested(row); }
        add-journal-entry-requested(row, text) => { root.add-journal-entry-requested(row, text); }
        delete-journal-entry-requested(row, entry) => { root.delete-journal-entry-requested(row, entry); }
        clear-console-requested(row) => { root.clear-console-requested(row); }
        clear-all-console-requested() => { root.clear-all-console-requested(); }
        read-assert-requested(row) => { root.read-assert-requested(row); }
    }
}
