import { Palette } from "std-widgets.slint";

// Collapsible section header with a disclosure chevron and optional count badge.
// Shared by the planning tab and the unit sidebar.
export component SectionHeader inherits Rectangle {
    in property <string> title;
    in-out property <bool> expanded: true;
    in property <int> count: 0;
    callback toggle();

    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.background.darker(0.05) : transparent;

    touch := TouchArea {
        clicked => {
            root.expanded = !root.expanded;
            root.toggle();
        }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        spacing: 6px;
        padding-left: 4px;
        padding-right: 4px;

        Text {
            text: root.expanded ? "▾" : "▸";
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 12px;
            color: Palette.foreground.transparentize(0.4);
        }

        Text {
            text: root.title;
            font-size: 12px;
            font-weight: 600;
            color: Palette.foreground.transparentize(0.3);
            vertical-alignment: center;
        }

        if root.count > 0: Text {
            text: "(\{root.count})";
            font-size: 11px;
            color: Palette.foreground.transparentize(0.5);
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }
    }
}
