import { ListView } from "std-widgets.slint";
import { Theme, Icons, Icon, KButton, ButtonKind, IconButton, Segmented, TextField, SearchField, Dialog, MenuPanel, MenuRow, MenuSeparator } from "kit.slint";
import { Health } from "units-table.slint";

// Data pushed from Rust (plot.rs). The lines are SVG path commands in the
// plot area's pixels, drawn by Slint's `Path`.
export struct PlotLine {
    commands: string,
    // Into Theme.series
    color-index: int,
}

export struct AxisTick {
    // 0..1 along the axis: 0 = left for X, 0 = top for Y.
    pos: float,
    label: string,
}

export struct LegendEntry {
    label: string,
    color-index: int,
    // The line's pattern: solid, dashed, dotted, dash-dot (plot.rs: DASHES)
    dash: int,
    // The newest value, formatted.
    latest: string,
    // Value under the pointer, formatted; empty when not hovering.
    hover-value: string,
    // The series, for toggle-series; -1 on a unit's heading
    slot-index: int,
    // False when the series is hidden (it keeps logging).
    enabled: bool,
    // A unit's name over its variables, in one chart of several units
    head: bool,
}

// One chart: a variable with a line per unit, or every line.
export struct ChartData {
    title: string,
    lines: [PlotLine],
    y-ticks: [AxisTick],
    legend: [LegendEntry],
    // The pixel size the lines were built for
    w-px: float,
    h-px: float,
}

// One row in the "New log configuration" variable picker.
export struct LogVarRow {
    name: string,
    checked: bool,
}

// A unit in the Plot screen's list.
export struct PlotUnit {
    name: string,
    status: string,
    health: Health,
    connected: bool,
    // Ticked: it logs while logging is on
    chosen: bool,
    // It has samples in the log
    in-log: bool,
    logging: bool,
    // Its lines are drawn; hiding them doesn't stop the logging
    shown: bool,
    // Into Theme.series, -1 before it has a colour
    color-index: int,
}

// The log and its plots. The Plot screen, and the dock under the Units table
// and the 3D view, read and write this one global, so they show one log.
export global PlotBridge {
    // ----- The charts (pushed from Rust) -----
    in property <[ChartData]> charts;
    in property <[AxisTick]> x-ticks;
    in property <bool> has-view;
    in property <bool> hover-active;
    in property <float> hover-x;        // 0..1 within the plot area
    in property <string> hover-time;
    in property <float> nav-min-frac;
    in property <float> nav-max-frac: 1.0;

    // ----- How it is shown -----
    in-out property <bool> dock-visible: false;
    in-out property <length> dock-height: 320px;
    // Last polled size: the plot area's width, the charts' height
    in-out property <float> area-w-px;
    in-out property <float> area-h-px;
    // The time shown while following the newest samples: 10 s, 30 s, 1 min
    // or the whole log (plot.rs: WINDOWS_MS).
    in-out property <int> window: 1;
    // A chart per variable, else one chart with every line
    in-out property <bool> split: true;
    // In one chart: each line on its own scale
    in-out property <bool> normalized: false;

    // ----- The log (set from Rust) -----
    in property <bool> logging-active;
    // The units in the log, or chosen for it
    in property <string> logging-unit;
    in property <string> status-text;
    in property <string> log-summary;
    in property <bool> has-data;
    in property <[PlotUnit]> unit-choices;
    in property <int> connected-count;
    // Ticked and connected
    in property <int> chosen-count;

    // ----- Configurations -----
    in property <[string]> config-names;
    in-out property <int> config-index: -1;
    in property <[string]> config-variables;
    in property <int> config-period;
    in-out property <bool> show-new-config: false;
    // The variable picker: the TOC of `toc-unit`
    in property <[LogVarRow]> toc-rows;
    in property <string> toc-status: "";
    in property <string> toc-unit;
    in-out property <string> toc-filter: "";

    // ----- Callbacks out to Rust -----
    callback pan-start();
    callback pan-move(float, float);
    callback zoom(float, float, float);
    callback reset();
    callback hover(float);
    callback size-changed(float, float);
    callback nav-press(float);
    callback nav-drag(float);
    callback toggle-series(int);
    // The dock's Start: the selected unit
    callback start-logging();
    // The Plot screen's Start: the ticked units
    callback start-chosen();
    callback stop-logging();
    callback toggle-unit(string);
    callback toggle-unit-shown(string);
    callback choose-all();
    callback choose-none();
    callback select-config(int);
    callback delete-config(int);
    callback save-csv();
    callback clear-log();
    // New-config dialog: prepare loads a unit's TOC into the picker.
    callback prepare-new-config();
    callback toggle-toc-var(string);
    callback toc-filter-changed(string);
    // Save the ticked variables as a configuration (name, period ms).
    callback save-new-config(string, float);
}

// The charts, stacked on one time axis: Y ticks | plot area | legend, then
// the X ticks and the navigator. Reads everything from PlotBridge.
export component Plot inherits Rectangle {
    // What to say while there is nothing to draw
    in property <string> empty-text;
    // On screen: only then it measures itself for plot.rs
    in property <bool> shown: true;
    in property <length> legend-width: 210px;

    // Poll the size the lines are built for and push it to Rust when it
    // changes. From a Timer (not `changed width`): changed callbacks on
    // layout-driven sizes recurse during item-geometry lookups.
    Timer {
        interval: 200ms;
        running: root.shown;
        triggered => {
            if (probe.width > 1px && stack.height > 1px
                && (probe.width / 1px != PlotBridge.area-w-px || stack.height / 1px != PlotBridge.area-h-px)) {
                PlotBridge.area-w-px = probe.width / 1px;
                PlotBridge.area-h-px = stack.height / 1px;
                PlotBridge.size-changed(probe.width / 1px, stack.height / 1px);
            }
        }
    }

    VerticalLayout {
        padding-left: 6px;
        padding-right: 14px;
        padding-bottom: 10px;

        // The plot area's width
        HorizontalLayout {
            height: 0px;
            Rectangle { width: 58px; }
            probe := Rectangle { }
            Rectangle { width: root.legend-width; }
        }

        stack := VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            for chart[ci] in PlotBridge.charts: VerticalLayout {
                // Equal shares, whatever the legends hold (plot.rs: chart_h)
                vertical-stretch: 1;
                min-height: 0px;
                preferred-height: 0px;
                if chart.title != "": HorizontalLayout {
                    height: 20px;
                    padding-left: 58px;
                    Text {
                        text: chart.title;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    min-height: 0px;

                    // Y ticks
                    Rectangle {
                        width: 58px;
                        min-height: 0px;
                        for t in chart.y-ticks: Text {
                            x: 0;
                            y: t.pos * parent.height - self.height / 2;
                            width: parent.width - 8px;
                            text: t.label;
                            font-family: Theme.font-mono;
                            font-size: 10.5px;
                            color: Theme.text3;
                            horizontal-alignment: right;
                        }
                    }

                    // The plot area
                    Rectangle {
                        min-height: 0px;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 8px;
                        clip: true;

                        for t in PlotBridge.x-ticks: Rectangle {
                            x: t.pos * parent.width;
                            y: 0;
                            width: 1px;
                            height: parent.height;
                            background: Theme.border;
                        }
                        for t in chart.y-ticks: Rectangle {
                            x: 0;
                            y: t.pos * parent.height;
                            width: parent.width;
                            height: 1px;
                            background: Theme.border;
                        }
                        for ln in chart.lines: Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: chart.w-px;
                            viewbox-height: chart.h-px;
                            stroke: Theme.series[mod(ln.color-index, 8)];
                            stroke-width: 1.75px;
                            commands: ln.commands;
                        }
                        if PlotBridge.hover-active: Rectangle {
                            x: PlotBridge.hover-x * parent.width;
                            y: 0;
                            width: 1px;
                            height: parent.height;
                            background: Theme.text3;
                        }
                        if PlotBridge.hover-active && ci == 0: MenuPanel {
                            x: max(0px, min(parent.width - self.width, PlotBridge.hover-x * parent.width - self.width / 2));
                            y: 6px;
                            width: hover-label.preferred-width + 14px;
                            height: 22px;
                            drop-shadow-blur: 8px;
                            drop-shadow-offset-y: 2px;
                            hover-label := Text {
                                text: PlotBridge.hover-time;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                color: Theme.text;
                            }
                        }
                        // Drag to pan, scroll to zoom, double-click to follow again
                        TouchArea {
                            mouse-cursor: self.pressed ? grabbing : crosshair;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    PlotBridge.pan-start();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    PlotBridge.pan-move(
                                        ((self.mouse-x - self.pressed-x) / 1px) / (self.width / 1px),
                                        ((self.mouse-y - self.pressed-y) / 1px) / (self.height / 1px));
                                } else {
                                    PlotBridge.hover((self.mouse-x / 1px) / (self.width / 1px));
                                }
                            }
                            changed has-hover => {
                                if (!self.has-hover) {
                                    PlotBridge.hover(-1);
                                }
                            }
                            scroll-event(e) => {
                                PlotBridge.zoom(
                                    (self.mouse-x / 1px) / (self.width / 1px),
                                    (self.mouse-y / 1px) / (self.height / 1px),
                                    e.delta-y / 1px);
                                return accept;
                            }
                            double-clicked => { PlotBridge.reset(); }
                        }
                    }

                    // The legend: the newest value, or the one under the
                    // pointer. A click hides a line; it keeps logging.
                    Rectangle {
                        width: root.legend-width;
                        min-height: 0px;
                        Flickable {
                            viewport-height: legend-layout.preferred-height;
                            legend-layout := VerticalLayout {
                                padding-left: 12px;
                                alignment: start;
                                for e in chart.legend: Rectangle {
                                    height: e.head ? 24px : 26px;
                                    border-radius: 6px;
                                    background: !e.head && legend-touch.has-hover ? Theme.hover : transparent;
                                    legend-touch := TouchArea {
                                        enabled: !e.head;
                                        mouse-cursor: pointer;
                                        clicked => { PlotBridge.toggle-series(e.slot-index); }
                                    }
                                    if e.head: HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 8px;
                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 3px;
                                            background: Theme.series[mod(e.color-index, 8)];
                                            opacity: e.enabled ? 1.0 : 0.4;
                                        }
                                        Text {
                                            text: e.label;
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            color: e.enabled ? Theme.text2 : Theme.text3;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !e.head: HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 8px;
                                        Path {
                                            y: (parent.height - self.height) / 2;
                                            width: 18px;
                                            height: 10px;
                                            viewbox-width: 18;
                                            viewbox-height: 10;
                                            stroke: Theme.series[mod(e.color-index, 8)];
                                            stroke-width: 2px;
                                            opacity: e.enabled ? 1.0 : 0.35;
                                            commands: e.dash == 1 ? "M 0 5 L 7 5 M 11 5 L 18 5"
                                                : e.dash == 2 ? "M 0 5 L 2 5 M 5 5 L 7 5 M 10 5 L 12 5 M 15 5 L 17 5"
                                                : e.dash == 3 ? "M 0 5 L 9 5 M 12 5 L 14 5"
                                                : "M 0 5 L 18 5";
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: e.label;
                                            font-size: 12.5px;
                                            color: e.enabled ? Theme.text : Theme.text3;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: !e.enabled ? "hidden" : e.hover-value != "" ? e.hover-value : e.latest;
                                            font-family: Theme.font-mono;
                                            font-size: 12.5px;
                                            font-weight: e.enabled ? 600 : 400;
                                            color: !e.enabled ? Theme.text3 : e.hover-value != "" ? Theme.accent-text : Theme.text;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Nothing logged yet
            if PlotBridge.charts.length == 0: HorizontalLayout {
                vertical-stretch: 1;
                Rectangle { width: 58px; }
                Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;
                    Text {
                        width: parent.width - 48px;
                        text: root.empty-text;
                        font-size: 13px;
                        color: Theme.text3;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
                Rectangle { width: root.legend-width; }
            }
        }

        // Seconds since the log started
        HorizontalLayout {
            height: 20px;
            Rectangle { width: 58px; }
            Rectangle {
                for t in PlotBridge.x-ticks: Text {
                    x: t.pos * parent.width - self.preferred-width / 2;
                    y: 4px;
                    text: t.label;
                    font-family: Theme.font-mono;
                    font-size: 10.5px;
                    color: Theme.text3;
                }
            }
            Rectangle { width: root.legend-width; }
        }
        // Where the view is in the whole log
        HorizontalLayout {
            height: 14px;
            Rectangle { width: 58px; }
            Rectangle {
                Rectangle {
                    y: 5px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.border;
                }
                Rectangle {
                    x: PlotBridge.nav-min-frac * parent.width;
                    y: 3px;
                    width: max(8px, (PlotBridge.nav-max-frac - PlotBridge.nav-min-frac) * parent.width);
                    height: 8px;
                    border-radius: 4px;
                    background: nav-touch.has-hover || nav-touch.pressed ? Theme.accent : Theme.border2;
                }
                nav-touch := TouchArea {
                    mouse-cursor: self.pressed ? grabbing : pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            PlotBridge.nav-press((self.mouse-x / 1px) / (self.width / 1px));
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            PlotBridge.nav-drag((self.mouse-x / 1px) / (self.width / 1px));
                        }
                    }
                }
            }
            Rectangle { width: root.legend-width; }
        }
    }
}

// The configurations to pick from, a new one, and deleting the picked one.
export component ConfigMenu inherits PopupWindow {
    in property <bool> can-delete;
    width: 280px;
    MenuPanel {
        width: root.width;
        height: config-list.preferred-height;
        config-list := VerticalLayout {
            padding: 6px;
            for name[i] in PlotBridge.config-names: MenuRow {
                text: name;
                checked: i == PlotBridge.config-index;
                clicked => {
                    PlotBridge.config-index = i;
                    PlotBridge.select-config(i);
                }
            }
            if PlotBridge.config-names.length > 0: MenuSeparator {}
            MenuRow {
                text: "New log configuration…";
                icon: Icons.plus;
                clicked => {
                    PlotBridge.show-new-config = true;
                    PlotBridge.prepare-new-config();
                }
            }
            if root.can-delete && PlotBridge.config-index >= 0 && PlotBridge.config-index < PlotBridge.config-names.length: MenuRow {
                text: "Delete " + PlotBridge.config-names[PlotBridge.config-index];
                icon: Icons.trash;
                danger: true;
                clicked => { PlotBridge.delete-config(PlotBridge.config-index); }
            }
        }
    }
}

// The dock under the Units table and the 3D view: the log, small. Its Start
// logs the selected unit.
export component PlotPanel inherits Rectangle {
    // The selected unit, which Start logs; empty when none is
    in property <string> unit-name;
    // On screen: the Plot measures itself only then
    in property <bool> shown: true;

    property <bool> has-config: PlotBridge.config-index >= 0 && PlotBridge.config-index < PlotBridge.config-names.length;
    property <string> config-name: root.has-config ? PlotBridge.config-names[PlotBridge.config-index] : "";
    // Who is plotted: the log's units, else the one Start would log
    property <string> plotted: PlotBridge.logging-active || PlotBridge.has-data ? PlotBridge.logging-unit : root.unit-name;

    height: PlotBridge.dock-height;
    background: Theme.surface;

    VerticalLayout {
        spacing: 0px;

        // Drag the top edge to make the dock taller
        Rectangle {
            height: 10px;
            Rectangle {
                width: 40px;
                height: 4px;
                border-radius: 2px;
                background: height-drag.has-hover || height-drag.pressed ? Theme.accent : Theme.border2;
            }
            height-drag := TouchArea {
                mouse-cursor: ns-resize;
                moved => {
                    PlotBridge.dock-height = clamp(PlotBridge.dock-height - (self.mouse-y - self.pressed-y), 220px, 720px);
                }
            }
        }

        // What is logged from which unit, and how it is shown
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            spacing: 8px;

            Text {
                text: "Plot";
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                max-width: 220px;
                text: root.plotted != "" ? root.plotted : "No unit selected";
                font-size: 13px;
                font-weight: root.plotted != "" ? 600 : 400;
                color: root.plotted != "" ? Theme.accent-text : Theme.text3;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { width: 4px; }
            config-button := KButton {
                y: (parent.height - self.height) / 2;
                small: true;
                icon: Icons.list;
                text: root.has-config ? root.config-name : "Choose variables";
                enabled: !PlotBridge.logging-active;
                clicked => { config-menu.show(); }
            }
            KButton {
                y: (parent.height - self.height) / 2;
                small: true;
                icon: PlotBridge.logging-active ? Icons.stop : Icons.play;
                text: PlotBridge.logging-active ? "Stop" : "Start";
                kind: PlotBridge.logging-active ? ButtonKind.normal : ButtonKind.primary;
                enabled: PlotBridge.logging-active || (root.has-config && root.unit-name != "");
                clicked => {
                    if (PlotBridge.logging-active) {
                        PlotBridge.stop-logging();
                    } else {
                        PlotBridge.start-logging();
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: PlotBridge.status-text;
                font-size: Theme.font-small;
                color: Theme.text2;
                vertical-alignment: center;
                overflow: elide;
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                height: 32px;
                items: [{ label: "10 s" }, { label: "30 s" }, { label: "1 min" }, { label: "All" }];
                current <=> PlotBridge.window;
                selected => { PlotBridge.reset(); }
            }
            Segmented {
                y: (parent.height - self.height) / 2;
                height: 32px;
                items: [{ label: "Per variable" }, { label: "One chart" }];
                current: PlotBridge.split ? 0 : 1;
                selected(i) => {
                    PlotBridge.split = i == 0;
                    PlotBridge.reset();
                }
            }
            KButton {
                y: (parent.height - self.height) / 2;
                small: true;
                kind: ButtonKind.ghost;
                icon: Icons.fit;
                text: "Follow";
                tooltip: "Back to the newest samples (or double-click the plot)";
                enabled: PlotBridge.has-view;
                clicked => { PlotBridge.reset(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.close;
                clicked => { PlotBridge.dock-visible = false; }
            }
        }
        Rectangle { height: 10px; }

        Plot {
            vertical-stretch: 1;
            shown: root.shown;
            empty-text: PlotBridge.logging-active ? "Waiting for the first samples from " + PlotBridge.logging-unit + "…"
                : root.unit-name == "" ? "Select a unit to plot its log variables."
                : PlotBridge.config-names.length == 0 ? "Choose variables › New log configuration picks what to log from " + root.unit-name + "'s log TOC."
                : !root.has-config ? "Choose the variables to log, then Start."
                : "Start logs " + root.config-name + " from " + root.unit-name + ".";
        }
    }

    config-menu := ConfigMenu {
        x: config-button.absolute-position.x - root.absolute-position.x;
        y: config-button.absolute-position.y - root.absolute-position.y + config-button.height + 4px;
    }
}

// Create a log configuration from a unit's log TOC and keep it in the
// settings. At the AppWindow root, gated by `PlotBridge.show-new-config`.
export component PlotNewConfigDialog inherits Dialog {
    title: "New log configuration";
    note: PlotBridge.toc-unit != ""
        ? "The variables come from " + PlotBridge.toc-unit + "'s log TOC; a unit that lacks one logs the others. Kept in the settings, for every swarm."
        : "The variables come from a connected unit's log TOC. Kept in the settings, for every swarm.";
    panel-width: 560px;
    panel-height: 620px;
    close => { PlotBridge.show-new-config = false; }

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: "Name";
                font-size: Theme.font-small;
                color: Theme.text2;
            }
            name-field := TextField {
                placeholder: "e.g. Attitude";
            }
        }
        VerticalLayout {
            width: 110px;
            spacing: 4px;
            Text {
                text: "Period (ms)";
                font-size: Theme.font-small;
                color: Theme.text2;
            }
            period-field := TextField {
                text: "100";
            }
        }
    }

    SearchField {
        placeholder: "Filter, e.g. stateEstimate";
        text <=> PlotBridge.toc-filter;
        edited(t) => { PlotBridge.toc-filter-changed(t); }
    }

    Rectangle {
        vertical-stretch: 1;
        border-radius: Theme.radius-control + 2px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        clip: true;
        ListView {
            for row in PlotBridge.toc-rows: Rectangle {
                height: 30px;
                background: row-touch.has-hover ? Theme.hover : transparent;
                row-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { PlotBridge.toggle-toc-var(row.name); }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 16px;
                        height: 16px;
                        border-radius: 4px;
                        border-width: row.checked ? 0px : 1.5px;
                        border-color: Theme.border2;
                        background: row.checked ? Theme.accent-button : Theme.surface;
                        if row.checked: Icon {
                            source: Icons.check;
                            width: 12px;
                            height: 12px;
                            color: #ffffff;
                        }
                    }
                    Text {
                        text: row.name;
                        font-family: Theme.font-mono;
                        font-size: 12.5px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if PlotBridge.toc-status != "": Text {
        text: PlotBridge.toc-status;
        font-size: Theme.font-small;
        color: Theme.text2;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        KButton {
            text: "Cancel";
            clicked => { PlotBridge.show-new-config = false; }
        }
        KButton {
            text: "Save";
            kind: ButtonKind.primary;
            enabled: name-field.text != "";
            // Rust checks and closes it (keeps it open with a message when
            // nothing is ticked).
            clicked => { PlotBridge.save-new-config(name-field.text, period-field.text.to-float()); }
        }
    }
}
