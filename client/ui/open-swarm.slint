import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, KButton, ButtonKind, TextField, Dialog } from "kit.slint";

// A swarm to open: a file in the swarms folder, or a swarm shared on the
// server (`<org>/<swarm>`).
export struct SwarmChoice {
    id: string,
    name: string,
    units: int,
    detail: string,        // where it is stored
    shared: bool,
    current: bool,         // the open swarm
}

// The title over a list, with a note on the right.
component ListTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> note;
    spacing: 8px;
    Text {
        text: root.text;
        font-size: Theme.font-tiny;
        font-weight: 600;
        color: Theme.text3;
        vertical-alignment: center;
    }
    Text {
        text: root.note;
        font-size: Theme.font-small;
        color: Theme.text3;
        vertical-alignment: center;
        horizontal-alignment: right;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

component SwarmList inherits Rectangle {
    in property <[SwarmChoice]> swarms;
    in property <string> empty-text;
    in property <bool> enabled;
    in property <string> selected-id;
    in property <bool> selected-shared;
    callback select(/* id */ string, /* shared */ bool);
    callback open(/* id */ string, /* shared */ bool);

    border-radius: Theme.radius-control + 2px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;

    if root.swarms.length == 0: Text {
        text: root.empty-text;
        font-size: 13px;
        color: Theme.text3;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: parent.width - 32px;
    }

    ScrollView {
        VerticalLayout {
            alignment: start;

            for swarm[i] in root.swarms: Rectangle {
                property <bool> chosen: swarm.id == root.selected-id && swarm.shared == root.selected-shared;
                height: 48px;
                background: chosen ? Theme.accent-tint : touch.has-hover ? Theme.hover : transparent;

                if i > 0: Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: swarm.shared ? Icons.cloud : Icons.swarm;
                        width: 18px;
                        height: 18px;
                        color: chosen ? Theme.accent-text : Theme.text3;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: swarm.id;
                                font-size: 13px;
                                font-weight: 600;
                                color: chosen ? Theme.accent-text : Theme.text;
                                overflow: elide;
                            }
                            if swarm.current: Text {
                                text: "Open now";
                                font-size: Theme.font-tiny;
                                font-weight: 600;
                                color: Theme.accent-text;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: swarm.name;
                            font-size: Theme.font-small;
                            color: Theme.text2;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: swarm.units == 1 ? "1 unit" : "\{swarm.units} units";
                        font-size: Theme.font-small;
                        color: Theme.text2;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 64px;
                    }
                    Text {
                        text: swarm.detail;
                        font-size: Theme.font-small;
                        color: Theme.text3;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 170px;
                        overflow: elide;
                    }
                }

                touch := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: pointer;
                    clicked => { root.select(swarm.id, swarm.shared); }
                    double-clicked => { root.open(swarm.id, swarm.shared); }
                }
            }
        }
    }
}

// Open swarm: the swarm files on this computer and the swarms shared in the
// user's organizations.
export component OpenSwarmDialog inherits Dialog {
    in property <[SwarmChoice]> local;
    in property <[SwarmChoice]> shared;
    in property <string> shared-title;     // "Shared on arc.bitcraze.io"
    in property <string> shared-note;      // loading, offline, not signed in, ...
    in property <bool> signed-in;
    in property <bool> busy;               // opening a swarm
    in property <string> error;
    in-out property <string> selected-id;
    in-out property <bool> selected-shared;

    callback open(/* id */ string, /* shared */ bool);
    callback browse();
    callback sign-in();

    title: "Open swarm";
    note: "A swarm file on this computer, or a swarm shared in your organizations. Double-click to open.";
    panel-width: 760px;
    panel-height: 660px;
    closable: !root.busy;

    VerticalLayout {
        vertical-stretch: 1;
        spacing: 8px;

        ListTitle {
            text: "ON THIS COMPUTER";
            note: root.local.length == 1 ? "1 swarm file" : root.local.length + " swarm files";
        }
        SwarmList {
            vertical-stretch: 1;
            swarms: root.local;
            empty-text: "No swarm files in the swarms folder. Browse for a swarm file instead.";
            enabled: !root.busy;
            selected-id: root.selected-id;
            selected-shared: root.selected-shared;
            select(id, shared) => { root.selected-id = id; root.selected-shared = shared; }
            open(id, shared) => { root.open(id, shared); }
        }

        Rectangle { height: 8px; }

        ListTitle {
            text: root.shared-title.to-uppercase();
            note: root.shared-note;
        }
        if root.signed-in: SwarmList {
            vertical-stretch: 1;
            swarms: root.shared;
            empty-text: "No swarms are shared in your organizations yet.";
            enabled: !root.busy;
            selected-id: root.selected-id;
            selected-shared: root.selected-shared;
            select(id, shared) => { root.selected-id = id; root.selected-shared = shared; }
            open(id, shared) => { root.open(id, shared); }
        }
        if !root.signed-in: Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-control + 2px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface2;

            VerticalLayout {
                alignment: center;
                spacing: 14px;
                padding: 16px;

                HorizontalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.cloud;
                        width: 24px;
                        height: 24px;
                        color: Theme.text3;
                    }
                }
                Text {
                    text: "Sign in to open the swarms shared in your organizations, by you, in cfcli or by the people you fly with.";
                    font-size: 13px;
                    color: Theme.text2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    KButton {
                        text: "Sign in…";
                        icon: Icons.user;
                        enabled: !root.busy;
                        clicked => { root.sign-in(); }
                    }
                }
            }
        }
    }

    if root.error != "": Text {
        text: root.error;
        font-size: 13px;
        color: Theme.crit-text;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 8px;

        KButton {
            text: "Browse…";
            icon: Icons.folder;
            enabled: !root.busy;
            clicked => { root.browse(); }
        }
        Rectangle { horizontal-stretch: 1; }
        KButton {
            text: "Cancel";
            enabled: !root.busy;
            clicked => { root.close(); }
        }
        KButton {
            text: root.busy ? "Opening…" : "Open";
            kind: ButtonKind.primary;
            enabled: !root.busy && root.selected-id != "";
            clicked => { root.open(root.selected-id, root.selected-shared); }
        }
    }
}

// Sign in to the server that shares swarms. The browser does the signing in;
// this waits for it.
export component SignInDialog inherits Dialog {
    in-out property <string> server;
    in property <bool> waiting;            // for the user to allow Swarmkeeper in the browser
    in property <string> link;             // the sign-in page, while waiting
    in property <string> error;

    callback sign-in(/* server */ string);
    callback open-link();
    callback cancel();

    title: "Sign in";
    note: root.waiting
        ? "Allow Swarmkeeper in the browser. The browser hands the key back to Swarmkeeper by itself; there is nothing to copy. If the browser didn't open, open this link in a browser on this computer:"
        : "Swarmkeeper opens the sign-in page in your browser. Sign in with GitHub or Google and allow Swarmkeeper, and it can open the swarms shared in your organizations. Swarmkeeper gets a key of its own, listed on the server's API keys page, where you can revoke it.";
    panel-width: 560px;
    closable: !root.waiting;

    if root.waiting: TextField {
        text: root.link;
        read-only: true;
    }

    if !root.waiting: HorizontalLayout {
        spacing: 10px;
        Text {
            text: "Server";
            font-size: 13px;
            color: Theme.text2;
            vertical-alignment: center;
        }
        TextField {
            horizontal-stretch: 1;
            text <=> root.server;
            accepted => { root.sign-in(root.server); }
        }
    }

    if root.error != "": Text {
        text: root.error;
        font-size: 13px;
        color: Theme.crit-text;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        if root.waiting: KButton {
            text: "Open browser again";
            clicked => { root.open-link(); }
        }
        if root.waiting: KButton {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
        if !root.waiting: KButton {
            text: "Close";
            clicked => { root.close(); }
        }
        if !root.waiting: KButton {
            text: "Sign in";
            kind: ButtonKind.primary;
            enabled: root.server != "";
            clicked => { root.sign-in(root.server); }
        }
    }
}
