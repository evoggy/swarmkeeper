import { VerticalBox, HorizontalBox, TabWidget, Palette, Button, LineEdit, ScrollView, ComboBox, CheckBox } from "std-widgets.slint";
import { UnitsContent } from "units.slint";
import { VisualizationContent, VizLabel } from "visualization.slint";
import { UnitData, UnitState, JournalEntryData } from "unit-card.slint";
import { RadioTestContent, ChannelResult } from "radio-test.slint";
import { LocoContent, LocoAnchorStatus } from "loco.slint";
import { LhBaseStationData } from "lh-coverage.slint";
import { Tdoa3AnchorData } from "tdoa3-coverage.slint";
import { LhWizardContent, WizardSampleData, WizardBsData } from "lh-wizard.slint";
import { PlanningContent, PlanObstacleData, PlanPadData, PlanBoxVolumeData } from "planning.slint";
import { SnifferContent, SnifferAnchorRow, SnifferFeedRow, SnifferMatrixRow, SnifferSurveyRow } from "sniffer.slint";
import { PlotBridge, PlotLine, AxisTick, LegendEntry, PlotNewConfigDialog } from "plot.slint";

// Re-export the plot globals/structs from the root so the Rust side can reach
// PlotBridge via `ui.global::<PlotBridge>()` and the generated data structs.
export { PlotBridge, PlotLine, AxisTick, LegendEntry }

export struct HealthTestResult {
    name: string,
    status: string,
    m1-pass: bool,
    m2-pass: bool,
    m3-pass: bool,
    m4-pass: bool,
}

export struct SwarmParamData {
    name: string,
    type-name: string,
    writable: bool,
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    background: (root.enabled && touch.has-hover) ? Palette.accent-background : transparent;

    Text {
        text: root.text;
        font-size: 13px;
        color: root.enabled ? Palette.foreground : Palette.foreground.with-alpha(0.4);
        vertical-alignment: center;
        x: 16px;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }
}

component MenuSeparator inherits Rectangle {
    height: 9px;

    Rectangle {
        height: 1px;
        width: parent.width - 16px;
        background: Palette.border;
    }
}

component MenuTitle inherits Rectangle {
    in property <string> text;
    callback clicked();

    Text {
        text: root.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component MenuBar inherits Rectangle {
    callback exit-clicked();
    callback open-swarm-clicked();
    callback connect-clicked();
    callback disconnect-clicked();
    callback reconnect-clicked();
    callback arm-all-clicked();
    callback disarm-all-clicked();
    callback upload-trajectory-swarm-clicked();
    callback fly-trajectory-swarm-clicked();
    callback sync-blink-clicked();
    callback delayed-sync-blink-clicked();
    callback land-swarm-clicked();
    callback reboot-swarm-clicked();
    callback sysoff-swarm-clicked();
    callback syson-swarm-clicked();
    callback power-off-swarm-clicked();
    callback clear-all-console-clicked();
    callback download-toc-clicked();
    callback upload-geometry-clicked();
    callback upload-params-clicked();
    callback clear-tlv-clicked();
    callback tuning-clicked();
    callback set-param-clicked();
    callback health-test-clicked();
    callback flash-firmware-clicked();

    in property <bool> connected;

    height: 30px;

    HorizontalBox {
        padding: 0px;
        spacing: 0px;
        alignment: start;

        MenuTitle { width: 54px; text: "File"; clicked => { file-popup.show(); } }
        MenuTitle { width: 66px; text: "Swarm"; clicked => { swarm-popup.show(); } }
        MenuTitle { width: 60px; text: "Flight"; clicked => { flight-popup.show(); } }
        MenuTitle { width: 68px; text: "System"; clicked => { system-popup.show(); } }
        MenuTitle { width: 60px; text: "Setup"; clicked => { setup-popup.show(); } }
        MenuTitle { width: 92px; text: "Diagnostics"; clicked => { diagnostics-popup.show(); } }
    }

    file-popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: 180px;

        Rectangle {
            width: 180px;
            height: 64px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                MenuItem {
                    text: "Open swarm...";
                    clicked => { file-popup.close(); open-swarm-clicked(); }
                }
                MenuItem {
                    text: "Exit";
                    clicked => { file-popup.close(); exit-clicked(); }
                }
            }
        }
    }

    swarm-popup := PopupWindow {
        x: 54px;
        y: root.height;
        width: 180px;

        Rectangle {
            width: 180px;
            height: 169px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                MenuItem {
                    text: "Connect Swarm";
                    enabled: !root.connected;
                    clicked => { swarm-popup.close(); connect-clicked(); }
                }
                MenuItem {
                    text: "Disconnect";
                    enabled: root.connected;
                    clicked => { swarm-popup.close(); disconnect-clicked(); }
                }
                MenuItem {
                    text: "Reconnect";
                    enabled: root.connected;
                    clicked => { swarm-popup.close(); reconnect-clicked(); }
                }
                MenuSeparator {}
                MenuItem {
                    text: "Arm All";
                    enabled: root.connected;
                    clicked => { swarm-popup.close(); arm-all-clicked(); }
                }
                MenuItem {
                    text: "Disarm All";
                    enabled: root.connected;
                    clicked => { swarm-popup.close(); disarm-all-clicked(); }
                }
            }
        }
    }

    flight-popup := PopupWindow {
        x: 120px;
        y: root.height;
        width: 180px;

        Rectangle {
            width: 180px;
            height: 178px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                MenuItem {
                    text: "Upload Trajectory";
                    enabled: root.connected;
                    clicked => { flight-popup.close(); upload-trajectory-swarm-clicked(); }
                }
                MenuItem {
                    text: "Fly Trajectory";
                    enabled: root.connected;
                    clicked => { flight-popup.close(); fly-trajectory-swarm-clicked(); }
                }
                MenuSeparator {}
                MenuItem {
                    text: "Sync Blink";
                    enabled: root.connected;
                    clicked => { flight-popup.close(); sync-blink-clicked(); }
                }
                MenuItem {
                    text: "Delayed Sync Blink";
                    enabled: root.connected;
                    clicked => { flight-popup.close(); delayed-sync-blink-clicked(); }
                }
                MenuSeparator {}
                MenuItem {
                    text: "Land All";
                    enabled: root.connected;
                    clicked => { flight-popup.close(); land-swarm-clicked(); }
                }
            }
        }
    }

    system-popup := PopupWindow {
        x: 180px;
        y: root.height;
        width: 180px;

        Rectangle {
            width: 180px;
            height: 243px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                MenuItem {
                    text: "Reboot";
                    clicked => { system-popup.close(); reboot-swarm-clicked(); }
                }
                MenuItem {
                    text: "Sleep";
                    clicked => { system-popup.close(); sysoff-swarm-clicked(); }
                }
                MenuItem {
                    text: "Wake Up";
                    clicked => { system-popup.close(); syson-swarm-clicked(); }
                }
                MenuSeparator {}
                MenuItem {
                    text: "Flash Firmware...";
                    clicked => { system-popup.close(); flash-firmware-clicked(); }
                }
                MenuSeparator {}
                MenuItem {
                    text: "Power Off...";
                    clicked => { system-popup.close(); power-off-swarm-clicked(); }
                }
                MenuSeparator {}
                MenuItem {
                    text: "Clear All Console";
                    clicked => { system-popup.close(); clear-all-console-clicked(); }
                }
            }
        }
    }

    setup-popup := PopupWindow {
        x: 248px;
        y: root.height;
        width: 180px;

        Rectangle {
            width: 180px;
            height: 201px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                MenuItem {
                    text: "Download TOC";
                    enabled: !root.connected;
                    clicked => { setup-popup.close(); download-toc-clicked(); }
                }
                MenuItem {
                    text: "Upload Geometry";
                    enabled: !root.connected;
                    clicked => { setup-popup.close(); upload-geometry-clicked(); }
                }
                MenuSeparator {}
                MenuItem {
                    text: "Upload Params";
                    clicked => { setup-popup.close(); upload-params-clicked(); }
                }
                MenuItem {
                    text: "Clear TLV...";
                    clicked => { setup-popup.close(); clear-tlv-clicked(); }
                }
                MenuItem {
                    text: "Set Parameter...";
                    enabled: root.connected;
                    clicked => { setup-popup.close(); set-param-clicked(); }
                }
                MenuItem {
                    text: "Tuning...";
                    clicked => { setup-popup.close(); tuning-clicked(); }
                }
            }
        }
    }

    diagnostics-popup := PopupWindow {
        x: 308px;
        y: root.height;
        width: 180px;

        Rectangle {
            width: 180px;
            height: 32px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                MenuItem {
                    text: "Health Test...";
                    enabled: !root.connected;
                    clicked => { diagnostics-popup.close(); health-test-clicked(); }
                }
            }
        }
    }
}

component SwarmInfoBar inherits Rectangle {
    in property <string> swarm-name;
    in property <[UnitData]> units;
    in property <bool> connected;
    in property <int> connected-count;
    in property <int> selftest-passed-count;
    in property <int> battery-count;
    in property <int> charging-count;
    in property <int> charged-count;
    callback connect-clicked();
    callback disconnect-clicked();
    callback reconnect-clicked();
    callback land-swarm-clicked();
    callback emergency-stop-clicked();

    property <float> progress: units.length > 0 ? connected-count / units.length : 0;
    property <bool> connecting: connected && progress < 1.0;
    property <float> selftest-progress: connected-count > 0 ? selftest-passed-count / connected-count : 0;
    property <float> power-total: battery-count + charging-count + charged-count;

    height: 48px;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalBox {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;

        Text {
            text: swarm-name;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: connected-count > 0
                    ? "\{connected-count}/\{units.length} connected"
                    : "\{units.length} units";
                font-size: 13px;
                color: Palette.foreground.transparentize(0.4);
            }

            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Palette.border;

                Rectangle {
                    x: 0px;
                    width: parent.width * progress;
                    height: parent.height;
                    border-radius: 2px;
                    background: progress >= 1.0 ? limegreen : dodgerblue;
                }
            }
        }

        if connected-count > 0: VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: "\{selftest-passed-count}/\{connected-count} selftest";
                font-size: 13px;
                color: Palette.foreground.transparentize(0.4);
            }

            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Palette.border;

                Rectangle {
                    x: 0px;
                    width: parent.width * selftest-progress;
                    height: parent.height;
                    border-radius: 2px;
                    background: selftest-progress >= 1.0 ? limegreen : red;
                }
            }
        }

        if connected-count > 0 && power-total > 0: VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: battery-count > 0 && (charging-count > 0 || charged-count > 0)
                    ? "\{battery-count} battery, \{charging-count} charging, \{charged-count} charged"
                    : charging-count > 0 || charged-count > 0
                    ? "\{charging-count} charging, \{charged-count} charged"
                    : "\{battery-count} battery";
                font-size: 13px;
                color: Palette.foreground.transparentize(0.4);
            }

            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Palette.border;

                // Battery portion (dodgerblue)
                Rectangle {
                    x: 0px;
                    width: parent.width * (battery-count / power-total);
                    height: parent.height;
                    border-radius: 2px;
                    background: dodgerblue;
                }

                // Charging portion (orange)
                Rectangle {
                    x: parent.width * (battery-count / power-total);
                    width: parent.width * (charging-count / power-total);
                    height: parent.height;
                    background: orange;
                }

                // Charged portion (limegreen)
                Rectangle {
                    x: parent.width * ((battery-count + charging-count) / power-total);
                    width: parent.width * (charged-count / power-total);
                    height: parent.height;
                    border-radius: 2px;
                    background: limegreen;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if connected && connected-count < units.length: Button {
            text: "Reconnect";
            clicked => {
                reconnect-clicked();
            }
        }

        if connected: Button {
            text: "Land All";
            clicked => {
                land-swarm-clicked();
            }
        }

        if connected: Rectangle {
            width: estop-layout.preferred-width + 16px;
            height: 33px;
            background: #cc0000;
            border-radius: 4px;

            estop-layout := HorizontalLayout {
                alignment: center;
                padding-left: 8px;
                padding-right: 8px;

                Text {
                    text: "Emergency Stop";
                    color: white;
                    font-weight: 700;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { emergency-stop-clicked(); }
            }
        }

        Button {
            text: connected ? "Disconnect" : "Connect Swarm";
            clicked => {
                if (connected) {
                    disconnect-clicked();
                } else {
                    connect-clicked();
                }
            }
        }
    }
}

// Main application window
export component AppWindow inherits Window {
    title: "Swarmkeeper";
    preferred-width: 1600px;
    preferred-height: 900px;

    in-out property <string> swarm-name;
    in-out property <[UnitData]> units;
    in-out property <[[StandardListViewItem]]> unit-table-rows;
    in-out property <[UnitData]> sorted-units;
    in-out property <bool> swarm-connected;
    in-out property <int> connected-count;
    in-out property <int> selftest-passed-count;
    in-out property <int> battery-count;
    in-out property <int> charging-count;
    in-out property <int> charged-count;
    in-out property <int> sort-column: -1;
    in-out property <bool> sort-ascending: true;
    in-out property <image> viz-texture;
    in-out property <[JournalEntryData]> journal-entries;
    in-out property <[string]> console-lines;
    out property <float> viz-width: viz-content.viewport-width;
    out property <float> viz-height: viz-content.viewport-height;
    out property <float> cam-yaw: viz-content.cam-yaw;
    out property <float> cam-pitch: viz-content.cam-pitch;
    out property <float> cam-distance: viz-content.cam-distance;
    out property <float> cam-pan-x: viz-content.cam-pan-x;
    out property <float> cam-pan-y: viz-content.cam-pan-y;

    // Visualization label toggle states (read by Rust to know what to compute)
    out property <bool> show-cf-labels: viz-content.show-cf-labels;
    out property <bool> show-lh-labels: viz-content.show-lh-labels;
    out property <bool> show-loco-labels: viz-content.show-loco-labels;
    out property <bool> show-axis-labels: viz-content.show-axis-labels;
    out property <bool> show-grid-labels: viz-content.show-grid-labels;
    in-out property <string> viz-loaded-scene-name <=> viz-content.loaded-scene-name;
    in-out property <bool> viz-show-scene-overlay <=> viz-content.show-scene-overlay;
    callback viz-save-pads();
    callback viz-load-scene();

    // Visualization unit selection (sorted-units row index; -1 = none).
    // Set by Rust after hit-testing a left-click in the 3D view.
    in-out property <int> viz-selected-unit <=> viz-content.selected-unit;
    callback viz-unit-clicked(/* x */ float, /* y */ float);

    // Visualization label data (set by Rust)
    in-out property <[VizLabel]> cf-labels;
    in-out property <[VizLabel]> lh-labels;
    in-out property <[VizLabel]> loco-labels;
    in-out property <[VizLabel]> axis-labels;
    in-out property <[VizLabel]> grid-labels;

    // Positioning source selector
    in-out property <[string]> positioning-source-names;
    in-out property <int> positioning-source-index;
    callback positioning-source-changed(int);

    // Progress dialog (shared by TOC download and geometry upload)
    in-out property <bool> progress-dialog-visible;
    in-out property <float> progress-dialog-progress;
    in-out property <string> progress-dialog-status;
    in-out property <string> progress-dialog-title;

    // Generic error/alert dialog (e.g. trajectory geofence violation)
    in-out property <bool> error-dialog-visible: false;
    in-out property <string> error-dialog-title;
    in-out property <string> error-dialog-message;

    callback exit-requested();
    callback open-swarm-requested();
    callback arm-swarm();
    callback disarm-swarm();
    callback connect-swarm();
    callback disconnect-swarm();
    callback reconnect-swarm();
    callback download-toc();
    callback upload-geometry();
    callback upload-params();
    callback clear-tlv();
    callback upload-trajectory-swarm();
    callback fly-trajectory-swarm();
    callback land-swarm();
    callback sync-blink();
    callback delayed-sync-blink();
    callback emergency-stop();
    callback reboot-swarm();
    callback power-off-swarm();
    callback sysoff-swarm();
    callback syson-swarm();
    callback sort-units(/* column */ int, /* ascending */ bool);
    callback open-journal(/* row index */ int);
    callback add-journal-entry(/* row index */ int, /* text */ string);
    callback open-console(/* row index */ int);
    callback clear-console(/* row index */ int);
    callback clear-all-console();
    callback upload-trajectory(/* row index */ int);
    callback fly-trajectory(/* row index */ int);
    callback clear-trajectory(/* row index */ int);
    callback generate-primitive(/* row index */ int, /* shape */ string, /* size m */ string);
    callback generate-wave(/* row index */ int, /* x step m */ string, /* y amp m */ string, /* reps */ string, /* simultaneous */ bool, /* speed m/s */ string);
    callback hlc-takeoff(/* row index */ int, /* height */ string, /* yaw */ string, /* time */ string, /* relative */ bool);
    callback hlc-goto(/* row index */ int, /* x */ string, /* y */ string, /* z */ string, /* yaw */ string, /* relative */ bool, /* speed m/s */ string);
    callback hlc-go-home(/* row index */ int);
    callback hlc-land(/* row index */ int);
    callback random-goto(/* row index */ int);
    in-out property <string> unit-goto-x-text: "0";
    in-out property <string> unit-goto-y-text: "0";
    in-out property <string> unit-goto-z-text: "0";
    callback identify-unit(/* row index */ int);
    callback connect-unit(/* row index */ int);
    callback disconnect-unit(/* row index */ int);
    callback delete-journal-entry(/* row index */ int, /* entry index */ int);
    callback unit-row-selected(/* row index */ int);
    callback open-manual-control(/* row index */ int);
    callback start-manual-control(/* row index */ int, /* joystick index */ int);
    callback stop-manual-control(/* row index */ int);
    callback arm-unit(/* row index */ int, /* arm */ bool);
    callback recover-unit(/* row index */ int);
    callback reboot-unit(/* row index */ int);
    callback power-off-unit(/* row index */ int);
    callback sysoff-unit(/* row index */ int);
    callback syson-unit(/* row index */ int);
    callback clear-tlv-unit(/* row index */ int);

    // Tuning parameters
    in-out property <string> tuning-thrust-base;
    in-out property <string> tuning-vx-ki;
    in-out property <string> tuning-vy-ki;
    in-out property <string> tuning-prop-test-threshold;
    in-out property <string> tuning-prop-test-pwm-ratio;
    callback set-tuning-params(string, string, string, string, string);

    // Set swarm parameter
    in-out property <bool> set-param-dialog-visible: false;
    in-out property <[SwarmParamData]> swarm-params;       // filtered list shown in the picker
    in-out property <[SwarmParamData]> swarm-params-all;   // full intersection across connected units
    in-out property <int> set-param-unit-count;            // number of connected units
    in-out property <bool> set-param-loading;
    in-out property <string> set-param-search-text;
    in-out property <string> set-param-value-text;
    in-out property <string> set-param-selected-name;
    in-out property <string> set-param-selected-type;
    in-out property <bool> set-param-persist: false;       // also store to flash (EEPROM) so it survives reboot
    callback refresh-swarm-params();
    callback filter-swarm-params(/* search */ string);
    pure callback validate-param-value(/* type */ string, /* value */ string) -> string;
    callback set-swarm-param(/* name */ string, /* value */ string, /* persist */ bool);

    // Flash firmware (bootloader)
    in-out property <bool> flash-dialog-visible: false;
    in-out property <[string]> flash-target-names;
    in-out property <int> flash-selected-target: 0;
    in-out property <string> flash-binary-name;       // basename shown to the user
    in-out property <bool> flash-binary-selected: false;
    in-out property <bool> flashing: false;            // a flash run is in progress
    in-out property <string> flash-overall-status;
    callback flash-select-binary();
    callback flash-start();

    // Confirmation dialog
    private property <bool> confirm-power-off-visible: false;
    private property <bool> confirm-clear-tlv-visible: false;
    private property <bool> tuning-dialog-visible: false;

    // Radio test
    in-out property <[string]> radio-test-unit-names;
    in-out property <int> radio-test-selected-unit;
    in-out property <bool> radio-test-running;
    in-out property <float> radio-test-progress;
    in-out property <string> radio-test-status: "Ready";
    in-out property <[ChannelResult]> radio-test-results;
    callback run-radio-test(/* unit index */ int);

    // Loco anchor status (debug view)
    in-out property <[LocoAnchorStatus]> loco-anchors;
    in-out property <string> loco-mode-text: "Unknown";
    in-out property <int> loco-active-count;
    in-out property <int> loco-total-count;
    in-out property <string> loco-upload-status;
    in-out property <bool> loco-upload-active;
    callback load-anchor-positions();
    callback stop-anchor-upload();

    // LPS sniffer
    in-out property <[string]> sniffer-port-names;
    in-out property <int> sniffer-port-index;
    in-out property <bool> sniffer-connected;
    in-out property <string> sniffer-status: "Disconnected";
    in-out property <int> sniffer-total-packets;
    in-out property <float> sniffer-total-rate;
    in-out property <int> sniffer-wire-dropped;
    in-out property <int> sniffer-host-resyncs;
    in-out property <int> sniffer-air-lost;
    in-out property <[SnifferAnchorRow]> sniffer-anchor-rows;
    in-out property <[int]> sniffer-matrix-ids;
    in-out property <[SnifferMatrixRow]> sniffer-matrix-rows;
    in-out property <[SnifferSurveyRow]> sniffer-survey-rows;
    in-out property <string> sniffer-survey-status;
    in-out property <[SnifferFeedRow]> sniffer-feed-rows;
    in-out property <bool> sniffer-paused;
    in-out property <bool> sniffer-recording;
    in-out property <bool> sniffer-recording-active;
    in-out property <int> sniffer-rec-count;
    in-out property <string> sniffer-rec-path;
    callback sniffer-refresh-ports();
    callback sniffer-connect();
    callback sniffer-disconnect();
    callback sniffer-solve-survey();
    callback sniffer-save-survey();
    callback sniffer-set-paused(bool);
    callback sniffer-set-recording(bool);

    // Health test
    in-out property <bool> health-test-dialog-visible: false;
    in-out property <bool> health-test-running: false;
    in-out property <float> health-test-progress;
    in-out property <string> health-test-status;
    in-out property <[HealthTestResult]> health-test-results;
