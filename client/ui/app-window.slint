import { VerticalBox, HorizontalBox, TabWidget, Palette, Button, LineEdit, ScrollView, ComboBox, CheckBox } from "std-widgets.slint";
import { UnitsContent } from "units.slint";
import { VisualizationContent, VizLabel, UnitLabel, SceneTip, SceneLegend } from "visualization.slint";
import { UnitData, UnitState, JournalEntryData, ConsoleLineData } from "unit-card.slint";
import { RadioTestContent, ChannelResult } from "radio-test.slint";
import { LocoContent, LocoAnchorStatus } from "loco.slint";
import { LhBaseStationData } from "lh-coverage.slint";
import { Tdoa3AnchorData } from "tdoa3-coverage.slint";
import { LhWizardContent, WizardSampleData, WizardBsData } from "lh-wizard.slint";
import { PlanningContent, PlanObstacleData, PlanPadData, PlanBoxVolumeData, PlanCoverage } from "planning.slint";
import { SnifferContent, SnifferAnchorRow, SnifferFeedRow, SnifferMatrixRow, SnifferSurveyRow } from "sniffer.slint";
import { PlotBridge, PlotLine, AxisTick, LegendEntry, ChartData, PlotUnit, LogVarRow, PlotNewConfigDialog } from "plot.slint";
import { PlotScreen } from "plot-screen.slint";
import { FlashBridge, FlashDialog, FlashPart, FlashUnit, FlashCell, FlashStep, FlashPhase, FlashCard, FlashState } from "flash.slint";
import { ViewSettings } from "view-settings.slint";
import { RechannelBridge, RechannelDialog, RcLane, RcChip, RcMove, RcRowState } from "rechannel.slint";
import { OpenSwarmDialog, SignInDialog, SwarmChoice } from "open-swarm.slint";
import { Theme, Icons, Card, Segmented, ScreenTitle } from "kit.slint";
import { Rail, RailEntry, TopBar } from "shell.slint";
import { SwarmActionsButton } from "swarm-actions.slint";
import { Features } from "features.slint";
import { SettingsScreen, SettingsBridge } from "settings.slint";
import { UnitRow, SwarmSummary, FilterCounts, Health } from "units-table.slint";
import { StatusScreen, StatusData, HealthTile, GridCell, HistBar, Fact, AttentionRow, RadioRow, TrafficSeries, ServerRow, ActivityRow } from "status.slint";

// Re-export the plot globals/structs from the root so the Rust side can reach
// PlotBridge via `ui.global::<PlotBridge>()` and the generated data structs.
export { PlotBridge, PlotLine, AxisTick, LegendEntry, ChartData, PlotUnit, LogVarRow, FlashBridge, FlashPart, FlashUnit, FlashCell, FlashStep, FlashPhase, FlashCard, FlashState, ViewSettings, Theme, Features, SettingsBridge, UnitRow, SwarmSummary, FilterCounts, Health, StatusData, HealthTile, GridCell, HistBar, Fact, AttentionRow, RadioRow, TrafficSeries, ServerRow, ActivityRow }
export { RechannelBridge, RcLane, RcChip, RcMove, RcRowState }
export { SwarmChoice }

export struct HealthTestResult {
    name: string,
    status: string,
    m1-pass: bool,
    m2-pass: bool,
    m3-pass: bool,
    m4-pass: bool,
}

export struct SwarmParamData {
    name: string,
    type-name: string,
    writable: bool,
}

export component AppWindow inherits Window {
    // The screen shown, by rail id: status, units, view3d, planning,
    // lighthouse, loco, radio, settings.
    in-out property <string> screen: "status";
    // The section open on the Settings screen
    in-out property <int> settings-section: 0;

    // The Status screen, worked out in Rust (status.rs)
    in property <StatusData> status;
    // The account or the connection changed: Status shows them too.
    callback status-inputs-changed();
    // The chosen connection mode didn't work and Swarmkeeper fell back to direct.
    in property <bool> connection-problem;

    // The Units screen, worked out in Rust (units.rs)
    in property <[UnitRow]> unit-rows;
    in property <int> unit-visible-count;
    in property <SwarmSummary> swarm-summary;
    in property <FilterCounts> unit-filter-counts;
    in-out property <int> unit-filter;
    in-out property <string> unit-search;
    callback unit-filter-changed();

    background: Theme.ground;
    // The theme: the setting, or the desktop's scheme as it was at start.
    // The standard widgets (line edits, combo boxes) follow it too.
    property <bool> system-dark;
    property <int> theme-mode: Theme.mode;
    property <bool> theme-dark: Theme.dark;
    function apply-theme() {
        Theme.dark = Theme.mode == 2 || (Theme.mode == 0 && root.system-dark);
    }
    changed theme-mode => { root.apply-theme(); }
    changed theme-dark => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed signed-in => { root.status-inputs-changed(); }
    changed needs-sign-in => { root.status-inputs-changed(); }
    changed account-text => { root.status-inputs-changed(); }
    changed account-orgs => { root.status-inputs-changed(); }
    changed connection-label => { root.status-inputs-changed(); }
    changed connection-problem => { root.status-inputs-changed(); }
    changed drives-radios => { root.status-inputs-changed(); }
    init => {
        root.system-dark = Palette.color-scheme == ColorScheme.dark;
        root.apply-theme();
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    title: "Swarmkeeper";
    preferred-width: 1600px;
    preferred-height: 900px;

    in-out property <string> swarm-name;
    in-out property <[UnitData]> units;
    in-out property <[UnitData]> sorted-units;
    in-out property <bool> swarm-connected;
    in-out property <int> connected-count;
    in-out property <int> selftest-passed-count;
    in-out property <int> battery-count;
    in-out property <int> charging-count;
    in-out property <int> charged-count;
    in-out property <int> sort-column <=> ViewSettings.sort-column;
    in-out property <bool> sort-ascending <=> ViewSettings.sort-ascending;
    in-out property <image> viz-texture;
    in-out property <[JournalEntryData]> journal-entries;
    in-out property <[ConsoleLineData]> console-lines;
    in-out property <string> assert-text;
    in-out property <bool> assert-busy;
    out property <float> viz-width: viz-content.viewport-width;
    out property <float> viz-height: viz-content.viewport-height;
    out property <float> cam-yaw: viz-content.cam-yaw;
    out property <float> cam-pitch: viz-content.cam-pitch;
    out property <float> cam-distance: viz-content.cam-distance;
    out property <float> cam-pan-x: viz-content.cam-pan-x;
    out property <float> cam-pan-y: viz-content.cam-pan-y;

    // Visualization label toggle states (read by Rust to know what to compute)
    out property <bool> show-lh-labels: viz-content.show-lh-labels;
    out property <bool> show-loco-labels: viz-content.show-loco-labels;
    out property <bool> show-axis-labels: viz-content.show-axis-labels;
    out property <bool> show-grid-labels: viz-content.show-grid-labels;
    in-out property <string> viz-loaded-scene-name <=> viz-content.loaded-scene-name;
    in-out property <bool> viz-show-scene-overlay <=> viz-content.show-scene-overlay;
    callback viz-save-pads();
    callback viz-load-scene();

    // Unit selection shared by the Visualization and Units tabs (sorted-units
    // row index; -1 = none). Set by Rust after hit-testing a left-click in the
    // 3D view, and by either tab's own selection UI.
    in-out property <int> viz-selected-unit <=> ViewSettings.selected-unit;
    callback viz-unit-clicked(/* x */ float, /* y */ float);

    // Visualization label data (set by Rust)
    in-out property <[UnitLabel]> unit-labels;
    in-out property <SceneTip> viz-tip;
    in-out property <SceneLegend> viz-legend;
    // The unit under the pointer in the 3D view (sorted-units row, -1 none)
    in-out property <int> viz-hover-unit: -1;
    callback viz-hover(/* x */ float, /* y */ float);
    callback viz-fit();
    in-out property <[VizLabel]> lh-labels;
    in-out property <[VizLabel]> loco-labels;
    in-out property <[VizLabel]> axis-labels;
    in-out property <[VizLabel]> grid-labels;

    // Positioning source selector
    in-out property <[string]> positioning-source-names;
    in-out property <int> positioning-source-index;
    callback positioning-source-changed(int);

    // Progress dialog (shared by TOC download and geometry upload)
    in-out property <bool> progress-dialog-visible;
    in-out property <float> progress-dialog-progress;
    in-out property <string> progress-dialog-status;
    in-out property <string> progress-dialog-title;

    // Generic error/alert dialog (e.g. trajectory geofence violation)
    in-out property <bool> error-dialog-visible: false;
    in-out property <string> error-dialog-title;
    in-out property <string> error-dialog-message;

    callback exit-requested();
    callback open-swarm-requested();
    callback arm-swarm();
    callback disarm-swarm();
    callback connect-swarm();
    callback disconnect-swarm();
    callback reconnect-swarm();
    callback download-toc();
    callback upload-geometry();
    callback upload-params();
    callback clear-tlv();
    callback upload-trajectory-swarm();
    callback fly-trajectory-swarm();
    callback land-swarm();
    callback sync-blink();
    callback delayed-sync-blink();
    callback emergency-stop();
    callback reboot-swarm();
    callback power-off-swarm();
    callback sysoff-swarm();
    callback syson-swarm();
    callback sort-units(/* column */ int, /* ascending */ bool);
    callback open-journal(/* row index */ int);
    callback add-journal-entry(/* row index */ int, /* text */ string);
    callback open-console(/* row index */ int);
    callback clear-console(/* row index */ int);
    callback clear-all-console();
    callback read-assert(/* row index */ int);
    callback upload-trajectory(/* row index */ int);
    callback download-trajectory(/* row index */ int);
    callback fly-trajectory(/* row index */ int);
    callback clear-trajectory(/* row index */ int);
    callback generate-primitive(/* row index */ int, /* shape */ string, /* size m */ string, /* size y m */ string, /* z offset m */ string, /* z iterations */ string);
    callback generate-wave(/* row index */ int, /* x step m */ string, /* y amp m */ string, /* reps */ string, /* simultaneous */ bool, /* speed m/s */ string, /* z offset m */ string, /* z iterations */ string);
    callback hlc-takeoff(/* row index */ int, /* height */ string, /* yaw */ string, /* time */ string, /* relative */ bool);
    callback hlc-goto(/* row index */ int, /* x */ string, /* y */ string, /* z */ string, /* yaw */ string, /* relative */ bool, /* speed m/s */ string);
    callback hlc-go-home(/* row index */ int);
    callback hlc-land(/* row index */ int);
    callback random-goto(/* row index */ int);
    in-out property <string> unit-goto-x-text <=> ViewSettings.goto-x;
    in-out property <string> unit-goto-y-text <=> ViewSettings.goto-y;
    in-out property <string> unit-goto-z-text <=> ViewSettings.goto-z;
    callback identify-unit(/* row index */ int);
    callback connect-unit(/* row index */ int);
    callback disconnect-unit(/* row index */ int);
    callback delete-journal-entry(/* row index */ int, /* entry index */ int);
    callback unit-row-selected(/* row index */ int);
    callback open-manual-control(/* row index */ int);
    callback start-manual-control(/* row index */ int, /* joystick index */ int);
    callback stop-manual-control(/* row index */ int);
    callback arm-unit(/* row index */ int, /* arm */ bool);
    callback recover-unit(/* row index */ int);
    callback reboot-unit(/* row index */ int);
    callback power-off-unit(/* row index */ int);
    callback sysoff-unit(/* row index */ int);
    callback syson-unit(/* row index */ int);
    callback clear-tlv-unit(/* row index */ int);

    // Tuning parameters
    in-out property <string> tuning-thrust-base;
    in-out property <string> tuning-vx-ki;
    in-out property <string> tuning-vy-ki;
    in-out property <string> tuning-prop-test-threshold;
    in-out property <string> tuning-prop-test-pwm-ratio;
    callback set-tuning-params(string, string, string, string, string);

    // Set swarm parameter
    in-out property <bool> set-param-dialog-visible: false;
    in-out property <[SwarmParamData]> swarm-params;       // filtered list shown in the picker
    in-out property <[SwarmParamData]> swarm-params-all;   // full intersection across connected units
    in-out property <int> set-param-unit-count;            // number of connected units
    in-out property <bool> set-param-loading;
    in-out property <string> set-param-search-text;
    in-out property <string> set-param-value-text;
    in-out property <string> set-param-selected-name;
    in-out property <string> set-param-selected-type;
    in-out property <bool> set-param-persist: false;       // also store to flash (EEPROM) so it survives reboot
    callback refresh-swarm-params();
    callback filter-swarm-params(/* search */ string);
    pure callback validate-param-value(/* type */ string, /* value */ string) -> string;
    callback set-swarm-param(/* name */ string, /* value */ string, /* persist */ bool);

    // File > Open swarm: the swarm files on this computer and the shared swarms
    in-out property <bool> os-dialog-visible: false;
    in-out property <[SwarmChoice]> os-local;
    in-out property <[SwarmChoice]> os-shared;
    in-out property <string> os-shared-title: "Shared";
    in-out property <string> os-shared-note;
    in-out property <bool> os-busy: false;
    in-out property <string> os-error;
    in-out property <string> os-selected-id;
    in-out property <bool> os-selected-shared;
    callback os-show();                                // list the swarms
    callback os-open(/* id */ string, /* shared */ bool);

    // Where the open swarm is from, and a newer revision of a shared one
    in-out property <string> swarm-source;
    in-out property <string> swarm-update;
    callback reload-swarm();

    // How the Crazyflies are reached, see MenuBar
    in-out property <string> connection-label;
    in-out property <string> connection-text;
    in-out property <string> connection-mode: "auto";
    // Swarmkeeper drives this computer's Crazyradios (shared or direct mode):
    // the features that send raw radio packets need it
    in-out property <bool> drives-radios: true;
    // Connection servers used before, the last one first (settings.rs)
    in-out property <[string]> recent-servers;
    callback connection-chosen(string);
    callback connection-opened();
    callback forget-server(string);

    // The account on the server that shares swarms
    in-out property <string> account-label: "Sign in";
    // The initials of the name signed in, and the picture from GitHub or
    // Google, for the avatar
    in-out property <string> account-initials;
    in-out property <image> account-picture;
    in-out property <string> account-text;
    // The organizations the account is in, by name, for Status.
    in-out property <string> account-orgs;
    in-out property <bool> signed-in: false;
    in-out property <bool> needs-sign-in: true;
    in-out property <bool> sign-in-dialog-visible: false;
    in-out property <string> sign-in-server;
    in-out property <bool> sign-in-waiting: false;
    in-out property <string> sign-in-link;
    in-out property <string> sign-in-error;
    callback sign-in(/* server */ string);
    callback sign-in-open-link();
    callback sign-in-cancel();
    callback sign-out();

    // Confirmation dialog
    private property <bool> confirm-power-off-visible: false;
    private property <bool> confirm-clear-tlv-visible: false;
    private property <bool> tuning-dialog-visible: false;

    // Radio test
    in-out property <[string]> radio-test-unit-names;
    in-out property <int> radio-test-selected-unit;
    in-out property <bool> radio-test-running;
    in-out property <float> radio-test-progress;
    in-out property <string> radio-test-status: "Ready";
    in-out property <[ChannelResult]> radio-test-results;
    callback run-radio-test(/* unit index */ int);

    // Loco anchor status (debug view)
    in-out property <[LocoAnchorStatus]> loco-anchors;
    in-out property <string> loco-mode-text: "Unknown";
    in-out property <int> loco-active-count;
    in-out property <int> loco-total-count;
    in-out property <string> loco-upload-status;
    in-out property <bool> loco-upload-active;
    callback load-anchor-positions();
    callback stop-anchor-upload();

    // LPS sniffer
    in-out property <[string]> sniffer-port-names;
    in-out property <int> sniffer-port-index;
    in-out property <bool> sniffer-connected;
    in-out property <string> sniffer-status: "Disconnected";
    in-out property <int> sniffer-total-packets;
    in-out property <float> sniffer-total-rate;
    in-out property <int> sniffer-wire-dropped;
    in-out property <int> sniffer-host-resyncs;
    in-out property <int> sniffer-air-lost;
    in-out property <[SnifferAnchorRow]> sniffer-anchor-rows;
    in-out property <[int]> sniffer-matrix-ids;
    in-out property <[SnifferMatrixRow]> sniffer-matrix-rows;
    in-out property <[SnifferSurveyRow]> sniffer-survey-rows;
    in-out property <string> sniffer-survey-status;
    in-out property <[SnifferFeedRow]> sniffer-feed-rows;
    in-out property <bool> sniffer-paused;
    in-out property <bool> sniffer-recording;
    in-out property <bool> sniffer-recording-active;
    in-out property <int> sniffer-rec-count;
    in-out property <string> sniffer-rec-path;
    callback sniffer-refresh-ports();
    callback sniffer-connect();
    callback sniffer-disconnect();
    in-out property <string> sniffer-ref-status;
    callback sniffer-solve-survey();
    callback sniffer-save-survey();
    callback sniffer-set-paused(bool);
    callback sniffer-set-recording(bool);

    // Health test
    in-out property <bool> health-test-dialog-visible: false;
    in-out property <bool> health-test-running: false;
    in-out property <float> health-test-progress;
    in-out property <string> health-test-status;
    in-out property <[HealthTestResult]> health-test-results;
    callback run-health-test();

    // Joystick manual control
    in-out property <[string]> joystick-names;
    in-out property <float> stick-lx;
    in-out property <float> stick-ly;
    in-out property <float> stick-rx;
    in-out property <float> stick-ry;
    in-out property <bool> manual-control-armed;

    // LH Coverage — standalone tab removed (folded into Planning). Properties kept
    // as plain storage so the (now inert) legacy Rust handlers still resolve.
    in-out property <image> lh-coverage-texture;
    out property <float> lh-coverage-width;
    out property <float> lh-coverage-height;
    out property <float> lh-cov-cam-yaw;
    out property <float> lh-cov-cam-pitch;
    out property <float> lh-cov-cam-distance;
    in-out property <float> lh-cov-cam-pan-x;
    in-out property <float> lh-cov-cam-pan-y;
    in-out property <string> lh-cov-room-x;
    in-out property <string> lh-cov-room-y;
    in-out property <string> lh-cov-room-z;
    in-out property <string> lh-cov-resolution;
    in-out property <[LhBaseStationData]> lh-cov-base-stations;
    in-out property <bool> lh-cov-show-coverage-0;
    in-out property <bool> lh-cov-show-coverage-1;
    in-out property <bool> lh-cov-show-coverage-2;
    in-out property <bool> lh-cov-show-coverage-3;
    in-out property <bool> lh-cov-show-coverage-4;
    in-out property <bool> lh-cov-receiver-fov-enabled;
    in-out property <bool> lh-cov-tilt-compensation-enabled;
    in-out property <string> lh-cov-max-tilt-angle;
    in-out property <string> lh-cov-max-bs-distance;
    in-out property <bool> lh-cov-center-origin;
    in-out property <string> lh-cov-room-offset-x;
    in-out property <string> lh-cov-room-offset-y;
    in-out property <string> lh-cov-room-offset-z;
    in-out property <int> lh-cov-selected-bs: -1;
    in-out property <bool> lh-cov-handle-active: false;
    in-out property <int> lh-cov-active-handle: 0;
    in-out property <[VizLabel]> lh-cov-grid-labels;
    in-out property <string> lh-cov-coverage-1-text;
    in-out property <string> lh-cov-coverage-2-text;
    in-out property <string> lh-cov-trajectories-status;
    in-out property <bool> lh-cov-show-trajectories;
    in-out property <string> lh-cov-traj-offset-x;
    in-out property <string> lh-cov-traj-offset-y;
    in-out property <string> lh-cov-traj-offset-z;
    callback lh-cov-load-geometry();
    callback lh-cov-save-scene();
    callback lh-cov-load-scene();
    callback lh-cov-add-bs();
    callback lh-cov-undo();
    callback lh-cov-remove-bs(int);
    callback lh-cov-update-bs(int, LhBaseStationData);
    callback lh-cov-recompute();
    callback lh-cov-load-trajectories();
    callback lh-cov-view-mouse-pressed(float, float);
    callback lh-cov-view-mouse-moved(float, float);
    callback lh-cov-view-mouse-released();
    callback lh-cov-view-pan(float, float);

    // LH Wizard
    in-out property <image> lh-wizard-texture;
    out property <float> lh-wizard-width: lh-wizard-content.viewport-width;
    out property <float> lh-wizard-height: lh-wizard-content.viewport-height;
    out property <float> lh-wizard-cam-yaw: lh-wizard-content.cam-yaw;
    out property <float> lh-wizard-cam-pitch: lh-wizard-content.cam-pitch;
    out property <float> lh-wizard-cam-distance: lh-wizard-content.cam-distance;
    in-out property <float> lh-wizard-cam-pan-x <=> lh-wizard-content.cam-pan-x;
    in-out property <float> lh-wizard-cam-pan-y <=> lh-wizard-content.cam-pan-y;
    in-out property <int> lh-wizard-current-step <=> lh-wizard-content.current-step;
    in-out property <string> lh-wizard-step-instructions <=> lh-wizard-content.step-instructions;
    in-out property <string> lh-wizard-measure-button-text <=> lh-wizard-content.measure-button-text;
    in-out property <bool> lh-wizard-measure-enabled <=> lh-wizard-content.measure-enabled;
    in-out property <bool> lh-wizard-measuring <=> lh-wizard-content.measuring;
    in-out property <[string]> lh-wizard-cf-names <=> lh-wizard-content.cf-names;
    in-out property <int> lh-wizard-selected-cf <=> lh-wizard-content.selected-cf;
    in-out property <string> lh-wizard-origin-status <=> lh-wizard-content.origin-status;
    in-out property <bool> lh-wizard-origin-ok <=> lh-wizard-content.origin-ok;
    in-out property <string> lh-wizard-x-axis-status <=> lh-wizard-content.x-axis-status;
    in-out property <bool> lh-wizard-x-axis-ok <=> lh-wizard-content.x-axis-ok;
    in-out property <string> lh-wizard-xy-plane-status <=> lh-wizard-content.xy-plane-status;
    in-out property <bool> lh-wizard-xy-plane-ok <=> lh-wizard-content.xy-plane-ok;
    in-out property <string> lh-wizard-progress-info <=> lh-wizard-content.progress-info;
    in-out property <bool> lh-wizard-has-converged <=> lh-wizard-content.has-converged;
    in-out property <string> lh-wizard-error-mean <=> lh-wizard-content.error-mean;
    in-out property <string> lh-wizard-error-max <=> lh-wizard-content.error-max;
    in-out property <int> lh-wizard-xy-plane-count <=> lh-wizard-content.xy-plane-count;
    in-out property <int> lh-wizard-xyz-space-count <=> lh-wizard-content.xyz-space-count;
    in-out property <int> lh-wizard-verification-count <=> lh-wizard-content.verification-count;
    in-out property <string> lh-wizard-notification-text <=> lh-wizard-content.notification-text;
    in-out property <color> lh-wizard-notification-color <=> lh-wizard-content.notification-color;
    in-out property <[WizardSampleData]> lh-wizard-sample-details <=> lh-wizard-content.sample-details;
    in-out property <[WizardBsData]> lh-wizard-bs-details <=> lh-wizard-content.bs-details;
    in-out property <[VizLabel]> lh-wizard-grid-labels;
    callback lh-wizard-measure();
    callback lh-wizard-step-next();
    callback lh-wizard-step-prev();
    callback lh-wizard-clear();
    callback lh-wizard-import();
    callback lh-wizard-export();
    callback lh-wizard-upload();
    callback lh-wizard-select-cf(int);
    callback lh-wizard-view-mouse-pressed(float, float);
    callback lh-wizard-view-mouse-moved(float, float);
    callback lh-wizard-view-mouse-released();
    callback lh-wizard-view-pan(float, float);

    // TDoA3 Coverage — standalone tab removed (folded into Planning). Properties kept
    // as plain storage so the (now inert) legacy Rust handlers still resolve.
    in-out property <image> tdoa3-texture;
    out property <float> tdoa3-width;
    out property <float> tdoa3-height;
    out property <float> tdoa3-cam-yaw;
    out property <float> tdoa3-cam-pitch;
    out property <float> tdoa3-cam-distance;
    in-out property <float> tdoa3-cam-pan-x;
    in-out property <float> tdoa3-cam-pan-y;
    in-out property <string> tdoa3-room-x;
    in-out property <string> tdoa3-room-y;
    in-out property <string> tdoa3-room-z;
    in-out property <string> tdoa3-resolution;
    in-out property <[Tdoa3AnchorData]> tdoa3-anchors;
    in-out property <string> tdoa3-max-range;
    in-out property <float> tdoa3-scale-min-value;
    in-out property <float> tdoa3-scale-max-value;
    in-out property <float> tdoa3-scale-limit;
    in-out property <bool> tdoa3-show-outside-hull;
    in-out property <bool> tdoa3-center-origin;
    in-out property <int> tdoa3-metric-index;
    in-out property <string> tdoa3-pair-a;
    in-out property <string> tdoa3-pair-b;
    in-out property <string> tdoa3-measurement-noise;
    callback tdoa3-metric-changed(int);
    callback tdoa3-pair-changed();
    in-out property <int> tdoa3-selected-anchor: -1;
    in-out property <bool> tdoa3-handle-active: false;
    in-out property <int> tdoa3-active-handle: 0;
    in-out property <[VizLabel]> tdoa3-grid-labels;
    in-out property <string> tdoa3-stats-text-1;
    in-out property <string> tdoa3-stats-text-2;
    in-out property <string> tdoa3-stats-text-3;
    callback tdoa3-save-scene();
    callback tdoa3-load-scene();
    callback tdoa3-add-anchor();
    callback tdoa3-undo();
    callback tdoa3-remove-anchor(int);
    callback tdoa3-update-anchor(int, Tdoa3AnchorData);
    callback tdoa3-recompute();
    callback tdoa3-view-mouse-pressed(float, float);
    callback tdoa3-view-mouse-moved(float, float);
    callback tdoa3-view-mouse-released();
    callback tdoa3-view-pan(float, float);

    // Planning
    in-out property <image> planning-texture;
    out property <float> planning-width: planning-content.viewport-width;
    out property <float> planning-height: planning-content.viewport-height;
    out property <float> planning-cam-yaw: planning-content.cam-yaw;
    out property <float> planning-cam-pitch: planning-content.cam-pitch;
    out property <float> planning-cam-distance: planning-content.cam-distance;
    in-out property <float> planning-cam-pan-x <=> planning-content.cam-pan-x;
    in-out property <float> planning-cam-pan-y <=> planning-content.cam-pan-y;
    in-out property <string> planning-room-x <=> planning-content.room-x;
    in-out property <string> planning-room-y <=> planning-content.room-y;
    in-out property <string> planning-room-z <=> planning-content.room-z;
    in-out property <string> planning-resolution <=> planning-content.resolution;
    in-out property <bool> planning-center-origin <=> planning-content.center-origin;
    in-out property <string> planning-room-offset-x <=> planning-content.room-offset-x;
    in-out property <string> planning-room-offset-y <=> planning-content.room-offset-y;
    in-out property <string> planning-room-offset-z <=> planning-content.room-offset-z;
    in-out property <[LhBaseStationData]> planning-base-stations;
    in-out property <[Tdoa3AnchorData]> planning-anchors;
    in-out property <[PlanObstacleData]> planning-obstacles;
    in-out property <bool> planning-receiver-fov-enabled <=> planning-content.receiver-fov-enabled;
    in-out property <string> planning-max-bs-distance <=> planning-content.max-bs-distance;
    in-out property <bool> planning-show-coverage-0 <=> planning-content.show-coverage-0;
    in-out property <bool> planning-show-coverage-1 <=> planning-content.show-coverage-1;
    in-out property <bool> planning-show-coverage-2 <=> planning-content.show-coverage-2;
    in-out property <bool> planning-show-coverage-3 <=> planning-content.show-coverage-3;
    in-out property <bool> planning-show-coverage-4 <=> planning-content.show-coverage-4;
    in-out property <string> planning-max-range <=> planning-content.max-range;
    in-out property <[PlanBoxVolumeData]> planning-flight-areas;
    in-out property <[PlanBoxVolumeData]> planning-waypoint-areas;
    in-out property <int> planning-selected-area-kind <=> planning-content.selected-area-kind;
    in-out property <int> planning-selected-area-index <=> planning-content.selected-area-index;
    in-out property <[PlanPadData]> planning-takeoff-pads <=> planning-content.takeoff-pads;
    in-out property <float> planning-tdoa3-scale-min <=> planning-content.tdoa3-scale-min;
    in-out property <float> planning-tdoa3-scale-max <=> planning-content.tdoa3-scale-max;
    in-out property <float> planning-tdoa3-scale-limit <=> planning-content.tdoa3-scale-limit;
    in-out property <bool> planning-show-tdoa3-voxels <=> planning-content.show-tdoa3-voxels;
    in-out property <string> planning-measurement-noise <=> planning-content.measurement-noise;
    in-out property <int> planning-error-metric-index <=> planning-content.error-metric-index;
    callback planning-error-metric-changed(int);
    in-out property <string> planning-pair-a <=> planning-content.pair-a;
    in-out property <string> planning-pair-b <=> planning-content.pair-b;
    in-out property <bool> planning-show-outside-hull <=> planning-content.show-outside-hull;
    in-out property <bool> planning-tilt-compensation-enabled <=> planning-content.tilt-compensation-enabled;
    in-out property <string> planning-max-tilt-angle <=> planning-content.max-tilt-angle;
    in-out property <bool> planning-show-trajectories <=> planning-content.show-trajectories;
    in-out property <string> planning-trajectories-status;
    in-out property <string> planning-traj-offset-x <=> planning-content.traj-offset-x;
    in-out property <string> planning-traj-offset-y <=> planning-content.traj-offset-y;
    in-out property <string> planning-traj-offset-z <=> planning-content.traj-offset-z;
    callback planning-load-geometry();
    callback planning-load-trajectories();
    in-out property <int> planning-selected-type: 0;
    in-out property <int> planning-selected-index: -1;
    in-out property <bool> planning-handle-active: false;
    in-out property <int> planning-active-handle: 0;
    in-out property <[VizLabel]> planning-grid-labels;
    // Base stations and anchors by name, over the view
    in-out property <[UnitLabel]> planning-marks;
    in-out property <string> planning-scene-name <=> planning-content.scene-name;
    in-out property <bool> planning-scene-dirty <=> planning-content.scene-dirty;
    in-out property <int> planning-undo-count <=> planning-content.undo-count;
    in-out property <PlanCoverage> planning-coverage <=> planning-content.coverage;
    in-out property <bool> planning-coverage-stale <=> planning-content.coverage-stale;
    in-out property <bool> planning-show-slice <=> planning-content.show-slice;
    in-out property <float> planning-slice-z <=> planning-content.slice-z;
    in-out property <int> planning-coverage-source <=> planning-content.coverage-source;
    callback planning-select(int, int);
    callback planning-save-scene-as();
    in-out property <string> planning-stats-text-1;
    in-out property <string> planning-stats-text-2;
    in-out property <string> planning-stats-text-3;
    in-out property <bool> planning-computing: false;
    callback planning-save-scene();
    callback planning-load-scene();
    callback planning-load-lh-scene();
    callback planning-load-tdoa3-scene();
    callback planning-add-bs();
    callback planning-remove-bs(int);
    callback planning-duplicate-bs(int);
    callback planning-update-bs(int, LhBaseStationData);
    callback planning-add-anchor();
    callback planning-remove-anchor(int);
    callback planning-duplicate-anchor(int);
    callback planning-update-anchor(int, Tdoa3AnchorData);
    callback planning-add-box();
    callback planning-add-cylinder();
    callback planning-remove-obstacle(int);
    callback planning-duplicate-obstacle(int);
    callback planning-update-obstacle(int, PlanObstacleData);
    callback planning-add-flight-area();
    callback planning-remove-flight-area(int);
    callback planning-update-flight-area(int, PlanBoxVolumeData);
    callback planning-select-flight-area(int);
    callback planning-add-waypoint-area();
    callback planning-remove-waypoint-area(int);
    callback planning-update-waypoint-area(int, PlanBoxVolumeData);
    callback planning-select-waypoint-area(int);
    callback planning-undo();
    callback planning-recompute();
    callback planning-view-mouse-pressed(float, float);
    callback planning-view-mouse-moved(float, float);
    callback planning-view-mouse-released();
    callback planning-view-pan(float, float);

    HorizontalLayout {
        spacing: 0px;

        Rail {
            current <=> root.screen;
            entries: [
                { id: "status", label: "Status", icon: Icons.status, shown: true },
                { id: "units", label: "Units", icon: Icons.units, shown: true },
                { id: "view3d", label: "3D view", icon: Icons.view3d, shown: true },
                { id: "plot", label: "Plot", icon: Icons.plot, shown: true },
                { id: "planning", label: "Planning", icon: Icons.planning, shown: Features.planning },
                { id: "lighthouse", label: "Lighthouse", icon: Icons.lighthouse, shown: Features.lighthouse },
                { id: "loco", label: "Loco", icon: Icons.loco, shown: Features.loco },
                { id: "radio", label: "Radio", icon: Icons.radio, shown: Features.radio },
            ];
            settings-entry: { id: "settings", label: "Settings", icon: Icons.settings, shown: true };
        }

        VerticalLayout {
            spacing: 0px;

            TopBar {
                swarm-name: root.swarm-name;
                swarm-source: root.swarm-source;
                swarm-update: root.swarm-update;
                unit-count: root.units.length;
                open-swarm => {
                    os-error = "";
                    os-busy = false;
                    os-dialog-visible = true;
                    os-show();
                }
                reload => { reload-swarm(); }
                connected: root.swarm-connected;
                connected-count: root.connected-count;
                drives-radios: root.drives-radios;
                connection-label: root.connection-label;
                connection-text: root.connection-text;
                connection-mode: root.connection-mode;
                recent-servers: root.recent-servers;
                connection-chosen(mode) => { root.connection-chosen(mode); }
                connection-opened => { root.connection-opened(); }
                account-name: root.account-label;
                account-initials: root.account-initials;
                account-picture: root.account-picture;
                signed-in: root.signed-in;
                needs-sign-in: root.needs-sign-in;
                sign-in => {
                    sign-in-error = "";
                    sign-in-dialog-visible = true;
                }
                sign-out => { sign-out(); }
                account-settings => {
                    root.settings-section = 2;
                    root.screen = "settings";
                }
                connect => { connect-swarm(); }
                disconnect => { disconnect-swarm(); }
                reconnect => { reconnect-swarm(); }
                land-all => { land-swarm(); }
                emergency-stop => { emergency-stop(); }

                SwarmActionsButton {
                    y: (parent.height - self.height) / 2;
                    connected: root.swarm-connected;
                    drives-radios: root.drives-radios;
                    arm-all => { arm-swarm(); }
                    disarm-all => { disarm-swarm(); }
                    upload-trajectory => { upload-trajectory-swarm(); }
                    fly-trajectory => { fly-trajectory-swarm(); }
                    land-all => { land-swarm(); }
                    sync-blink => { sync-blink(); }
                    delayed-sync-blink => { delayed-sync-blink(); }
                    health-test => {
                        health-test-dialog-visible = true;
                        run-health-test();
                    }
                    download-toc => { download-toc(); }
                    clear-consoles => { clear-all-console(); }
                    reboot => { reboot-swarm(); }
                    sleep => { sysoff-swarm(); }
                    wake-up => { syson-swarm(); }
                    power-off => { confirm-power-off-visible = true; }
                    flash-firmware => {
                        FlashBridge.visible = true;
                        FlashBridge.opened();
                    }
                    clear-tlv => { confirm-clear-tlv-visible = true; }
                    rechannel => {
                        RechannelBridge.visible = true;
                        RechannelBridge.opened();
                    }
                    upload-geometry => { upload-geometry(); }
                    upload-params => { upload-params(); }
                    set-parameter => {
                        set-param-selected-name = "";
                        set-param-selected-type = "";
                        set-param-search-text = "";
                        set-param-value-text = "";
                        set-param-persist = false;
                        swarm-params = [];
                        swarm-params-all = [];
                        set-param-loading = true;
                        set-param-dialog-visible = true;
                        refresh-swarm-params();
                    }
                    tuning => { tuning-dialog-visible = true; }
                }
            }

            screens := Rectangle {
                vertical-stretch: 1;
                // Each screen fills this; none of them sizes the window.
                min-width: 0px;
                max-width: 100000px;
                min-height: 0px;
                max-height: 100000px;
                background: Theme.ground;

                StatusScreen {
                    visible: root.screen == "status";
                    data: root.status;
                    connected: root.swarm-connected;
                    navigate(screen) => { root.screen = screen; }
                    show-issues => {
                        root.unit-filter = 3;
                        root.unit-filter-changed();
                        root.screen = "units";
                    }
                    open-unit(row) => {
                        ViewSettings.selected-unit = row;
                        root.unit-row-selected(row);
                        root.screen = "units";
                    }
                    connect-unit(row) => { root.connect-unit(row); }
                    recover-unit(row) => { root.recover-unit(row); }
                    flash => {
                        FlashBridge.visible = true;
                        FlashBridge.opened();
                    }
                }

                PlotScreen {
                    visible: root.screen == "plot";
                }

                SettingsScreen {
                    visible: root.screen == "settings";
                    section <=> root.settings-section;
                    connection-mode: root.connection-mode;
                    connection-text: root.connection-text;
                    recent-servers: root.recent-servers;
                    connection-chosen(mode) => { root.connection-chosen(mode); }
                    forget-server(server) => { root.forget-server(server); }
                    account-name: root.account-label;
                    account-initials: root.account-initials;
                    account-picture: root.account-picture;
                    signed-in: root.signed-in;
                    needs-sign-in: root.needs-sign-in;
                    account-text: root.account-text;
                    sign-in => {
                        sign-in-error = "";
                        sign-in-dialog-visible = true;
                    }
                    sign-out => { sign-out(); }
                    clear-consoles => { clear-all-console(); }
                }

                // Units
                VerticalLayout {
                    visible: root.screen == "units";
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 24px;
                    spacing: 16px;

                    ScreenTitle {
                        text: "Units";
                        note: root.connected-count + " of " + root.units.length + " connected";
                    }

                    units-content := UnitsContent {
                        plot-shown: root.screen == "units";
                        vertical-stretch: 1;
                        unit-rows: root.unit-rows;
                        visible-count: root.unit-visible-count;
                        summary: root.swarm-summary;
                        counts: root.unit-filter-counts;
                        filter <=> root.unit-filter;
                        search <=> root.unit-search;
                        filter-changed => { root.unit-filter-changed(); }
                        units: root.units;
                        sorted-units: root.sorted-units;
                        sort-column: root.sort-column;
                        sort-ascending: root.sort-ascending;
                        journal-entries: root.journal-entries;
                        console-lines: root.console-lines;
                        assert-text: root.assert-text;
                        assert-busy: root.assert-busy;
                        sort-requested(col, ascending) => { sort-units(col, ascending); }
                        open-journal-requested(row) => { open-journal(row); }
                        add-journal-entry-requested(row, text) => { add-journal-entry(row, text); }
                        open-console-requested(row) => { open-console(row); }
                        clear-console-requested(row) => { clear-console(row); }
                        clear-all-console-requested() => { clear-all-console(); }
                        read-assert-requested(row) => { read-assert(row); }
                        upload-trajectory-requested(row) => { upload-trajectory(row); }
                        download-trajectory-requested(row) => { download-trajectory(row); }
                        fly-trajectory-requested(row) => { fly-trajectory(row); }
                        clear-trajectory-requested(row) => { clear-trajectory(row); }
                        generate-primitive-requested(row, shape, size, sizey, zoff, ziter) => { generate-primitive(row, shape, size, sizey, zoff, ziter); }
                        generate-wave-requested(row, x, y, reps, sim, speed, zoff, ziter) => { generate-wave(row, x, y, reps, sim, speed, zoff, ziter); }
                        takeoff-requested(row, height, yaw, time, relative) => { hlc-takeoff(row, height, yaw, time, relative); }
                        goto-requested(row, x, y, z, yaw, relative, speed) => { hlc-goto(row, x, y, z, yaw, relative, speed); }
                        random-goto-requested(row) => { random-goto(row); }
                        go-home-requested(row) => { hlc-go-home(row); }
                        land-requested(row) => { hlc-land(row); }
                        identify-requested(row) => { identify-unit(row); }
                        delete-journal-entry-requested(row, entry-idx) => { delete-journal-entry(row, entry-idx); }
                        row-selected(row) => { unit-row-selected(row); }
                        joystick-names: root.joystick-names;
                        stick-lx: root.stick-lx;
                        stick-ly: root.stick-ly;
                        stick-rx: root.stick-rx;
                        stick-ry: root.stick-ry;
                        manual-control-armed: root.manual-control-armed;
                        open-manual-control-requested(row) => { open-manual-control(row); }
                        joystick-selected(row, idx) => { start-manual-control(row, idx); }
                        manual-control-stopped(row) => { stop-manual-control(row); }
                        arm-requested(row, arm) => { arm-unit(row, arm); }
                        recover-requested(row) => { recover-unit(row); }
                        reboot-requested(row) => { reboot-unit(row); }
                        power-off-requested(row) => { power-off-unit(row); }
                        sysoff-requested(row) => { sysoff-unit(row); }
                        syson-requested(row) => { syson-unit(row); }
                        clear-tlv-requested(row) => { clear-tlv-unit(row); }
                    }
                }

                // 3D view
                Rectangle {
                    visible: root.screen == "view3d";
                    viz-content := VisualizationContent {
                        plot-shown: root.screen == "view3d";
                        texture <=> root.viz-texture;
                        unit-labels: root.unit-labels;
                        tip: root.viz-tip;
                        legend: root.viz-legend;
                        hover(x, y) => { root.viz-hover(x, y); }
                        fit => { root.viz-fit(); }
                        lh-labels: root.lh-labels;
                        loco-labels: root.loco-labels;
                        axis-labels: root.axis-labels;
                        grid-labels: root.grid-labels;
                        positioning-source-names: root.positioning-source-names;
                        positioning-source-index <=> root.positioning-source-index;
                        positioning-source-changed(idx) => { root.positioning-source-changed(idx); }
                        save-pads => { root.viz-save-pads(); }
                        load-scene => { root.viz-load-scene(); }

                        // Shared unit sidebar (same component as the Units tab)
                        sorted-units: root.sorted-units;
                        unit-rows: root.unit-rows;
                        journal-entries: root.journal-entries;
                        console-lines: root.console-lines;
                        assert-text: root.assert-text;
                        assert-busy: root.assert-busy;
                        joystick-names: root.joystick-names;
                        stick-lx: root.stick-lx;
                        stick-ly: root.stick-ly;
                        stick-rx: root.stick-rx;
                        stick-ry: root.stick-ry;
                        manual-control-armed: root.manual-control-armed;
                        viz-unit-clicked(x, y) => { root.viz-unit-clicked(x, y); }
                        open-journal-requested(row) => { open-journal(row); }
                        add-journal-entry-requested(row, text) => { add-journal-entry(row, text); }
                        open-console-requested(row) => { open-console(row); }
                        clear-console-requested(row) => { clear-console(row); }
                        clear-all-console-requested() => { clear-all-console(); }
                        read-assert-requested(row) => { read-assert(row); }
                        upload-trajectory-requested(row) => { upload-trajectory(row); }
                        download-trajectory-requested(row) => { download-trajectory(row); }
                        fly-trajectory-requested(row) => { fly-trajectory(row); }
                        clear-trajectory-requested(row) => { clear-trajectory(row); }
                        generate-primitive-requested(row, shape, size, sizey, zoff, ziter) => { generate-primitive(row, shape, size, sizey, zoff, ziter); }
                        generate-wave-requested(row, x, y, reps, sim, speed, zoff, ziter) => { generate-wave(row, x, y, reps, sim, speed, zoff, ziter); }
                        takeoff-requested(row, height, yaw, time, relative) => { hlc-takeoff(row, height, yaw, time, relative); }
                        goto-requested(row, x, y, z, yaw, relative, speed) => { hlc-goto(row, x, y, z, yaw, relative, speed); }
                        random-goto-requested(row) => { random-goto(row); }
                        go-home-requested(row) => { hlc-go-home(row); }
                        land-requested(row) => { hlc-land(row); }
                        identify-requested(row) => { identify-unit(row); }
                        connect-unit-requested(row) => { connect-unit(row); }
                        delete-journal-entry-requested(row, entry-idx) => { delete-journal-entry(row, entry-idx); }
                        open-manual-control-requested(row) => { open-manual-control(row); }
                        joystick-selected(row, idx) => { start-manual-control(row, idx); }
                        manual-control-stopped(row) => { stop-manual-control(row); }
                        arm-requested(row, arm) => { arm-unit(row, arm); }
                        recover-requested(row) => { recover-unit(row); }
                        reboot-requested(row) => { reboot-unit(row); }
                        power-off-requested(row) => { power-off-unit(row); }
                        sysoff-requested(row) => { sysoff-unit(row); }
                        syson-requested(row) => { syson-unit(row); }
                        clear-tlv-requested(row) => { clear-tlv-unit(row); }
                    }
                }

                // Planning
                Rectangle {
                    visible: root.screen == "planning";
                    planning-content := PlanningContent {
                        texture <=> root.planning-texture;
                        base-stations <=> root.planning-base-stations;
                        anchors <=> root.planning-anchors;
                        obstacles <=> root.planning-obstacles;
                        flight-areas <=> root.planning-flight-areas;
                        waypoint-areas <=> root.planning-waypoint-areas;
                        selected-type <=> root.planning-selected-type;
                        selected-index <=> root.planning-selected-index;
                        handle-active <=> root.planning-handle-active;
                        active-handle <=> root.planning-active-handle;
                        grid-labels: root.planning-grid-labels;
                        marks: root.planning-marks;
                        select(kind, index) => { root.planning-select(kind, index); }
                        save-scene-as => { root.planning-save-scene-as(); }
                        stats-text-1: root.planning-stats-text-1;
                        stats-text-2: root.planning-stats-text-2;
                        stats-text-3: root.planning-stats-text-3;
                        computing: root.planning-computing;
                        save-scene => { root.planning-save-scene(); }
                        load-scene => { root.planning-load-scene(); }
                        load-lh-scene => { root.planning-load-lh-scene(); }
                        load-tdoa3-scene => { root.planning-load-tdoa3-scene(); }
                        add-base-station => { root.planning-add-bs(); }
                        remove-base-station(idx) => { root.planning-remove-bs(idx); }
                        duplicate-base-station(idx) => { root.planning-duplicate-bs(idx); }
                        update-base-station(idx, data) => { root.planning-update-bs(idx, data); }
                        add-anchor => { root.planning-add-anchor(); }
                        remove-anchor(idx) => { root.planning-remove-anchor(idx); }
                        duplicate-anchor(idx) => { root.planning-duplicate-anchor(idx); }
                        update-anchor(idx, data) => { root.planning-update-anchor(idx, data); }
                        add-box => { root.planning-add-box(); }
                        add-cylinder => { root.planning-add-cylinder(); }
                        remove-obstacle(idx) => { root.planning-remove-obstacle(idx); }
                        duplicate-obstacle(idx) => { root.planning-duplicate-obstacle(idx); }
                        update-obstacle(idx, data) => { root.planning-update-obstacle(idx, data); }
                        add-flight-area => { root.planning-add-flight-area(); }
                        remove-flight-area(idx) => { root.planning-remove-flight-area(idx); }
                        update-flight-area(idx, data) => { root.planning-update-flight-area(idx, data); }
                        select-flight-area(idx) => { root.planning-select-flight-area(idx); }
                        add-waypoint-area => { root.planning-add-waypoint-area(); }
                        remove-waypoint-area(idx) => { root.planning-remove-waypoint-area(idx); }
                        update-waypoint-area(idx, data) => { root.planning-update-waypoint-area(idx, data); }
                        select-waypoint-area(idx) => { root.planning-select-waypoint-area(idx); }
                        undo => { root.planning-undo(); }
                        recompute => { root.planning-recompute(); }
                        error-metric-changed(idx) => { root.planning-error-metric-changed(idx); }
                        trajectories-status: root.planning-trajectories-status;
                        load-geometry => { root.planning-load-geometry(); }
                        load-trajectories => { root.planning-load-trajectories(); }
                        view-mouse-pressed(x, y) => { root.planning-view-mouse-pressed(x, y); }
                        view-mouse-moved(x, y) => { root.planning-view-mouse-moved(x, y); }
                        view-mouse-released => { root.planning-view-mouse-released(); }
                        view-pan(dx, dy) => { root.planning-view-pan(dx, dy); }
                    }
                }

                // Lighthouse
                VerticalLayout {
                    visible: root.screen == "lighthouse";
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 24px;
                    spacing: 16px;
                    ScreenTitle {
                        text: "Lighthouse";
                        note: "Set up the base station geometry";
                    }
                    Card {
                        vertical-stretch: 1;
                        lh-wizard-content := LhWizardContent {
                            texture <=> root.lh-wizard-texture;
                            grid-labels: root.lh-wizard-grid-labels;
                            measure-clicked => { root.lh-wizard-measure(); }
                            step-next => { root.lh-wizard-step-next(); }
                            step-prev => { root.lh-wizard-step-prev(); }
                            clear-samples => { root.lh-wizard-clear(); }
                            import-session => { root.lh-wizard-import(); }
                            export-session => { root.lh-wizard-export(); }
                            upload-geometry => { root.lh-wizard-upload(); }
                            select-cf(idx) => { root.lh-wizard-select-cf(idx); }
                            view-mouse-pressed(x, y) => { root.lh-wizard-view-mouse-pressed(x, y); }
                            view-mouse-moved(x, y) => { root.lh-wizard-view-mouse-moved(x, y); }
                            view-mouse-released => { root.lh-wizard-view-mouse-released(); }
                            view-pan(dx, dy) => { root.lh-wizard-view-pan(dx, dy); }
                        }
                    }
                }

                // Loco: anchors and the sniffer
                VerticalLayout {
                    visible: root.screen == "loco";
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 24px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 16px;
                        ScreenTitle {
                            text: "Loco";
                            note: "";
                        }
                        loco-tabs := Segmented {
                            items: [{ label: "Anchors", count: "", attention: false }, { label: "Sniffer", count: "", attention: false }];
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Card {
                        vertical-stretch: 1;
                        Rectangle {
                            visible: loco-tabs.current == 0;
                            LocoContent {
                                positioning-source-names: root.positioning-source-names;
                                positioning-source-index <=> root.positioning-source-index;
                                positioning-source-changed(idx) => { root.positioning-source-changed(idx); }
                                mode-text: root.loco-mode-text;
                                anchors: root.loco-anchors;
                                active-count: root.loco-active-count;
                                total-count: root.loco-total-count;
                                upload-status: root.loco-upload-status;
                                upload-active: root.loco-upload-active;
                                load-anchor-positions() => { root.load-anchor-positions(); }
                                stop-anchor-upload() => { root.stop-anchor-upload(); }
                            }
                        }
                        Rectangle {
                            visible: loco-tabs.current == 1;
                            SnifferContent {
                                port-names: root.sniffer-port-names;
                                port-index <=> root.sniffer-port-index;
                                connected: root.sniffer-connected;
                                status-text: root.sniffer-status;
                                total-packets: root.sniffer-total-packets;
                                total-rate: root.sniffer-total-rate;
                                wire-dropped: root.sniffer-wire-dropped;
                                host-resyncs: root.sniffer-host-resyncs;
                                air-lost: root.sniffer-air-lost;
                                anchor-rows: root.sniffer-anchor-rows;
                                matrix-ids: root.sniffer-matrix-ids;
                                matrix-rows: root.sniffer-matrix-rows;
                                survey-rows: root.sniffer-survey-rows;
                                survey-status: root.sniffer-survey-status;
                                ref-status: root.sniffer-ref-status;
                                feed-rows: root.sniffer-feed-rows;
                                paused <=> root.sniffer-paused;
                                recording <=> root.sniffer-recording;
                                recording-active: root.sniffer-recording-active;
                                rec-count: root.sniffer-rec-count;
                                rec-path: root.sniffer-rec-path;
                                refresh-ports() => { root.sniffer-refresh-ports(); }
                                connect() => { root.sniffer-connect(); }
                                disconnect() => { root.sniffer-disconnect(); }
                                solve-survey() => { root.sniffer-solve-survey(); }
                                save-survey() => { root.sniffer-save-survey(); }
                                set-paused(p) => { root.sniffer-set-paused(p); }
                                set-recording(p) => { root.sniffer-set-recording(p); }
                            }
                        }
                    }
                }

                // Radio
                VerticalLayout {
                    visible: root.screen == "radio";
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 20px;
                    padding-bottom: 24px;
                    spacing: 16px;
                    ScreenTitle {
                        text: "Radio";
                        note: "Channel test";
                    }
                    Card {
                        vertical-stretch: 1;
                        RadioTestContent {
                            unit-names: root.radio-test-unit-names;
                            selected-unit <=> root.radio-test-selected-unit;
                            running: root.radio-test-running;
                            swarm-connected: root.swarm-connected;
                            drives-radios: root.drives-radios;
                            progress: root.radio-test-progress;
                            status-text: root.radio-test-status;
                            results: root.radio-test-results;
                            run-test(idx) => { run-radio-test(idx); }
                        }
                    }
                }
            }
        }
    }

    // Power off confirmation dialog
    if confirm-power-off-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { confirm-power-off-visible = false; }
        }

        Rectangle {
            width: 340px;
            height: 140px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the dialog
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Power off all units in the swarm?";
                    font-size: 15px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { confirm-power-off-visible = false; }
                    }

                    Button {
                        text: "Power Off";
                        clicked => {
                            power-off-swarm();
                            confirm-power-off-visible = false;
                        }
                    }
                }
            }
        }
    }

    // Generic error/alert dialog
    if error-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { error-dialog-visible = false; }
        }

        Rectangle {
            width: 380px;
            height: layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the dialog
            }

            layout := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: root.error-dialog-title;
                    font-size: 15px;
                    font-weight: 600;
                    color: #ff6b6b;
                }

                Text {
                    text: root.error-dialog-message;
                    font-size: 13px;
                    wrap: word-wrap;
                    color: Palette.foreground.transparentize(0.1);
                }

                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "OK";
                        clicked => { error-dialog-visible = false; }
                    }
                }
            }
        }
    }

    // Clear TLV (whole swarm) confirmation dialog
    if confirm-clear-tlv-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { confirm-clear-tlv-visible = false; }
        }

        Rectangle {
            width: 380px;
            height: 180px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the dialog
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Clear persistent TLV storage on all " + root.units.length + " units?";
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: "Wipes persistent params and Lighthouse geometry/calibration on every unit. Radio config is preserved. Power-cycle afterward.";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { confirm-clear-tlv-visible = false; }
                    }

                    Button {
                        text: "Clear TLV";
                        clicked => {
                            clear-tlv();
                            confirm-clear-tlv-visible = false;
                        }
                    }
                }
            }
        }
    }

    // Tuning parameters dialog
    if tuning-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { tuning-dialog-visible = false; }
        }

        Rectangle {
            width: 420px;
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Tuning Parameters";
                    font-size: 16px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "posCtlPid.thrustBase"; vertical-alignment: center; width: 200px; }
                    tuning-thrust-base-input := LineEdit { text: root.tuning-thrust-base; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "velCtlPid.vxKi"; vertical-alignment: center; width: 200px; }
                    tuning-vx-ki-input := LineEdit { text: root.tuning-vx-ki; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "velCtlPid.vyKi"; vertical-alignment: center; width: 200px; }
                    tuning-vy-ki-input := LineEdit { text: root.tuning-vy-ki; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "health.propTestThreshold"; vertical-alignment: center; width: 200px; }
                    tuning-prop-test-threshold-input := LineEdit { text: root.tuning-prop-test-threshold; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "health.propTestPWMRatio"; vertical-alignment: center; width: 200px; }
                    tuning-prop-test-pwm-ratio-input := LineEdit { text: root.tuning-prop-test-pwm-ratio; horizontal-stretch: 1; }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { tuning-dialog-visible = false; }
                    }

                    Button {
                        text: "Set";
                        clicked => {
                            set-tuning-params(
                                tuning-thrust-base-input.text,
                                tuning-vx-ki-input.text,
                                tuning-vy-ki-input.text,
                                tuning-prop-test-threshold-input.text,
                                tuning-prop-test-pwm-ratio-input.text,
                            );
                            tuning-dialog-visible = false;
                        }
                    }
                }
            }
        }
    }

    // Set swarm parameter dialog
    if set-param-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { set-param-dialog-visible = false; }
        }

        Rectangle {
            width: 480px;
            height: 560px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Set Swarm Parameter";
                    font-size: 16px;
                    font-weight: 600;
                }

                Text {
                    text: root.set-param-loading
                        ? "Reading parameter tables…"
                        : root.set-param-unit-count == 0
                            ? "No connected units — connect the swarm first."
                            : "Will be set on " + root.set-param-unit-count + " connected unit(s). Only parameters present in every unit are listed.";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                    wrap: word-wrap;
                }

                search-input := LineEdit {
                    placeholder-text: "Search parameter…";
                    enabled: root.set-param-unit-count > 0;
                    text <=> root.set-param-search-text;
                    edited => { filter-swarm-params(self.text); }
                }

                // Parameter list
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: Palette.alternate-background;

                    ScrollView {
                        VerticalLayout {
                            padding: 2px;
                            spacing: 1px;

                            for param in root.swarm-params: Rectangle {
                                height: 26px;
                                border-radius: 3px;
                                background: param.name == root.set-param-selected-name
                                    ? Palette.accent-background
                                    : row-touch.has-hover ? Palette.background : transparent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;

                                    Text {
                                        text: param.name;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: param.type-name;
                                        font-size: 11px;
                                        color: Palette.foreground.transparentize(0.4);
                                        vertical-alignment: center;
                                    }
                                }

                                row-touch := TouchArea {
                                    clicked => {
                                        root.set-param-selected-name = param.name;
                                        root.set-param-selected-type = param.type-name;
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                Text {
                    text: root.set-param-selected-name == ""
                        ? "No parameter selected"
                        : root.set-param-selected-name + "  (" + root.set-param-selected-type + ")";
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Value"; vertical-alignment: center; width: 60px; }
                    value-input := LineEdit {
                        placeholder-text: "Enter value…";
                        enabled: root.set-param-selected-name != "";
                        text <=> root.set-param-value-text;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    // Live type-validation feedback (empty when valid or nothing entered)
                    text: (root.set-param-selected-name == "" || root.set-param-value-text == "")
                        ? ""
                        : root.validate-param-value(root.set-param-selected-type, root.set-param-value-text);
                    font-size: 11px;
                    color: red;
                    wrap: word-wrap;
                }

                CheckBox {
                    text: "Persist to flash (survives reboot)";
                    enabled: root.set-param-selected-name != "";
                    checked <=> root.set-param-persist;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { set-param-dialog-visible = false; }
                    }

                    Button {
                        text: "Set on Swarm";
                        enabled: root.set-param-selected-name != ""
                            && root.set-param-value-text != ""
                            && root.validate-param-value(root.set-param-selected-type, root.set-param-value-text) == "";
                        clicked => {
                            set-swarm-param(root.set-param-selected-name, root.set-param-value-text, root.set-param-persist);
                            set-param-dialog-visible = false;
                        }
                    }
                }
            }
        }
    }

    // Flash firmware dialog
    if FlashBridge.visible: FlashDialog {}

    // Rechannel swarm dialog
    if RechannelBridge.visible: RechannelDialog {}

    // Open swarm dialog
    if os-dialog-visible: OpenSwarmDialog {
        local: root.os-local;
        shared: root.os-shared;
        shared-title: root.os-shared-title;
        shared-note: root.os-shared-note;
        signed-in: root.signed-in;
        busy: root.os-busy;
        error: root.os-error;
        selected-id <=> root.os-selected-id;
        selected-shared <=> root.os-selected-shared;
        open(id, shared) => { root.os-open(id, shared); }
        browse => {
            root.os-dialog-visible = false;
            root.open-swarm-requested();
        }
        sign-in => {
            root.sign-in-error = "";
            root.sign-in-dialog-visible = true;
        }
        close => { root.os-dialog-visible = false; }
    }

    // Sign-in dialog, over the open swarm dialog
    if sign-in-dialog-visible: SignInDialog {
        server <=> root.sign-in-server;
        waiting: root.sign-in-waiting;
        link: root.sign-in-link;
        error: root.sign-in-error;
        sign-in(server) => { root.sign-in(server); }
        open-link => { root.sign-in-open-link(); }
        cancel => { root.sign-in-cancel(); }
        close => { root.sign-in-dialog-visible = false; }
    }

    // Progress dialog overlay
    if progress-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        // Block interaction with content behind
        TouchArea {}

        Rectangle {
            width: 400px;
            height: 140px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: root.progress-dialog-title;
                    font-size: 16px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Palette.border;

                    Rectangle {
                        x: 0px;
                        width: parent.width * root.progress-dialog-progress;
                        height: parent.height;
                        border-radius: 4px;
                        background: dodgerblue;
                    }
                }

                Text {
                    text: root.progress-dialog-status;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                }
            }
        }
    }

    // Health test dialog
    if health-test-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {}

        Rectangle {
            width: 520px;
            height: 480px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Health Test — Prop Test";
                    font-size: 16px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Palette.border;

                    Rectangle {
                        x: 0px;
                        width: parent.width * root.health-test-progress;
                        height: parent.height;
                        border-radius: 4px;
                        background: dodgerblue;
                    }
                }

                Text {
                    text: root.health-test-status;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 4px;

                        for result in root.health-test-results: Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: Palette.alternate-background;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: result.name;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    width: 80px;
                                }

                                Text {
                                    text: result.status;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 90px;
                                    color: result.status == "Pass" ? limegreen
                                        : result.status == "Fail" || result.status == "Error" ? red
                                        : result.status == "Timeout" ? orange
                                        : Palette.foreground.transparentize(0.3);
                                }

                                for item in [
                                    { label: "M1", pass: result.m1-pass },
                                    { label: "M2", pass: result.m2-pass },
                                    { label: "M3", pass: result.m3-pass },
                                    { label: "M4", pass: result.m4-pass },
                                ]: Rectangle {
                                    width: 40px;
                                    height: 22px;
                                    border-radius: 4px;
                                    background: result.status == "Pass" || result.status == "Fail" || result.status == "Timeout"
                                        ? (item.pass ? limegreen.transparentize(0.6) : red.transparentize(0.6))
                                        : Palette.border;

                                    Text {
                                        text: item.label;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        color: result.status == "Pass" || result.status == "Fail" || result.status == "Timeout"
                                            ? (item.pass ? limegreen : red)
                                            : Palette.foreground.transparentize(0.5);
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Close";
                        clicked => {
                            health-test-dialog-visible = false;
                        }
                    }
                }
            }
        }
    }

    // New-log-config modal (plot dock). Full-window overlay gated by PlotBridge.
    if PlotBridge.show-new-config: PlotNewConfigDialog {}
}
