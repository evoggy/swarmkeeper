    VerticalBox {
        padding: 0px;
        spacing: 0px;

        MenuBar {
            connected: root.swarm-connected;
            exit-clicked => { exit-requested(); }
            open-swarm-clicked => { open-swarm-requested(); }
            connect-clicked => { connect-swarm(); }
            disconnect-clicked => { disconnect-swarm(); }
            reconnect-clicked => { reconnect-swarm(); }
            arm-all-clicked => { arm-swarm(); }
            disarm-all-clicked => { disarm-swarm(); }
            upload-trajectory-swarm-clicked => { upload-trajectory-swarm(); }
            fly-trajectory-swarm-clicked => { fly-trajectory-swarm(); }
            sync-blink-clicked => { sync-blink(); }
            delayed-sync-blink-clicked => { delayed-sync-blink(); }
            land-swarm-clicked => { land-swarm(); }
            reboot-swarm-clicked => { reboot-swarm(); }
            sysoff-swarm-clicked => { sysoff-swarm(); }
            syson-swarm-clicked => { syson-swarm(); }
            power-off-swarm-clicked => { confirm-power-off-visible = true; }
            clear-all-console-clicked => { clear-all-console(); }
            download-toc-clicked => { download-toc(); }
            upload-geometry-clicked => { upload-geometry(); }
            upload-params-clicked => { upload-params(); }
            clear-tlv-clicked => { confirm-clear-tlv-visible = true; }
            tuning-clicked => { tuning-dialog-visible = true; }
            set-param-clicked => {
                set-param-selected-name = "";
                set-param-selected-type = "";
                set-param-search-text = "";
                set-param-value-text = "";
                set-param-persist = false;
                swarm-params = [];
                swarm-params-all = [];
                set-param-loading = true;
                set-param-dialog-visible = true;
                refresh-swarm-params();
            }
            health-test-clicked => {
                health-test-dialog-visible = true;
                run-health-test();
            }
            flash-firmware-clicked => {
                flash-dialog-visible = true;
            }
        }

        SwarmInfoBar {
            swarm-name: root.swarm-name;
            units: root.units;
            connected: root.swarm-connected;
            connected-count: root.connected-count;
            selftest-passed-count: root.selftest-passed-count;
            battery-count: root.battery-count;
            charging-count: root.charging-count;
            charged-count: root.charged-count;
            connect-clicked => { connect-swarm(); }
            disconnect-clicked => { disconnect-swarm(); }
            reconnect-clicked => { reconnect-swarm(); }
            land-swarm-clicked => { land-swarm(); }
            emergency-stop-clicked => { emergency-stop(); }
        }

        TabWidget {
            Tab {
                title: "Units";
                units-content := UnitsContent {
                    units: root.units;
                    sorted-units: root.sorted-units;
                    table-rows: root.unit-table-rows;
                    sort-column: root.sort-column;
                    sort-ascending: root.sort-ascending;
                    journal-entries: root.journal-entries;
                    console-lines: root.console-lines;
                    goto-x-text <=> root.unit-goto-x-text;
                    goto-y-text <=> root.unit-goto-y-text;
                    goto-z-text <=> root.unit-goto-z-text;
                    sort-requested(col, ascending) => { sort-units(col, ascending); }
                    open-journal-requested(row) => { open-journal(row); }
                    add-journal-entry-requested(row, text) => { add-journal-entry(row, text); }
                    open-console-requested(row) => { open-console(row); }
                    clear-console-requested(row) => { clear-console(row); }
                    upload-trajectory-requested(row) => { upload-trajectory(row); }
                    fly-trajectory-requested(row) => { fly-trajectory(row); }
                    clear-trajectory-requested(row) => { clear-trajectory(row); }
                    generate-primitive-requested(row, shape, size) => { generate-primitive(row, shape, size); }
                    generate-wave-requested(row, x, y, reps, sim, speed) => { generate-wave(row, x, y, reps, sim, speed); }
                    takeoff-requested(row, height, yaw, time, relative) => { hlc-takeoff(row, height, yaw, time, relative); }
                    goto-requested(row, x, y, z, yaw, relative, speed) => { hlc-goto(row, x, y, z, yaw, relative, speed); }
                    random-goto-requested(row) => { random-goto(row); }
                    go-home-requested(row) => { hlc-go-home(row); }
                    land-requested(row) => { hlc-land(row); }
                    identify-requested(row) => { identify-unit(row); }
                    connect-unit-requested(row) => { connect-unit(row); }
                    disconnect-unit-requested(row) => { disconnect-unit(row); }
                    delete-journal-entry-requested(row, entry-idx) => { delete-journal-entry(row, entry-idx); }
                    row-selected(row) => { unit-row-selected(row); }
                    joystick-names: root.joystick-names;
                    stick-lx: root.stick-lx;
                    stick-ly: root.stick-ly;
                    stick-rx: root.stick-rx;
                    stick-ry: root.stick-ry;
                    manual-control-armed: root.manual-control-armed;
                    open-manual-control-requested(row) => { open-manual-control(row); }
                    joystick-selected(row, idx) => { start-manual-control(row, idx); }
                    manual-control-stopped(row) => { stop-manual-control(row); }
                    arm-requested(row, arm) => { arm-unit(row, arm); }
                    recover-requested(row) => { recover-unit(row); }
                    reboot-requested(row) => { reboot-unit(row); }
                    power-off-requested(row) => { power-off-unit(row); }
                    sysoff-requested(row) => { sysoff-unit(row); }
                    syson-requested(row) => { syson-unit(row); }
                    clear-tlv-requested(row) => { clear-tlv-unit(row); }
                }
            }
            Tab {
                title: "Radio Test";
                RadioTestContent {
                    unit-names: root.radio-test-unit-names;
                    selected-unit <=> root.radio-test-selected-unit;
                    running: root.radio-test-running;
                    swarm-connected: root.swarm-connected;
                    progress: root.radio-test-progress;
                    status-text: root.radio-test-status;
                    results: root.radio-test-results;
                    run-test(idx) => { run-radio-test(idx); }
                }
            }
            Tab {
                title: "Loco";
                LocoContent {
                    positioning-source-names: root.positioning-source-names;
                    positioning-source-index <=> root.positioning-source-index;
                    positioning-source-changed(idx) => { root.positioning-source-changed(idx); }
                    mode-text: root.loco-mode-text;
                    anchors: root.loco-anchors;
                    active-count: root.loco-active-count;
                    total-count: root.loco-total-count;
                    upload-status: root.loco-upload-status;
                    upload-active: root.loco-upload-active;
                    load-anchor-positions() => { root.load-anchor-positions(); }
                    stop-anchor-upload() => { root.stop-anchor-upload(); }
                }
            }
            Tab {
                title: "Sniffer";
                SnifferContent {
                    port-names: root.sniffer-port-names;
                    port-index <=> root.sniffer-port-index;
                    connected: root.sniffer-connected;
                    status-text: root.sniffer-status;
                    total-packets: root.sniffer-total-packets;
                    total-rate: root.sniffer-total-rate;
                    wire-dropped: root.sniffer-wire-dropped;
                    host-resyncs: root.sniffer-host-resyncs;
                    air-lost: root.sniffer-air-lost;
                    anchor-rows: root.sniffer-anchor-rows;
                    matrix-ids: root.sniffer-matrix-ids;
                    matrix-rows: root.sniffer-matrix-rows;
                    survey-rows: root.sniffer-survey-rows;
                    survey-status: root.sniffer-survey-status;
                    feed-rows: root.sniffer-feed-rows;
                    paused <=> root.sniffer-paused;
                    recording <=> root.sniffer-recording;
                    recording-active: root.sniffer-recording-active;
                    rec-count: root.sniffer-rec-count;
                    rec-path: root.sniffer-rec-path;
                    refresh-ports() => { root.sniffer-refresh-ports(); }
                    connect() => { root.sniffer-connect(); }
                    disconnect() => { root.sniffer-disconnect(); }
                    solve-survey() => { root.sniffer-solve-survey(); }
                    save-survey() => { root.sniffer-save-survey(); }
                    set-paused(p) => { root.sniffer-set-paused(p); }
                    set-recording(p) => { root.sniffer-set-recording(p); }
                }
            }
            Tab {
                title: "Visualization";
                viz-content := VisualizationContent {
                    texture <=> root.viz-texture;
                    cf-labels: root.cf-labels;
                    lh-labels: root.lh-labels;
                    loco-labels: root.loco-labels;
                    axis-labels: root.axis-labels;
                    grid-labels: root.grid-labels;
                    positioning-source-names: root.positioning-source-names;
                    positioning-source-index <=> root.positioning-source-index;
                    positioning-source-changed(idx) => { root.positioning-source-changed(idx); }
                    save-pads => { root.viz-save-pads(); }
                    load-scene => { root.viz-load-scene(); }

                    // Shared unit sidebar (same component as the Units tab)
                    sorted-units: root.sorted-units;
                    journal-entries: root.journal-entries;
                    joystick-names: root.joystick-names;
                    stick-lx: root.stick-lx;
                    stick-ly: root.stick-ly;
                    stick-rx: root.stick-rx;
                    stick-ry: root.stick-ry;
                    manual-control-armed: root.manual-control-armed;
                    goto-x-text <=> root.unit-goto-x-text;
                    goto-y-text <=> root.unit-goto-y-text;
                    goto-z-text <=> root.unit-goto-z-text;
                    viz-unit-clicked(x, y) => { root.viz-unit-clicked(x, y); }
                    open-journal-requested(row) => { open-journal(row); }
                    add-journal-entry-requested(row, text) => { add-journal-entry(row, text); }
                    open-console-requested(row) => { open-console(row); }
                    clear-console-requested(row) => { clear-console(row); }
                    upload-trajectory-requested(row) => { upload-trajectory(row); }
                    fly-trajectory-requested(row) => { fly-trajectory(row); }
                    clear-trajectory-requested(row) => { clear-trajectory(row); }
                    generate-primitive-requested(row, shape, size) => { generate-primitive(row, shape, size); }
                    generate-wave-requested(row, x, y, reps, sim, speed) => { generate-wave(row, x, y, reps, sim, speed); }
                    takeoff-requested(row, height, yaw, time, relative) => { hlc-takeoff(row, height, yaw, time, relative); }
                    goto-requested(row, x, y, z, yaw, relative, speed) => { hlc-goto(row, x, y, z, yaw, relative, speed); }
                    random-goto-requested(row) => { random-goto(row); }
                    go-home-requested(row) => { hlc-go-home(row); }
                    land-requested(row) => { hlc-land(row); }
                    identify-requested(row) => { identify-unit(row); }
                    connect-unit-requested(row) => { connect-unit(row); }
                    disconnect-unit-requested(row) => { disconnect-unit(row); }
                    delete-journal-entry-requested(row, entry-idx) => { delete-journal-entry(row, entry-idx); }
                    open-manual-control-requested(row) => { open-manual-control(row); }
                    joystick-selected(row, idx) => { start-manual-control(row, idx); }
                    manual-control-stopped(row) => { stop-manual-control(row); }
                    arm-requested(row, arm) => { arm-unit(row, arm); }
                    recover-requested(row) => { recover-unit(row); }
                    reboot-requested(row) => { reboot-unit(row); }
                    power-off-requested(row) => { power-off-unit(row); }
                    sysoff-requested(row) => { sysoff-unit(row); }
                    syson-requested(row) => { syson-unit(row); }
                    clear-tlv-requested(row) => { clear-tlv-unit(row); }
                }
            }
            Tab {
                title: "LH Wizard";
                lh-wizard-content := LhWizardContent {
                    texture <=> root.lh-wizard-texture;
                    grid-labels: root.lh-wizard-grid-labels;
                    measure-clicked => { root.lh-wizard-measure(); }
                    step-next => { root.lh-wizard-step-next(); }
                    step-prev => { root.lh-wizard-step-prev(); }
                    clear-samples => { root.lh-wizard-clear(); }
                    import-session => { root.lh-wizard-import(); }
                    export-session => { root.lh-wizard-export(); }
                    upload-geometry => { root.lh-wizard-upload(); }
                    select-cf(idx) => { root.lh-wizard-select-cf(idx); }
                    view-mouse-pressed(x, y) => { root.lh-wizard-view-mouse-pressed(x, y); }
                    view-mouse-moved(x, y) => { root.lh-wizard-view-mouse-moved(x, y); }
                    view-mouse-released => { root.lh-wizard-view-mouse-released(); }
                    view-pan(dx, dy) => { root.lh-wizard-view-pan(dx, dy); }
                }
            }
            Tab {
                title: "Planning";
                planning-content := PlanningContent {
                    texture <=> root.planning-texture;
                    base-stations <=> root.planning-base-stations;
                    anchors <=> root.planning-anchors;
                    obstacles <=> root.planning-obstacles;
                    flight-areas <=> root.planning-flight-areas;
                    waypoint-areas <=> root.planning-waypoint-areas;
                    selected-type <=> root.planning-selected-type;
                    selected-index <=> root.planning-selected-index;
                    handle-active <=> root.planning-handle-active;
                    active-handle <=> root.planning-active-handle;
                    grid-labels: root.planning-grid-labels;
                    stats-text-1: root.planning-stats-text-1;
                    stats-text-2: root.planning-stats-text-2;
                    stats-text-3: root.planning-stats-text-3;
                    computing: root.planning-computing;
                    save-scene => { root.planning-save-scene(); }
                    load-scene => { root.planning-load-scene(); }
                    load-lh-scene => { root.planning-load-lh-scene(); }
                    load-tdoa3-scene => { root.planning-load-tdoa3-scene(); }
                    add-base-station => { root.planning-add-bs(); }
                    remove-base-station(idx) => { root.planning-remove-bs(idx); }
                    duplicate-base-station(idx) => { root.planning-duplicate-bs(idx); }
                    update-base-station(idx, data) => { root.planning-update-bs(idx, data); }
                    add-anchor => { root.planning-add-anchor(); }
                    remove-anchor(idx) => { root.planning-remove-anchor(idx); }
                    duplicate-anchor(idx) => { root.planning-duplicate-anchor(idx); }
                    update-anchor(idx, data) => { root.planning-update-anchor(idx, data); }
                    add-box => { root.planning-add-box(); }
                    add-cylinder => { root.planning-add-cylinder(); }
                    remove-obstacle(idx) => { root.planning-remove-obstacle(idx); }
                    duplicate-obstacle(idx) => { root.planning-duplicate-obstacle(idx); }
                    update-obstacle(idx, data) => { root.planning-update-obstacle(idx, data); }
                    add-flight-area => { root.planning-add-flight-area(); }
                    remove-flight-area(idx) => { root.planning-remove-flight-area(idx); }
                    update-flight-area(idx, data) => { root.planning-update-flight-area(idx, data); }
                    select-flight-area(idx) => { root.planning-select-flight-area(idx); }
                    add-waypoint-area => { root.planning-add-waypoint-area(); }
                    remove-waypoint-area(idx) => { root.planning-remove-waypoint-area(idx); }
                    update-waypoint-area(idx, data) => { root.planning-update-waypoint-area(idx, data); }
                    select-waypoint-area(idx) => { root.planning-select-waypoint-area(idx); }
                    undo => { root.planning-undo(); }
                    recompute => { root.planning-recompute(); }
                    error-metric-changed(idx) => { root.planning-error-metric-changed(idx); }
                    trajectories-status: root.planning-trajectories-status;
                    load-geometry => { root.planning-load-geometry(); }
                    load-trajectories => { root.planning-load-trajectories(); }
                    view-mouse-pressed(x, y) => { root.planning-view-mouse-pressed(x, y); }
                    view-mouse-moved(x, y) => { root.planning-view-mouse-moved(x, y); }
                    view-mouse-released => { root.planning-view-mouse-released(); }
                    view-pan(dx, dy) => { root.planning-view-pan(dx, dy); }
                }
            }
        }
    }

    // Power off confirmation dialog
    if confirm-power-off-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { confirm-power-off-visible = false; }
        }

        Rectangle {
            width: 340px;
            height: 140px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the dialog
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Power off all units in the swarm?";
                    font-size: 15px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { confirm-power-off-visible = false; }
                    }

                    Button {
                        text: "Power Off";
                        clicked => {
                            power-off-swarm();
                            confirm-power-off-visible = false;
                        }
                    }
                }
            }
        }
    }

    // Generic error/alert dialog
    if error-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { error-dialog-visible = false; }
        }

        Rectangle {
            width: 380px;
            height: layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the dialog
            }

            layout := VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: root.error-dialog-title;
                    font-size: 15px;
                    font-weight: 600;
                    color: #ff6b6b;
                }

                Text {
                    text: root.error-dialog-message;
                    font-size: 13px;
                    wrap: word-wrap;
                    color: Palette.foreground.transparentize(0.1);
                }

                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "OK";
                        clicked => { error-dialog-visible = false; }
                    }
                }
            }
        }
    }

    // Clear TLV (whole swarm) confirmation dialog
    if confirm-clear-tlv-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { confirm-clear-tlv-visible = false; }
        }

        Rectangle {
            width: 380px;
            height: 180px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {
                // Block clicks from closing the dialog
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Clear persistent TLV storage on all " + root.units.length + " units?";
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: "Wipes persistent params and Lighthouse geometry/calibration on every unit. Radio config is preserved. Power-cycle afterward.";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { confirm-clear-tlv-visible = false; }
                    }

                    Button {
                        text: "Clear TLV";
                        clicked => {
                            clear-tlv();
                            confirm-clear-tlv-visible = false;
                        }
                    }
                }
            }
        }
    }

    // Tuning parameters dialog
    if tuning-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { tuning-dialog-visible = false; }
        }

        Rectangle {
            width: 420px;
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Tuning Parameters";
                    font-size: 16px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "posCtlPid.thrustBase"; vertical-alignment: center; width: 200px; }
                    tuning-thrust-base-input := LineEdit { text: root.tuning-thrust-base; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "velCtlPid.vxKi"; vertical-alignment: center; width: 200px; }
                    tuning-vx-ki-input := LineEdit { text: root.tuning-vx-ki; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "velCtlPid.vyKi"; vertical-alignment: center; width: 200px; }
                    tuning-vy-ki-input := LineEdit { text: root.tuning-vy-ki; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "health.propTestThreshold"; vertical-alignment: center; width: 200px; }
                    tuning-prop-test-threshold-input := LineEdit { text: root.tuning-prop-test-threshold; horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "health.propTestPWMRatio"; vertical-alignment: center; width: 200px; }
                    tuning-prop-test-pwm-ratio-input := LineEdit { text: root.tuning-prop-test-pwm-ratio; horizontal-stretch: 1; }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { tuning-dialog-visible = false; }
                    }

                    Button {
                        text: "Set";
                        clicked => {
                            set-tuning-params(
                                tuning-thrust-base-input.text,
                                tuning-vx-ki-input.text,
                                tuning-vy-ki-input.text,
                                tuning-prop-test-threshold-input.text,
                                tuning-prop-test-pwm-ratio-input.text,
                            );
                            tuning-dialog-visible = false;
                        }
                    }
                }
            }
        }
    }

    // Set swarm parameter dialog
    if set-param-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { set-param-dialog-visible = false; }
        }

        Rectangle {
            width: 480px;
            height: 560px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Set Swarm Parameter";
                    font-size: 16px;
                    font-weight: 600;
                }

                Text {
                    text: root.set-param-loading
                        ? "Reading parameter tables…"
                        : root.set-param-unit-count == 0
                            ? "No connected units — connect the swarm first."
                            : "Will be set on " + root.set-param-unit-count + " connected unit(s). Only parameters present in every unit are listed.";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                    wrap: word-wrap;
                }

                search-input := LineEdit {
                    placeholder-text: "Search parameter…";
                    enabled: root.set-param-unit-count > 0;
                    text <=> root.set-param-search-text;
                    edited => { filter-swarm-params(self.text); }
                }

                // Parameter list
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: Palette.alternate-background;

                    ScrollView {
                        VerticalLayout {
                            padding: 2px;
                            spacing: 1px;

                            for param in root.swarm-params: Rectangle {
                                height: 26px;
                                border-radius: 3px;
                                background: param.name == root.set-param-selected-name
                                    ? Palette.accent-background
                                    : row-touch.has-hover ? Palette.background : transparent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;

                                    Text {
                                        text: param.name;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: param.type-name;
                                        font-size: 11px;
                                        color: Palette.foreground.transparentize(0.4);
                                        vertical-alignment: center;
                                    }
                                }

                                row-touch := TouchArea {
                                    clicked => {
                                        root.set-param-selected-name = param.name;
                                        root.set-param-selected-type = param.type-name;
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                Text {
                    text: root.set-param-selected-name == ""
                        ? "No parameter selected"
                        : root.set-param-selected-name + "  (" + root.set-param-selected-type + ")";
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Value"; vertical-alignment: center; width: 60px; }
                    value-input := LineEdit {
                        placeholder-text: "Enter value…";
                        enabled: root.set-param-selected-name != "";
                        text <=> root.set-param-value-text;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    // Live type-validation feedback (empty when valid or nothing entered)
                    text: (root.set-param-selected-name == "" || root.set-param-value-text == "")
                        ? ""
                        : root.validate-param-value(root.set-param-selected-type, root.set-param-value-text);
                    font-size: 11px;
                    color: red;
                    wrap: word-wrap;
                }

                CheckBox {
                    text: "Persist to flash (survives reboot)";
                    enabled: root.set-param-selected-name != "";
                    checked <=> root.set-param-persist;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Cancel";
                        clicked => { set-param-dialog-visible = false; }
                    }

                    Button {
                        text: "Set on Swarm";
                        enabled: root.set-param-selected-name != ""
                            && root.set-param-value-text != ""
                            && root.validate-param-value(root.set-param-selected-type, root.set-param-value-text) == "";
                        clicked => {
                            set-swarm-param(root.set-param-selected-name, root.set-param-value-text, root.set-param-persist);
                            set-param-dialog-visible = false;
                        }
                    }
                }
            }
        }
    }

    // Flash firmware dialog
    if flash-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {
            clicked => { if (!root.flashing) { flash-dialog-visible = false; } }
        }

        Rectangle {
            width: 520px;
            height: 600px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Flash Firmware";
                    font-size: 16px;
                    font-weight: 600;
                }

                Text {
                    text: "Select a target and a binary, then flash every unit in the swarm one at a time. Flashing stm32-fw / nrf51-fw disconnects the swarm and uses the radio exclusively.";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Target"; vertical-alignment: center; width: 70px; }
                    ComboBox {
                        model: root.flash-target-names;
                        current-index <=> root.flash-selected-target;
                        enabled: !root.flashing;
                        horizontal-stretch: 1;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Binary"; vertical-alignment: center; width: 70px; }
                    Text {
                        text: root.flash-binary-selected ? root.flash-binary-name : "No file selected";
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        color: root.flash-binary-selected ? Palette.foreground : Palette.foreground.transparentize(0.4);
                    }
                    Button {
                        text: "Select Binary...";
                        enabled: !root.flashing;
                        clicked => { flash-select-binary(); }
                    }
                }

                // Per-Crazyflie progress list
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: Palette.alternate-background;

                    ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 3px;

                            for unit in root.units: Rectangle {
                                height: 46px;
                                border-radius: 3px;
                                background: Palette.background;

                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 5px;
                                    padding-bottom: 5px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: unit.name;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: unit.flash-status == "" ? "Idle" : unit.flash-status;
                                            font-size: 11px;
                                            color: Palette.foreground.transparentize(0.3);
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Palette.border;

                                        Rectangle {
                                            x: 0px;
                                            width: parent.width * unit.flash-progress;
                                            height: parent.height;
                                            border-radius: 3px;
                                            background: dodgerblue;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: root.flash-overall-status;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Close";
                        enabled: !root.flashing;
                        clicked => { flash-dialog-visible = false; }
                    }
                    Button {
                        text: "Flash Swarm";
                        enabled: root.flash-binary-selected && !root.flashing;
                        clicked => { flash-start(); }
                    }
                }
            }
        }
    }

    // Progress dialog overlay
    if progress-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        // Block interaction with content behind
        TouchArea {}

        Rectangle {
            width: 400px;
            height: 140px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: root.progress-dialog-title;
                    font-size: 16px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Palette.border;

                    Rectangle {
                        x: 0px;
                        width: parent.width * root.progress-dialog-progress;
                        height: parent.height;
                        border-radius: 4px;
                        background: dodgerblue;
                    }
                }

                Text {
                    text: root.progress-dialog-status;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                }
            }
        }
    }

    // Health test dialog
    if health-test-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: black.transparentize(0.5);

        TouchArea {}

        Rectangle {
            width: 520px;
            height: 480px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Health Test — Prop Test";
                    font-size: 16px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Palette.border;

                    Rectangle {
                        x: 0px;
                        width: parent.width * root.health-test-progress;
                        height: parent.height;
                        border-radius: 4px;
                        background: dodgerblue;
                    }
                }

                Text {
                    text: root.health-test-status;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.3);
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 4px;

                        for result in root.health-test-results: Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            background: Palette.alternate-background;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: result.name;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    width: 80px;
                                }

                                Text {
                                    text: result.status;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    width: 90px;
                                    color: result.status == "Pass" ? limegreen
                                        : result.status == "Fail" || result.status == "Error" ? red
                                        : result.status == "Timeout" ? orange
                                        : Palette.foreground.transparentize(0.3);
                                }

                                for item in [
                                    { label: "M1", pass: result.m1-pass },
                                    { label: "M2", pass: result.m2-pass },
                                    { label: "M3", pass: result.m3-pass },
                                    { label: "M4", pass: result.m4-pass },
                                ]: Rectangle {
                                    width: 40px;
                                    height: 22px;
                                    border-radius: 4px;
                                    background: result.status == "Pass" || result.status == "Fail" || result.status == "Timeout"
                                        ? (item.pass ? limegreen.transparentize(0.6) : red.transparentize(0.6))
                                        : Palette.border;

                                    Text {
                                        text: item.label;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        color: result.status == "Pass" || result.status == "Fail" || result.status == "Timeout"
                                            ? (item.pass ? limegreen : red)
                                            : Palette.foreground.transparentize(0.5);
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Button {
                        text: "Close";
                        clicked => {
                            health-test-dialog-visible = false;
                        }
                    }
                }
            }
        }
    }

    // New-log-config modal (plot dock). Full-window overlay gated by PlotBridge.
    if PlotBridge.show-new-config: PlotNewConfigDialog {}
}
