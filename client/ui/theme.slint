// The look of Swarmkeeper: colours for the light and dark theme, type,
// and the icon set. Every screen takes its colours from here.

export global Theme {
    // Dark when the setting says so, or when it follows the system and the
    // system is dark. Set from Rust (Settings › Appearance).
    in-out property <bool> dark: false;

    // Window background, behind the cards
    out property <color> ground: dark ? #0E1013 : #F3F4F6;
    // Cards, rail, top bar
    out property <color> surface: dark ? #16191D : #FFFFFF;
    // Table headers, insets, segmented controls
    out property <color> surface2: dark ? #1B1F24 : #F8F9FA;
    out property <color> hover: dark ? #20252B : #F2F4F7;
    out property <color> border: dark ? #272C33 : #E3E6EA;
    // Buttons, inputs
    out property <color> border2: dark ? #3A414A : #CDD2D8;
    out property <color> text: dark ? #E7E9EC : #16181C;
    out property <color> text2: dark ? #B0B6BF : #4B515B;
    // Labels, captions
    out property <color> text3: dark ? #99A0AA : #636975;
    out property <color> accent: dark ? #5B97FF : #0B63E5;
    out property <color> accent-text: dark ? #8AB4FF : #0A58CC;
    // Selected rows, the active rail item
    out property <color> accent-tint: dark ? #1A2840 : #E9F1FE;
    out property <color> accent-button: dark ? #2F6BDB : #0B63E5;
    // Ready, charged
    out property <color> good: dark ? #0CA30C : #0CA30C;
    // Needs a look: low battery, weak link, old firmware
    out property <color> warn: dark ? #E8A20F : #E8A20F;
    out property <color> warn-text: dark ? #F0BD4F : #8A5A00;
    out property <color> warn-tint: dark ? #33290F : #FFF5DE;
    // Fault: tumbled, selftest failed, timeout
    out property <color> crit: dark ? #D03B3B : #D03B3B;
    out property <color> crit-text: dark ? #F28B8B : #B42828;
    out property <color> crit-tint: dark ? #3A1B1D : #FDEDED;
    out property <color> flying: dark ? #5B97FF : #2F7BF0;
    // Not connected
    out property <color> off: dark ? #6B727C : #9AA0A8;
    // Emergency stop
    out property <color> estop: dark ? #C62828 : #C62828;
    out property <color> estop-hover: dark ? #A81F1F : #A81F1F;
    // Popups and floating cards
    out property <color> shadow: dark ? #0000008C : #1018283D;

    // Type. Live numbers use a monospaced font so they don't jump around.
    out property <string> font-mono: "DejaVu Sans Mono";
    out property <length> font-body: 13px;
    out property <length> font-small: 12px;
    out property <length> font-tiny: 11px;
    out property <length> font-title: 20px;
    out property <length> font-value: 24px;

    out property <length> radius-card: 12px;
    out property <length> radius-control: 8px;
}

// Stroke icons, 24×24, drawn black: show them with `colorize`.
