// The Swarm actions menu: every command for the whole swarm, grouped.
// Replaces the Swarm, Flight, System, Setup and Diagnostics menus.

import { Theme, Icons, KButton, MenuPanel, MenuRow, MenuGroupTitle, MenuSeparator } from "kit.slint";
import { Features } from "features.slint";

export component SwarmActionsButton inherits KButton {
    in property <bool> connected;
    in property <bool> drives-radios: true;

    callback arm-all();
    callback disarm-all();
    callback upload-trajectory();
    callback fly-trajectory();
    callback land-all();
    callback sync-blink();
    callback delayed-sync-blink();
    callback health-test();
    callback download-toc();
    callback clear-consoles();
    callback reboot();
    callback sleep();
    callback wake-up();
    callback power-off();
    callback flash-firmware();
    callback clear-tlv();
    callback rechannel();
    callback upload-geometry();
    callback upload-params();
    callback set-parameter();
    callback tuning();

    text: "Swarm actions";
    icon: Icons.swarm;
    clicked => { menu.show(); }

    menu := PopupWindow {
        x: root.width - 520px;
        y: root.height + 4px;
        width: 520px;

        MenuPanel {
            width: 520px;
            height: columns.preferred-height;

            columns := HorizontalLayout {
                padding: 6px;
                spacing: 6px;

                VerticalLayout {
                    alignment: start;
                    width: 251px;
                    MenuGroupTitle { text: "FLIGHT"; }
                    MenuRow { text: "Arm all"; icon: Icons.arm; enabled: root.connected; clicked => { root.arm-all(); menu.close(); } }
                    MenuRow { text: "Disarm all"; enabled: root.connected; clicked => { root.disarm-all(); menu.close(); } }
                    if Features.trajectories: MenuRow { text: "Upload trajectory…"; icon: Icons.upload; enabled: root.connected; clicked => { root.upload-trajectory(); menu.close(); } }
                    if Features.trajectories: MenuRow { text: "Fly trajectory"; icon: Icons.play; enabled: root.connected; clicked => { root.fly-trajectory(); menu.close(); } }
                    MenuRow { text: "Land all"; icon: Icons.land; enabled: root.connected; clicked => { root.land-all(); menu.close(); } }
                    if Features.swarmkeeper-app: MenuRow {
                        text: "Sync blink";
                        hint: root.drives-radios ? "" : "own radios only";
                        icon: Icons.identify;
                        enabled: root.drives-radios;
                        clicked => { root.sync-blink(); menu.close(); }
                    }
                    if Features.swarmkeeper-app: MenuRow {
                        text: "Delayed sync blink";
                        hint: root.drives-radios ? "" : "own radios only";
                        enabled: root.drives-radios;
                        clicked => { root.delayed-sync-blink(); menu.close(); }
                    }
                    MenuSeparator {}
                    MenuGroupTitle { text: "DIAGNOSTICS"; }
                    MenuRow { text: "Health test…"; icon: Icons.check-circle; enabled: root.connected; clicked => { root.health-test(); menu.close(); } }
                    // Connects every unit and disconnects it again, so not while connected
                    if Features.developer: MenuRow {
                        text: "Download TOC";
                        hint: root.connected ? "disconnect first" : "";
                        icon: Icons.download;
                        enabled: !root.connected;
                        clicked => { root.download-toc(); menu.close(); }
                    }
                    MenuRow { text: "Clear all consoles"; icon: Icons.console; clicked => { root.clear-consoles(); menu.close(); } }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }

                VerticalLayout {
                    alignment: start;
                    width: 251px;
                    MenuGroupTitle { text: "POWER AND SYSTEM"; }
                    // These reach each unit by its address, connected or not
                    MenuRow { text: "Reboot"; icon: Icons.reconnect; clicked => { root.reboot(); menu.close(); } }
                    MenuRow { text: "Sleep"; icon: Icons.sleep; clicked => { root.sleep(); menu.close(); } }
                    MenuRow { text: "Wake up"; icon: Icons.sun; clicked => { root.wake-up(); menu.close(); } }
                    MenuRow { text: "Power off…"; icon: Icons.power; danger: true; clicked => { root.power-off(); menu.close(); } }
                    if Features.flashing: MenuRow { text: "Flash firmware…"; icon: Icons.chip; clicked => { root.flash-firmware(); menu.close(); } }
                    if Features.developer: MenuRow { text: "Clear TLV storage…"; icon: Icons.trash; danger: true; clicked => { root.clear-tlv(); menu.close(); } }
                    MenuSeparator {}
                    MenuGroupTitle { text: "SETUP"; }
                    MenuRow { text: "Rechannel swarm…"; icon: Icons.radio; clicked => { root.rechannel(); menu.close(); } }
                    if Features.lighthouse: MenuRow { text: "Upload Lighthouse geometry"; icon: Icons.lighthouse; enabled: root.connected; clicked => { root.upload-geometry(); menu.close(); } }
                    if Features.developer: MenuRow { text: "Upload parameters"; icon: Icons.upload; clicked => { root.upload-params(); menu.close(); } }
                    if Features.developer: MenuRow { text: "Set parameter…"; icon: Icons.settings; enabled: root.connected; clicked => { root.set-parameter(); menu.close(); } }
                    if Features.developer: MenuRow { text: "Tuning…"; clicked => { root.tuning(); menu.close(); } }
                }
            }
        }
    }
}
