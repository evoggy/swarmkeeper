import { Button, CheckBox, ComboBox, Palette } from "std-widgets.slint";
import { UnitSidebar, UnitActionPopups } from "units.slint";
import { UnitData, JournalEntryData } from "unit-card.slint";
import { PlotPanel, PlotBridge } from "plot.slint";

export struct VizLabel {
    text: string,
    screen-x: float,
    screen-y: float,
}

export component VisualizationContent inherits Rectangle {
    in-out property <image> texture;
    // Track the inner 3D pane (not the whole component) so the renderer texture
    // shrinks when the plot dock takes the bottom of this tab.
    out property <float> viewport-width: viz-pane.width / 1px;
    out property <float> viewport-height: viz-pane.height / 1px;

    // Camera state
    in-out property <float> cam-yaw: 0.8;
    in-out property <float> cam-pitch: 0.6;
    in-out property <float> cam-distance: 6.0;
    in-out property <float> cam-pan-x: 0;
    in-out property <float> cam-pan-y: 0;

    // Label toggle states
    in-out property <bool> show-cf-labels: false;
    in-out property <bool> show-lh-labels: false;
    in-out property <bool> show-loco-labels: false;
    in-out property <bool> show-axis-labels: false;
    in-out property <bool> show-grid-labels: false;

    // Positioning source selector
    in-out property <[string]> positioning-source-names;
    in-out property <int> positioning-source-index;
    callback positioning-source-changed(int);

    // Scene overlay (flight area + pads)
    in-out property <string> loaded-scene-name: "";
    in-out property <bool> show-scene-overlay: true;
    callback save-pads();
    callback load-scene();

    // Label data (set from Rust)
    in-out property <[VizLabel]> cf-labels;
    in-out property <[VizLabel]> lh-labels;
    in-out property <[VizLabel]> loco-labels;
    in-out property <[VizLabel]> axis-labels;
    in-out property <[VizLabel]> grid-labels;

    // Unit selection / sidebar (shared with the Units tab).
    // selected-unit is a row index into sorted-units; -1 = nothing selected.
    in property <[UnitData]> sorted-units;
    in-out property <int> selected-unit: -1;
    in property <[JournalEntryData]> journal-entries;
    in property <[string]> console-lines;
    in property <[string]> joystick-names;
    in property <float> stick-lx;
    in property <float> stick-ly;
    in property <float> stick-rx;
    in property <float> stick-ry;
    in property <bool> manual-control-armed;
    in-out property <string> goto-x-text: "0";
    in-out property <string> goto-y-text: "0";
    in-out property <string> goto-z-text: "0";

    // Fired on a left-click that wasn't a drag; Rust hit-tests and sets selected-unit.
    callback viz-unit-clicked(/* x */ float, /* y */ float);

    // Sidebar action callbacks (row index into sorted-units) — mapped to the
    // same shared AppWindow callbacks the Units tab uses.
    callback open-journal-requested(/* row index */ int);
    callback add-journal-entry-requested(/* row index */ int, /* text */ string);
    callback open-console-requested(/* row index */ int);
    callback clear-console-requested(/* row index */ int);
    callback upload-trajectory-requested(/* row index */ int);
    callback fly-trajectory-requested(/* row index */ int);
    callback clear-trajectory-requested(/* row index */ int);
    callback generate-primitive-requested(/* row index */ int, /* shape */ string, /* size m */ string);
    callback generate-wave-requested(/* row index */ int, /* x step m */ string, /* y amp m */ string, /* reps */ string, /* simultaneous */ bool, /* speed m/s */ string);
    callback takeoff-requested(/* row index */ int, /* height */ string, /* yaw */ string, /* time */ string, /* relative */ bool);
    callback goto-requested(/* row index */ int, /* x */ string, /* y */ string, /* z */ string, /* yaw */ string, /* relative */ bool, /* speed m/s */ string);
    callback random-goto-requested(/* row index */ int);
    callback go-home-requested(/* row index */ int);
    callback land-requested(/* row index */ int);
    callback identify-requested(/* row index */ int);
    callback connect-unit-requested(/* row index */ int);
    callback disconnect-unit-requested(/* row index */ int);
    callback delete-journal-entry-requested(/* row index */ int, /* entry index */ int);
    callback open-manual-control-requested(/* row index */ int);
    callback joystick-selected(/* row index */ int, /* joystick index */ int);
    callback manual-control-stopped(/* row index */ int);
    callback arm-requested(/* row index */ int, /* arm */ bool);
    callback recover-requested(/* row index */ int);
    callback reboot-requested(/* row index */ int);
    callback power-off-requested(/* row index */ int);
    callback sysoff-requested(/* row index */ int);
    callback syson-requested(/* row index */ int);
    callback clear-tlv-requested(/* row index */ int);

    private property <bool> journal-open: false;
    private property <bool> console-open: false;
    private property <bool> manual-control-open: false;
    private property <bool> confirm-power-off-open: false;
    private property <bool> confirm-clear-tlv-open: false;
    private property <length> sidebar-width: 360px;

    // Outer split: 3D view on top, the (shared) plot dock below.
    VerticalLayout {
        spacing: 0px;
        viz-pane := Rectangle {
        vertical-stretch: 1;
        clip: true;

    Image {
        source: root.texture;
        width: 100%;
        height: 100%;
        image-fit: fill;
    }

    // Label overlays
    if show-cf-labels: Rectangle {
        width: 100%;
        height: 100%;
        for label in root.cf-labels: Text {
            x: label.screen-x * 1px;
            y: label.screen-y * 1px;
            text: label.text;
            font-size: 11px;
            color: #4d94ff;
        }
    }

    if show-lh-labels: Rectangle {
        width: 100%;
        height: 100%;
        for label in root.lh-labels: Text {
            x: label.screen-x * 1px;
            y: label.screen-y * 1px;
            text: label.text;
            font-size: 10px;
            color: #f04545;
        }
    }

    if show-loco-labels: Rectangle {
        width: 100%;
        height: 100%;
        for label in root.loco-labels: Text {
            x: label.screen-x * 1px;
            y: label.screen-y * 1px;
            text: label.text;
            font-size: 10px;
            color: #ffd900;
        }
    }

    if show-axis-labels: Rectangle {
        width: 100%;
        height: 100%;
        for label in root.axis-labels: Text {
            x: label.screen-x * 1px;
            y: label.screen-y * 1px;
            text: label.text;
            font-size: 12px;
            font-weight: 700;
            color: label.text == "X" ? #f04545
                 : label.text == "Y" ? #4ad980
                 : #61a6fb;
        }
    }

    if show-grid-labels: Rectangle {
        width: 100%;
        height: 100%;
        for label in root.grid-labels: Text {
            x: label.screen-x * 1px;
            y: label.screen-y * 1px;
            text: label.text;
            font-size: 9px;
            color: Palette.foreground.transparentize(0.5);
        }
    }

    TouchArea {
        property <float> prev-x;
        property <float> prev-y;
        property <bool> dragging;
        property <bool> right-button;
        property <bool> right-click-moved;
        property <bool> left-click-moved;

        scroll-event(e) => {
            if (e.delta-y > 0) {
                root.cam-distance = max(1.0, root.cam-distance - 0.5);
            } else if (e.delta-y < 0) {
                root.cam-distance = min(80.0, root.cam-distance + 0.5);
            }
            accept
        }

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.prev-x = self.mouse-x / 1px;
                self.prev-y = self.mouse-y / 1px;
                self.dragging = true;
                self.right-button = e.button == PointerEventButton.right || e.button == PointerEventButton.middle;
                if (e.button == PointerEventButton.right) {
                    self.right-click-moved = false;
                }
                if (e.button == PointerEventButton.left) {
                    self.left-click-moved = false;
                }
            } else if (e.kind == PointerEventKind.up) {
                if (e.button == PointerEventButton.right && !self.right-click-moved) {
                    context-menu.show();
                }
                if (e.button == PointerEventButton.left && !self.left-click-moved) {
                    root.viz-unit-clicked(self.mouse-x / 1px, self.mouse-y / 1px);
                }
                self.dragging = false;
            }
        }

        moved => {
            // NOTE: Slint's TouchArea only sets `pressed` for the left button, but `moved`
            // (and mouse-x/-y) fire for any grabbed button. So we gate on `dragging`, not
            // `pressed`, otherwise middle/right-button panning would never run.
            if (self.dragging) {
                if (self.right-button) {
                    self.right-click-moved = true;
                    // The camera orbits by yaw, so a screen-space drag must be projected onto
                    // the camera's ground axes (screen-right and forward) for the model to
                    // follow the cursor regardless of orientation.
                    root.cam-pan-x += ((self.mouse-x / 1px - self.prev-x) * Math.sin(root.cam-yaw * 1rad)
                        - (self.mouse-y / 1px - self.prev-y) * Math.cos(root.cam-yaw * 1rad)) * 0.01;
                    root.cam-pan-y += (-(self.mouse-x / 1px - self.prev-x) * Math.cos(root.cam-yaw * 1rad)
                        - (self.mouse-y / 1px - self.prev-y) * Math.sin(root.cam-yaw * 1rad)) * 0.01;
                } else {
                    self.left-click-moved = true;
                    root.cam-yaw -= (self.mouse-x / 1px - self.prev-x) * 0.01;
                    root.cam-pitch = clamp(root.cam-pitch + (self.mouse-y / 1px - self.prev-y) * 0.01, 0.1, 1.5);
                }
                self.prev-x = self.mouse-x / 1px;
                self.prev-y = self.mouse-y / 1px;
            }
        }
    }

    context-menu := PopupWindow {
        x: 10px;
        y: 10px;
        width: 220px;

        Rectangle {
            width: 220px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 4px;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                Text {
                    text: "Show Labels";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.foreground.transparentize(0.3);
                }

                CheckBox {
                    text: "Crazyflie names";
                    checked <=> root.show-cf-labels;
                }

                CheckBox {
                    text: "Lighthouse base station IDs";
                    checked <=> root.show-lh-labels;
                }

                CheckBox {
                    text: "Loco node IDs";
                    checked <=> root.show-loco-labels;
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border.transparentize(0.5);
                }

                CheckBox {
                    text: "Axis labels (X, Y, Z)";
                    checked <=> root.show-axis-labels;
                }

                CheckBox {
                    text: "Grid measurements (m)";
                    checked <=> root.show-grid-labels;
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border.transparentize(0.5);
                }

                Text {
                    text: "Scene";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.foreground.transparentize(0.3);
                }

                CheckBox {
                    text: "Show flight area / pads";
                    checked <=> root.show-scene-overlay;
                }

                Text {
                    text: root.loaded-scene-name == "" ? "(no scene loaded)" : root.loaded-scene-name;
                    font-size: 10px;
                    color: Palette.foreground.transparentize(0.5);
                    overflow: elide;
                }

                Button {
                    text: "Load Scene…";
                    clicked => { context-menu.close(); root.load-scene(); }
                }

                Button {
                    text: "Save Pad Positions";
                    clicked => { context-menu.close(); root.save-pads(); }
                }
            }
        }
    }

    // Positioning source dropdown (must be after TouchArea to receive events)
    Rectangle {
        x: 8px;
        y: 8px;
        width: 220px;
        height: 32px;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                text: "Source:";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.3);
                vertical-alignment: center;
            }

            ComboBox {
                width: 160px;
                model: root.positioning-source-names;
                current-index <=> root.positioning-source-index;
                selected(value) => {
                    root.positioning-source-changed(self.current-index);
                }
            }
        }
    }

    // Unit sidebar overlay (shared component with the Units tab), anchored right.
    if selected-unit >= 0 && selected-unit < sorted-units.length: Rectangle {
        width: sidebar-width;
        x: parent.width - self.width;

        // Absorb clicks on the sidebar so they don't reach the camera TouchArea.
        TouchArea { }

        UnitSidebar {
            width: 100%;
            height: 100%;
            unit: sorted-units[selected-unit];
            has-selection: true;
            journal-entries: root.journal-entries;
            goto-x-text <=> root.goto-x-text;
            goto-y-text <=> root.goto-y-text;
            goto-z-text <=> root.goto-z-text;
            journal-clicked => { open-journal-requested(selected-unit); journal-open = true; }
            add-journal-entry(text) => { add-journal-entry-requested(selected-unit, text); }
            console-clicked => { open-console-requested(selected-unit); console-open = true; }
            clear-console-clicked => { clear-console-requested(selected-unit); }
            upload-trajectory-clicked => { upload-trajectory-requested(selected-unit); }
            fly-trajectory-clicked => { fly-trajectory-requested(selected-unit); }
            clear-trajectory-clicked => { clear-trajectory-requested(selected-unit); }
            generate-primitive-clicked(shape, size) => { generate-primitive-requested(selected-unit, shape, size); }
            generate-wave-clicked(x, y, reps, sim, speed) => { generate-wave-requested(selected-unit, x, y, reps, sim, speed); }
            takeoff-clicked(height, yaw, time, relative) => { takeoff-requested(selected-unit, height, yaw, time, relative); }
            goto-clicked(x, y, z, yaw, relative, speed) => { goto-requested(selected-unit, x, y, z, yaw, relative, speed); }
            random-goto-clicked => { random-goto-requested(selected-unit); }
            go-home-clicked => { go-home-requested(selected-unit); }
            land-clicked => { land-requested(selected-unit); }
            identify-clicked => { identify-requested(selected-unit); }
            manual-control-clicked => { open-manual-control-requested(selected-unit); manual-control-open = true; }
            connect-clicked => { connect-unit-requested(selected-unit); }
            disconnect-clicked => { disconnect-unit-requested(selected-unit); }
            recover-clicked => { recover-requested(selected-unit); }
            reboot-clicked => { reboot-requested(selected-unit); }
            power-off-clicked => { confirm-power-off-open = true; }
            sysoff-clicked => { sysoff-requested(selected-unit); }
            syson-clicked => { syson-requested(selected-unit); }
            clear-tlv-clicked => { confirm-clear-tlv-open = true; }
            close-clicked => { root.selected-unit = -1; }
        }
    }

        }

        if PlotBridge.dock-visible: PlotPanel {}
    }

    // Sidebar action popups (shared component with the Units tab).
    UnitActionPopups {
        selected-row: root.selected-unit;
        sorted-units: root.sorted-units;
        journal-entries: root.journal-entries;
        console-lines: root.console-lines;
        joystick-names: root.joystick-names;
        stick-lx: root.stick-lx;
        stick-ly: root.stick-ly;
        stick-rx: root.stick-rx;
        stick-ry: root.stick-ry;
        manual-control-armed: root.manual-control-armed;
        manual-control-open <=> root.manual-control-open;
        confirm-power-off-open <=> root.confirm-power-off-open;
        confirm-clear-tlv-open <=> root.confirm-clear-tlv-open;
        journal-open <=> root.journal-open;
        console-open <=> root.console-open;
        manual-control-stopped(row) => { root.manual-control-stopped(row); }
        joystick-selected(row, idx) => { root.joystick-selected(row, idx); }
        arm-requested(row, arm) => { root.arm-requested(row, arm); }
        power-off-requested(row) => { root.power-off-requested(row); }
        clear-tlv-requested(row) => { root.clear-tlv-requested(row); }
        add-journal-entry-requested(row, text) => { root.add-journal-entry-requested(row, text); }
        delete-journal-entry-requested(row, entry) => { root.delete-journal-entry-requested(row, entry); }
        clear-console-requested(row) => { root.clear-console-requested(row); }
    }
}
